# ==========================================
# Sahyak CRM - Cloudflare Production Variables & Secrets
# ==========================================

# 1. Admin Security & Authentication
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SECRET=your_admin_secret_key
ADMIN_ACCESS_TOKEN=your_secure_api_access_token
ADMIN_SESSION_SECRET=your_session_signing_secret
ADMIN_EMAILS=admin@sahyak.com,team@sahyak.com,support@sahyak.com

# 2. Cloudflare D1 Database
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_DATABASE_NAME=sahyak-crm-db

# 3. Communications & Contact Info
CONTACT_EMAIL=contact@sahyak.com
SALES_EMAIL=sales@sahyak.com
SUPPORT_EMAIL=support@sahyak.com

# 4. External CRM Integration & Webhooks
CRM_API_KEY=your_crm_api_key
CRM_WEBHOOK_URL=https://api.yourcrm.com/v1/leads

# 5. Google Search Console API Keys
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...\n-----END PRIVATE KEY-----"
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://sahyak.com

# 6. Public URLs & WhatsApp Hotline
NEXT_PUBLIC_SITE_URL=https://sahyak.com
NEXT_PUBLIC_CRM_LOGIN_URL=https://app.sahyak.com/login
NEXT_PUBLIC_CRM_SIGNUP_URL=https://app.sahyak.com/signup
NEXT_PUBLIC_WHATSAPP_NUMBER=+91 87964 75107
NEXT_PUBLIC_WHATSAPP_SALES_URL=https://wa.me/918796475107

# 7. Environment & Build Config
NODE_VERSION=22.12.0
APP_ENV=production

