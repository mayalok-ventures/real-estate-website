---
interface Props {
  active?: 'home' | 'features' | 'pricing' | 'about' | 'resources' | 'security' | 'contact';
}

const { active } = Astro.props;
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<header class="sahyak-site-header">
  <div class="sahyak-site-header-inner">
    <a href="/" class="sahyak-site-logo" aria-label="Sahyak CRM Home">
      <img src="/images/sahyak-logo.png" alt="Sahyak CRM" class="sahyak-logo-img" />
      <span class="sahyak-logo-text">Sahyak <span class="crm-pill">CRM</span></span>
    </a>

    <nav class="sahyak-site-nav" aria-label="Main Navigation">
      <a href="/" class={`sahyak-site-nav-link ${active === 'home' ? 'active' : ''}`}>Home</a>
      <a href="/features/" class={`sahyak-site-nav-link ${active === 'features' ? 'active' : ''}`}>Features</a>
      <a href="/pricing/" class={`sahyak-site-nav-link ${active === 'pricing' ? 'active' : ''}`}>Pricing</a>
      <a href="/about/" class={`sahyak-site-nav-link ${active === 'about' ? 'active' : ''}`}>About</a>
      <a href="/resources/" class={`sahyak-site-nav-link ${active === 'resources' ? 'active' : ''}`}>Resources</a>
      <a href="/security/" class={`sahyak-site-nav-link ${active === 'security' ? 'active' : ''}`}>Security</a>
      <a href="/contact/" class={`sahyak-site-nav-link ${active === 'contact' ? 'active' : ''}`}>Contact</a>
    </nav>

    <div class="sahyak-site-header-actions">
      <a href="https://crm.sahyak.com" class="sahyak-btn-nav-primary">Start free &rarr;</a>
    </div>

    <!-- Mobile Menu Hamburger -->
    <button class="sahyak-mobile-hamburger" id="sahyak-hamburger-btn" aria-label="Open Navigation Menu" aria-expanded="false" aria-controls="sahyak-mobile-drawer">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div class="sahyak-mobile-nav-drawer" id="sahyak-mobile-drawer">
    <a href="/" class={active === 'home' ? 'active' : ''}>Home</a>
    <a href="/features/" class={active === 'features' ? 'active' : ''}>Features</a>
    <a href="/pricing/" class={active === 'pricing' ? 'active' : ''}>Pricing</a>
    <a href="/about/" class={active === 'about' ? 'active' : ''}>About</a>
    <a href="/resources/" class={active === 'resources' ? 'active' : ''}>Resources</a>
    <a href="/security/" class={active === 'security' ? 'active' : ''}>Security</a>
    <a href="/contact/" class={active === 'contact' ? 'active' : ''}>Contact</a>

    <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.85rem;">
      <a href="https://crm.sahyak.com" class="sahyak-btn-nav-primary" style="text-align: center; justify-content: center;">Start 14-Day Free Trial &rarr;</a>
    </div>
  </div>
</header>

<style is:global>
  /* Accessible Skip Link — Guaranteed hidden by default, visible upon keyboard focus */
  .skip-link:not(:focus):not(:focus-visible) {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    position: fixed !important;
    top: 1rem !important;
    left: 1.5rem !important;
    width: auto !important;
    height: auto !important;
    padding: 0.65rem 1.25rem !important;
    margin: 0 !important;
    overflow: visible !important;
    clip: auto !important;
    white-space: normal !important;
    z-index: 1000000 !important;
    background: #4ADE80 !important;
    color: #0A1C16 !important;
    font-weight: 700 !important;
    font-size: 0.875rem !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5) !important;
    outline: 2px solid #FFFFFF !important;
    outline-offset: 2px !important;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    z-index: 100000;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    position: fixed;
    top: 1rem;
    left: 1.5rem;
    width: auto;
    height: auto;
    padding: 0.65rem 1.25rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    background: #4ADE80;
    color: #0A1C16;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  .sahyak-site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(10, 28, 22, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(74, 222, 128, 0.12);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .sahyak-site-header-inner {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sahyak-site-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #F3F4F6;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .sahyak-logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
    border-radius: 6px;
    display: block;
  }

  .sahyak-logo-text {
    color: #F3F4F6;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .crm-pill {
    font-size: 0.75rem;
    background: rgba(74, 222, 128, 0.15);
    color: #4ADE80;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(74, 222, 128, 0.3);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .sahyak-site-nav {
    display: none;
    align-items: center;
    gap: 1.6rem;
  }

  @media (min-width: 980px) {
    .sahyak-site-nav {
      display: flex;
    }
  }

  .sahyak-site-nav-link {
    color: #D1D5DB;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .sahyak-site-nav-link:hover, .sahyak-site-nav-link.active {
    color: #4ADE80;
  }

  .sahyak-site-nav-link:focus-visible {
    color: #4ADE80;
    outline: 2px solid #4ADE80;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .sahyak-site-logo:focus-visible {
    outline: 2px solid #4ADE80;
    outline-offset: 4px;
    border-radius: 6px;
  }

  .sahyak-btn-nav-primary:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  .sahyak-mobile-hamburger:focus-visible {
    outline: 2px solid #4ADE80;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .sahyak-site-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #4ADE80;
    border-radius: 2px;
  }

  .sahyak-site-header-actions {
    display: none;
    align-items: center;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .sahyak-site-header-actions {
      display: flex;
    }
  }

  .sahyak-btn-nav-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.35rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 700;
    background: #4ADE80;
    color: #0A1C16;
    text-decoration: none;
    border: none;
    transition: all 0.2s ease;
  }

  .sahyak-btn-nav-primary:hover {
    background: #22c55e;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(74, 222, 128, 0.35);
  }

  .sahyak-mobile-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 2px;
  }

  @media (min-width: 980px) {
    .sahyak-mobile-hamburger {
      display: none;
    }
  }

  .sahyak-mobile-hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background-color: #F3F4F6;
    border-radius: 2px;
    transition: 0.2s;
  }

  .sahyak-mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 72px;
    left: 0;
    width: 100%;
    height: calc(100vh - 72px);
    background: #0A1C16;
    padding: 2rem 1.5rem;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
    border-top: 1px solid rgba(74, 222, 128, 0.15);
  }

  .sahyak-mobile-nav-drawer.open {
    display: flex;
  }

  .sahyak-mobile-nav-drawer a {
    color: #F3F4F6;
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: color 0.15s ease;
  }

  .sahyak-mobile-nav-drawer a:hover,
  .sahyak-mobile-nav-drawer a.active {
    color: #4ADE80;
  }

  .sahyak-mobile-nav-drawer a:focus-visible {
    color: #4ADE80;
    outline: 2px solid #4ADE80;
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>

<script is:inline>
  // Automatic IP & Locale Detection (Silent background operation, default English)
  (function() {
    const COUNTRIES = {
      US: { name: 'United States', flag: '🇺🇸', currency: 'USD', symbol: '$', rate: 1.0 },
      GB: { name: 'United Kingdom', flag: '🇬🇧', currency: 'GBP', symbol: '£', rate: 0.78 },
      AU: { name: 'Australia', flag: '🇦🇺', currency: 'AUD', symbol: 'A$', rate: 1.52 },
      IN: { name: 'India', flag: '🇮🇳', currency: 'INR', symbol: '₹', rate: 85.0 },
      AE: { name: 'UAE', flag: '🇦🇪', currency: 'AED', symbol: 'AED ', rate: 3.67 },
      DE: { name: 'Germany', flag: '🇩🇪', currency: 'EUR', symbol: '€', rate: 0.92 },
      FR: { name: 'France', flag: '🇫🇷', currency: 'EUR', symbol: '€', rate: 0.92 },
      ES: { name: 'Spain', flag: '🇪🇸', currency: 'EUR', symbol: '€', rate: 0.92 },
      CA: { name: 'Canada', flag: '🇨🇦', currency: 'CAD', symbol: 'C$', rate: 1.38 },
      MX: { name: 'Mexico', flag: '🇲🇽', currency: 'MXN', symbol: 'MX$', rate: 19.5 },
      BR: { name: 'Brazil', flag: '🇧🇷', currency: 'BRL', symbol: 'R$', rate: 5.4 },
      ZA: { name: 'South Africa', flag: '🇿🇦', currency: 'ZAR', symbol: 'R', rate: 18.2 },
      SA: { name: 'Saudi Arabia', flag: '🇸🇦', currency: 'SAR', symbol: 'SAR ', rate: 3.75 },
      SG: { name: 'Singapore', flag: '🇸🇬', currency: 'SGD', symbol: 'S$', rate: 1.34 },
      JP: { name: 'Japan', flag: '🇯🇵', currency: 'JPY', symbol: '¥', rate: 152.0 },
    };

    function detectUserCountry() {
      // 1. Saved preference
      const saved = localStorage.getItem('sahyak_country');
      if (saved && COUNTRIES[saved]) return saved;

      // 2. Client-side Timezone mapping for IP-adjacent automatic detection
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (tz.includes('Calcutta') || tz.includes('Kolkata')) return 'IN';
        if (tz.includes('London')) return 'GB';
        if (tz.includes('Sydney') || tz.includes('Melbourne') || tz.includes('Perth') || tz.includes('Brisbane')) return 'AU';
        if (tz.includes('Dubai')) return 'AE';
        if (tz.includes('Berlin')) return 'DE';
        if (tz.includes('Paris')) return 'FR';
        if (tz.includes('Madrid')) return 'ES';
        if (tz.includes('Toronto') || tz.includes('Vancouver') || tz.includes('Montreal')) return 'CA';
        if (tz.includes('Mexico')) return 'MX';
        if (tz.includes('Sao_Paulo')) return 'BR';
        if (tz.includes('Johannesburg')) return 'ZA';
        if (tz.includes('Riyadh')) return 'SA';
        if (tz.includes('Singapore')) return 'SG';
        if (tz.includes('Tokyo')) return 'JP';
      } catch (e) {}

      // Universal standard default (Target market: India)
      return 'IN';
    }

    const code = detectUserCountry();
    const data = COUNTRIES[code] || COUNTRIES['IN'];
    try {
      localStorage.setItem('sahyak_country', code);
    } catch(e) {}

    // Dispatch event for currency/pricing reactivity across pages
    window.dispatchEvent(new CustomEvent('sahyak:country-changed', {
      detail: { country: code, ...data }
    }));

    // Mobile Hamburger with full accessibility & Escape key listener
    const hamburger = document.getElementById('sahyak-hamburger-btn');
    const drawer = document.getElementById('sahyak-mobile-drawer');
    if (hamburger && drawer) {
      const toggleDrawer = (open) => {
        const isOpen = typeof open === 'boolean' ? open : drawer.classList.toggle('open');
        if (typeof open === 'boolean') {
          drawer.classList.toggle('open', isOpen);
        }
        hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      };

      hamburger.addEventListener('click', () => {
        const willOpen = !drawer.classList.contains('open');
        toggleDrawer(willOpen);
      });

      drawer.querySelectorAll('a').forEach(l => {
        l.addEventListener('click', () => toggleDrawer(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('open')) {
          toggleDrawer(false);
          hamburger.focus();
        }
      });
    }
  })();
</script>
