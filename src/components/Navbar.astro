---
interface Props {
  active?: 'home' | 'features' | 'pricing' | 'about' | 'resources' | 'security' | 'contact' | 'solutions' | 'tools';
}

const { active: propActive } = Astro.props;

// Canonical path normalization: strip trailing slashes, treat '/' as '/'
const rawPath = Astro.url.pathname || '/';
const currentPath = rawPath.replace(/\/+$/, '') || '/';

// Dynamic category detection based on path
function detectCategory(path: string): 'home' | 'features' | 'pricing' | 'about' | 'resources' | 'security' | 'contact' | 'solutions' | 'tools' | null {
  if (path === '/' || path === '/index.html') return 'home';
  if (path === '/features' || path.startsWith('/features/')) return 'features';
  if (path === '/solutions' || path.startsWith('/solutions/') || path === '/industry' || path.startsWith('/industry/')) return 'solutions';
  if (path === '/pricing' || path.startsWith('/pricing/')) return 'pricing';
  if (path === '/tools' || path.startsWith('/tools/') || path === '/compare' || path.startsWith('/compare/')) return 'tools';
  if (path === '/resources' || path.startsWith('/resources/')) return 'resources';
  if (path === '/security' || path.startsWith('/security/')) return 'security';
  if (path === '/about' || path.startsWith('/about/')) return 'about';
  if (path === '/contact' || path.startsWith('/contact/')) return 'contact';
  return null;
}

const detectedCategory = detectCategory(currentPath);

// Prioritize detectedCategory over propActive to prevent stale manual overrides
const effectiveActive = detectedCategory || propActive || null;

// Exact path match helper for aria-current="page"
function isExactMatch(href: string): boolean {
  const cleanHref = href.replace(/\/+$/, '') || '/';
  return cleanHref === currentPath;
}
