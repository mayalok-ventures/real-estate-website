    padding-left: calc(0.75rem - 3px);
  }
</style>

<script is:inline>
  // Automatic IP & Locale Detection (Silent background operation, default English)
  (function() {
    const COUNTRIES = {
      US: { name: 'United States', flag: '🇺🇸', currency: 'USD', symbol: '$', rate: 1.0 },
      GB: { name: 'United Kingdom', flag: '🇬🇧', currency: 'GBP', symbol: '£', rate: 0.78 },
      AU: { name: 'Australia', flag: '🇦🇺', currency: 'AUD', symbol: 'A$', rate: 1.52 },
      IN: { name: 'India', flag: '🇮🇳', currency: 'INR', symbol: '₹', rate: 85.0 },
      AE: { name: 'UAE', flag: '🇦🇪', currency: 'AED', symbol: 'AED ', rate: 3.67 },
      DE: { name: 'Germany', flag: '🇩🇪', currency: 'EUR', symbol: '€', rate: 0.92 },
      FR: { name: 'France', flag: '🇫🇷', currency: 'EUR', symbol: '€', rate: 0.92 },
      ES: { name: 'Spain', flag: '🇪🇸', currency: 'EUR', symbol: '€', rate: 0.92 },
      CA: { name: 'Canada', flag: '🇨🇦', currency: 'CAD', symbol: 'C$', rate: 1.38 },
      MX: { name: 'Mexico', flag: '🇲🇽', currency: 'MXN', symbol: 'MX$', rate: 19.5 },
      BR: { name: 'Brazil', flag: '🇧🇷', currency: 'BRL', symbol: 'R$', rate: 5.4 },
      ZA: { name: 'South Africa', flag: '🇿🇦', currency: 'ZAR', symbol: 'R', rate: 18.2 },
      SA: { name: 'Saudi Arabia', flag: '🇸🇦', currency: 'SAR', symbol: 'SAR ', rate: 3.75 },
      SG: { name: 'Singapore', flag: '🇸🇬', currency: 'SGD', symbol: 'S$', rate: 1.34 },
      JP: { name: 'Japan', flag: '🇯🇵', currency: 'JPY', symbol: '¥', rate: 152.0 },
    };

    function detectUserCountry() {
      // 1. Saved preference
      const saved = localStorage.getItem('sahyak_country');
      if (saved && COUNTRIES[saved]) return saved;

      // 2. Client-side Timezone mapping for IP-adjacent automatic detection
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (tz.includes('Calcutta') || tz.includes('Kolkata')) return 'IN';
        if (tz.includes('London')) return 'GB';
        if (tz.includes('Sydney') || tz.includes('Melbourne') || tz.includes('Perth') || tz.includes('Brisbane')) return 'AU';
        if (tz.includes('Dubai')) return 'AE';
        if (tz.includes('Berlin')) return 'DE';
        if (tz.includes('Paris')) return 'FR';
        if (tz.includes('Madrid')) return 'ES';
        if (tz.includes('Toronto') || tz.includes('Vancouver') || tz.includes('Montreal')) return 'CA';
        if (tz.includes('Mexico')) return 'MX';
        if (tz.includes('Sao_Paulo')) return 'BR';
        if (tz.includes('Johannesburg')) return 'ZA';
        if (tz.includes('Riyadh')) return 'SA';
        if (tz.includes('Singapore')) return 'SG';
        if (tz.includes('Tokyo')) return 'JP';
      } catch (e) {}

      // Universal standard default (Target market: India)
      return 'IN';
    }

    const code = detectUserCountry();
    const data = COUNTRIES[code] || COUNTRIES['IN'];
    try {
      localStorage.setItem('sahyak_country', code);
    } catch(e) {}

    // Dispatch event for currency/pricing reactivity across pages
    window.dispatchEvent(new CustomEvent('sahyak:country-changed', {
      detail: { country: code, ...data }
    }));

    // Desktop Dropdowns Keyboard Accessibility: Escape key returns focus to parent trigger
    document.querySelectorAll('.sahyak-nav-item-dropdown').forEach(dropdown => {
      dropdown.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const trigger = dropdown.querySelector('.sahyak-site-nav-link');
          if (trigger) trigger.focus();
        }
      });
    });

    // Mobile Hamburger with full accessibility & Escape key listener
    const hamburger = document.getElementById('sahyak-hamburger-btn');
    const drawer = document.getElementById('sahyak-mobile-drawer');
    if (hamburger && drawer) {
      const toggleDrawer = (open) => {
        const isOpen = typeof open === 'boolean' ? open : drawer.classList.toggle('open');
        if (typeof open === 'boolean') {
          drawer.classList.toggle('open', isOpen);
        }
        hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      };

      hamburger.addEventListener('click', () => {
        const willOpen = !drawer.classList.contains('open');
        toggleDrawer(willOpen);
      });

      drawer.querySelectorAll('a').forEach(l => {
        l.addEventListener('click', () => toggleDrawer(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('open')) {
          toggleDrawer(false);
          hamburger.focus();
        }
      });
    }
  })();
</script>
