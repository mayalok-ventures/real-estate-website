---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="sahyak-breadcrumb-nav" style="background: #081712; border-bottom: 1px solid rgba(74, 222, 128, 0.1); width: 100%;">
  <div class="sahyak-breadcrumb-container" style="max-width: 1300px; margin: 0 auto; padding: 0.65rem 1.5rem;">
    <ol class="sahyak-breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList" style="display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 0.5rem; list-style: none; list-style-type: none; margin: 0; padding: 0;">
      {items.map((item, index) => {
        const isLast = index === items.length - 1;
        const position = index + 1;
        return (
          <li class="sahyak-breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style="display: inline-flex; align-items: center; gap: 0.5rem; list-style: none; list-style-type: none; margin: 0; padding: 0;">
            {index > 0 && <span class="sahyak-breadcrumb-separator" aria-hidden="true" style="color: #4b5563; margin-right: 0.25rem;">/</span>}
            {isLast ? (
              <span class="sahyak-breadcrumb-current" itemprop="name" aria-current="page" style="color: #f3f4f6; font-weight: 600;">{item.name}</span>
            ) : (
              <a href={item.url || '/'} class="sahyak-breadcrumb-link" itemprop="item" style="color: #9ca3af; text-decoration: none; font-weight: 500;">
                <span itemprop="name">{item.name}</span>
              </a>
            )}
            <meta itemprop="position" content={String(position)} />
          </li>
        );
      })}
    </ol>
  </div>
</nav>

<style is:global>
  /* Global reset for breadcrumbs ensuring no numbered list or vertical stack */
  .sahyak-breadcrumb-list,
  ol.sahyak-breadcrumb-list,
  .breadcrumb-list,
  ol.breadcrumb-list {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    flex-wrap: wrap !important;
    gap: 0.5rem !important;
    list-style: none !important;
    list-style-type: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .sahyak-breadcrumb-item,
  li.sahyak-breadcrumb-item,
  .breadcrumb-item,
  li.breadcrumb-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    list-style: none !important;
    list-style-type: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .sahyak-breadcrumb-item::marker,
  li.sahyak-breadcrumb-item::marker,
  .breadcrumb-item::marker,
  li.breadcrumb-item::marker {
    display: none !important;
    content: '' !important;
  }
</style>

<style>
  .sahyak-breadcrumb-nav {
    background: #081712;
    border-bottom: 1px solid rgba(74, 222, 128, 0.1);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 0.825rem;
    line-height: 1.5;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .sahyak-breadcrumb-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0.65rem 1.5rem;
  }

  .sahyak-breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none !important;
    list-style-type: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .sahyak-breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none !important;
    list-style-type: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .sahyak-breadcrumb-item::marker {
    display: none !important;
    content: '' !important;
  }

  .sahyak-breadcrumb-separator {
    color: #4B5563;
    user-select: none;
    font-size: 0.75rem;
    font-weight: 400;
  }

  .sahyak-breadcrumb-link {
    color: #9CA3AF;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease, background-color 0.15s ease;
    border-radius: 4px;
    padding: 0.1rem 0.25rem;
  }

  .sahyak-breadcrumb-link:hover {
    color: #4ADE80;
    text-decoration: none;
  }

  .sahyak-breadcrumb-link:focus-visible {
    outline: 2px solid #4ADE80;
    outline-offset: 2px;
    color: #FFFFFF;
  }

  .sahyak-breadcrumb-current {
    color: #F3F4F6;
    font-weight: 600;
    padding: 0.1rem 0.25rem;
  }

  @media (max-width: 640px) {
    .sahyak-breadcrumb-container {
      padding: 0.5rem 1.25rem;
    }
    .sahyak-breadcrumb-nav {
      font-size: 0.8rem;
    }
  }
</style>
