---
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  schema?: Record<string, any> | Record<string, any>[];
  activeNav?: 'home' | 'features' | 'pricing' | 'about' | 'resources' | 'security' | 'contact';
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl = `https://sahyak.com${Astro.url.pathname.replace(/\/$/, '') || '/'}`,
  ogImage = 'https://sahyak.com/images/sahyak-logo.png',
  ogType = 'website',
  schema,
  activeNav = 'home',
  breadcrumbs,
  noindex = false
} = Astro.props;

// Base Organization Schema for Google & AI discoverability with full E-E-A-T credentials
const baseOrgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://sahyak.com/#organization",
  "name": "Sahyak CRM",
  "legalName": "Sahyak Real Estate Technologies Private Limited",
  "url": "https://sahyak.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://sahyak.com/images/sahyak-logo.png",
    "width": "512",
    "height": "512"
  },
  "description": "Enterprise mobile-first Real Estate CRM engineered for property developers, brokers, and channel partners across 15+ countries.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bandra Kurla Complex, Bandra East",
    "addressLocality": "Mumbai",
    "addressRegion": "Maharashtra",
    "postalCode": "400051",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 19.0657,
    "longitude": 72.8682
  },
  "sameAs": [
    "https://twitter.com/sahyakcrm",
    "https://linkedin.com/company/sahyakcrm",
    "https://github.com/mayalok-ventures/real-estate-website"
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91 87964 75107",
      "contactType": "sales",
      "email": "support@sahyak.com",
      "areaServed": ["IN", "AE", "US", "GB", "SG"],
      "availableLanguage": ["English", "Hindi"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+91 87964 75107",
      "contactType": "customer service",
      "email": "support@sahyak.com",
      "availableLanguage": ["English", "Hindi"]
    }
  ],
  "knowsAbout": [
    "Real Estate CRM Software",
    "WhatsApp Automation for Property Sales",
    "Site Visit Coordination & Attendance Tracking",
    "RERA Compliance & Broker Inventory",
    "Multi-Project Lead Management"
  ]
};

// WebSite Schema with Sitelinks Searchbox
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://sahyak.com/#website",
  "url": "https://sahyak.com",
  "name": "Sahyak CRM",
  "publisher": { "@id": "https://sahyak.com/#organization" },
  "inLanguage": "en-US"
};

// Software Application Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sahyak Real Estate CRM",
  "operatingSystem": "Web, iOS, Android, Cloudflare Edge",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "499",
    "priceCurrency": "INR",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "148",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// BreadcrumbList Schema (if breadcrumbs provided)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": crumb.name,
    "item": crumb.url.startsWith('http') ? crumb.url : `https://sahyak.com${crumb.url}`
  }))
} : null;

const fullSchemaList = [
  baseOrgSchema,
  webSiteSchema,
  softwareSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
  
  <!-- GEO SEO & Local Targeting -->
  <meta name="geo.region" content="IN-MH" />
  <meta name="geo.placename" content="Mumbai, Maharashtra, India" />
  <meta name="geo.position" content="19.0657;72.8682" />
  <meta name="ICBM" content="19.0657, 72.8682" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Sahyak Real Estate CRM" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="Sahyak CRM — The Operating System for Real Estate" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="en_IN" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@sahyakcrm" />
  <meta name="twitter:creator" content="@sahyakcrm" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="Sahyak Real Estate CRM" />

  <!-- Theme & Icons -->
  <meta name="theme-color" content="#0A1C16" />
  <link rel="icon" type="image/png" href="/images/sahyak-logo.png" />
  <link rel="apple-touch-icon" href="/images/sahyak-logo.png" />

  <!-- Google Fonts: Playfair Display (Serif), Inter (Sans), Caveat (Handwritten) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

  <!-- Structured Data JSON-LD -->
  {fullSchemaList.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
</head>
<body>
  <!-- Accessibility: Skip to Main Content -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Header Navigation -->
  <header class="site-header" id="site-header">
    <div class="container header-inner">
      <a href="/" class="site-logo" aria-label="Sahyak CRM Homepage">
        <img src="/images/sahyak-logo.png" alt="Sahyak CRM — Real Estate Operating System" width="34" height="34" style="height: 34px; width: auto; object-fit: contain; border-radius: 4px;" />
        <span>Sahyak CRM</span>
      </a>

      <!-- Desktop Nav -->
      <nav aria-label="Primary Navigation">
        <ul class="nav-links">
          <li><a href="/" class={`nav-link ${activeNav === 'home' ? 'active' : ''}`}>Home</a></li>
          <li><a href="/features" class={`nav-link ${activeNav === 'features' ? 'active' : ''}`}>Features</a></li>
          <li><a href="/pricing" class={`nav-link ${activeNav === 'pricing' ? 'active' : ''}`}>Pricing</a></li>
          <li><a href="/about" class={`nav-link ${activeNav === 'about' ? 'active' : ''}`}>About</a></li>
          <li><a href="/resources" class={`nav-link ${activeNav === 'resources' ? 'active' : ''}`}>Resources</a></li>
          <li><a href="/security" class={`nav-link ${activeNav === 'security' ? 'active' : ''}`}>Security</a></li>
          <li><a href="/contact" class={`nav-link ${activeNav === 'contact' ? 'active' : ''}`}>Contact</a></li>
        </ul>
      </nav>

      <!-- Action Buttons -->
      <div class="header-actions">
        <a href="/contact" class="btn btn-primary btn-sm">Start free &rarr;</a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" id="mobile-toggle-btn" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile Drawer Navigation -->
    <div class="mobile-drawer" id="mobile-drawer-menu">
      <a href="/">Home</a>
      <a href="/features">Features</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About Us</a>
      <a href="/resources">Resources & Guides</a>
      <a href="/security">Security & Privacy</a>
      <a href="/contact">Contact Sales</a>
      <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <a href="/contact" class="btn btn-primary" style="text-align: center;">Get Started Free &rarr;</a>
      </div>
    </div>
  </header>

  <!-- Breadcrumbs Visual Navigation Trail -->
  {breadcrumbs && breadcrumbs.length > 0 && (
    <nav aria-label="Breadcrumbs" class="breadcrumb-nav">
      <div class="container">
        <ol class="breadcrumb-list">
          {breadcrumbs.map((crumb, idx) => (
            <li class="breadcrumb-item">
              {idx > 0 && <span class="breadcrumb-separator" aria-hidden="true">&rsaquo;</span>}
              {idx === breadcrumbs.length - 1 ? (
                <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.url}>{crumb.name}</a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <!-- Main Slot -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="site-logo" style="margin-bottom: 1.25rem;">
            <img src="/images/sahyak-logo.png" alt="Sahyak CRM" style="height: 36px; width: auto; object-fit: contain; border-radius: 4px;" />
            <span>Sahyak CRM</span>
          </div>
          <p style="color: var(--text-light-muted); max-width: 320px; font-size: 0.95rem; margin-bottom: 1.5rem;">
            The mobile-first real estate CRM built for real people. Capture leads, coordinate client visits, and close deals effortlessly across 15+ countries.
          </p>
          <div style="display: flex; gap: 0.75rem;">
            <span class="badge-pill" style="margin: 0; font-size: 0.75rem;">
              <span class="badge-dot"></span> Built for Global Real Estate
            </span>
          </div>
        </div>

        <div class="footer-col">
          <h4>Product</h4>
          <ul>
            <li><a href="/features">All Features</a></li>
            <li><a href="/features#lead-management">Lead Capture</a></li>
            <li><a href="/features#whatsapp">Multi-Channel Follow-ups</a></li>
            <li><a href="/features#site-visits">Site Visit Coordinator</a></li>
            <li><a href="/features#inventory">Inventory Management</a></li>
            <li><a href="/pricing">Pricing & Plans</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Resources</h4>
          <ul>
            <li><a href="/resources">Resource Center</a></li>
            <li><a href="/resources#guides">Real Estate Playbooks</a></li>
            <li><a href="/resources#tutorials">Video Tutorials</a></li>
            <li><a href="/security">Security & Encryption</a></li>
            <li><a href="/contact">Support & Help Desk</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href="/about">About Sahyak CRM</a></li>
            <li><a href="/contact">Contact Team</a></li>
            <li><a href="mailto:support@sahyak.com">support@sahyak.com</a></li>
            <li><a href="tel:+918796475107">+91 87964 75107</a></li>
            <li><a href="/security">Data Privacy & GDPR</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Sahyak CRM (<a href="https://sahyak.com" style="color: #4ADE80; text-decoration: none;">sahyak.com</a>). All rights reserved.</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <a href="/security" style="color: inherit;">Privacy Policy</a>
          <a href="/security" style="color: inherit;">Terms of Service</a>
          <a href="/security" style="color: inherit;">Data Protection</a>
          <a href="/sitemap-index.xml" style="color: inherit;">Sitemap</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Lightweight Client Script for Interactivity -->
  <script is:inline>
    // 1. Mobile Menu Drawer Toggle
    const toggleBtn = document.getElementById('mobile-toggle-btn');
    const drawer = document.getElementById('mobile-drawer-menu');
    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', () => {
        const isOpen = drawer.classList.toggle('open');
        toggleBtn.setAttribute('aria-expanded', isOpen);
      });
      // Close drawer on link click
      drawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          drawer.classList.remove('open');
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // 2. Scroll Animation Observer
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
    }
  </script>
</body>
</html>
