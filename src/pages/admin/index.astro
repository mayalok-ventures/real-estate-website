                      <p style="font-size: 0.75rem; color: #9CA3AF; margin-top: 4px;">Once your keys are verified and users search for Sahyak on Google, exact keywords and clicks will be cataloged here.</p>
                    </td>
                  </tr>
                ) : (
                  gscData.topQueries.map((q) => {
                    let rankBadge = '#6B7280';
                    let rankBg = '#F3F4F6';
                    if (q.position <= 3) { rankBadge = '#059669'; rankBg = 'rgba(16, 185, 129, 0.15)'; }
                    else if (q.position <= 10) { rankBadge = '#2563EB'; rankBg = 'rgba(59, 130, 246, 0.15)'; }
                    else if (q.position <= 20) { rankBadge = '#D97706'; rankBg = '#FEF3C7'; }

                    return (
                      <tr style="border-bottom: 1px solid #F3F4F6;" class="gsc-query-row" data-query={q.query.toLowerCase()}>
                        <td style="padding: 0.85rem 1rem;">
                          <strong style="color: #111827; display: flex; align-items: center; gap: 6px;">
                            <i class="fa-solid fa-magnifying-glass" style="font-size: 0.7rem; color: #9CA3AF;"></i> {q.query}
                          </strong>
