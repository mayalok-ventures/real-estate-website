          <div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid #F1F5F9;">
            <button class="lead-pill-btn active" data-status="all" style="background: #0F172A; color: white; border: 1px solid #0F172A; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              All Leads <span id="pill-total-leads" style="background: rgba(255,255,255,0.2); padding: 1px 6px; border-radius: 10px; font-size: 0.75rem;">{leadSummary.total}</span>
            </button>
            <button class="lead-pill-btn" data-status="new" style="background: #F3F4F6; color: #374151; border: 1px solid #E5E7EB; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              New <span id="pill-new-leads" style="background: #FEF3C7; color: #92400E; padding: 1px 6px; border-radius: 10px; font-size: 0.75rem;">{leadSummary.new}</span>
            </button>
            <button class="lead-pill-btn" data-status="contacted" style="background: #F3F4F6; color: #374151; border: 1px solid #E5E7EB; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              Contacted <span id="pill-contacted-leads" style="background: #E0E7FF; color: #3730A3; padding: 1px 6px; border-radius: 10px; font-size: 0.75rem;">{leadSummary.contacted}</span>
            </button>
            <button class="lead-pill-btn" data-status="qualified" style="background: #F3F4F6; color: #374151; border: 1px solid #E5E7EB; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              Qualified <span id="pill-qualified-leads" style="background: #DCFCE7; color: #166534; padding: 1px 6px; border-radius: 10px; font-size: 0.75rem;">{leadSummary.qualified}</span>
            </button>
            <button class="lead-pill-btn" data-status="closed" style="background: #F3F4F6; color: #374151; border: 1px solid #E5E7EB; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              Closed Deal <span id="pill-closed-leads" style="background: #F3E8FF; color: #6B21A8; padding: 1px 6px; border-radius: 10px; font-size: 0.75rem;">{leadSummary.closed}</span>
            </button>
            <button class="lead-pill-btn" data-status="archived" style="background: #F3F4F6; color: #374151; border: 1px solid #E5E7EB; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              Archived <span id="pill-archived-leads" style="background: #E5E7EB; color: #4B5563; padding: 1px 6px; border-radius: 10px; font-size: 0.75rem;">{leadSummary.archived}</span>
            </button>
          </div>

          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; min-width: 850px; font-size: 0.9rem;">
              <thead>
                <tr style="background: #F9FAFB; border-bottom: 2px solid #E5E7EB; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                  <th style="padding: 1rem; text-align: left;">ID / Date</th>
                  <th style="padding: 1rem; text-align: left;">Prospect Details</th>
                  <th style="padding: 1rem; text-align: left;">Phone & WhatsApp</th>
                  <th style="padding: 1rem; text-align: left;">Inquiry Type</th>
                  <th style="padding: 1rem; text-align: left;">Company</th>
                  <th style="padding: 1rem; text-align: left;">Status</th>
                  <th style="padding: 1rem; text-align: center;">Actions</th>
                </tr>
              </thead>
              <tbody id="leads-table-body">
                {contacts.length === 0 ? (
                  <tr>
                    <td colspan="7" style="padding: 3rem 1rem; text-align: center; color: #6B7280;">
                      <div style="font-size: 2rem; margin-bottom: 0.5rem; color: #D1D5DB;"><i class="fa-solid fa-inbox"></i></div>
                      <div style="font-weight: 700; color: #111827; font-size: 1rem;">No Inquiries Found</div>
                      <p style="font-size: 0.85rem; margin-top: 0.25rem; color: #9CA3AF;">Form inquiries submitted via contact and demo forms will appear here in real time.</p>
                    </td>
                  </tr>
                ) : (
                  contacts.map((c) => (
                    <tr style="border-bottom: 1px solid #F3F4F6;" class="lead-row" data-id={c.id} data-status={c.status} data-notes={c.admin_notes || ''} data-message={c.message || ''} data-name={c.name} data-email={c.email} data-phone={c.phone} data-company={c.company || ''} data-type={c.inquiry_type} data-created={c.created_at || ''}>
                      <td style="padding: 1rem;">
                        <strong style="color: #0A1C16;">#{c.id}</strong>
                        <div style="font-size: 0.75rem; color: #6B7280;">{c.created_at ? new Date(c.created_at).toLocaleDateString() : 'Today'}</div>
                      </td>
                      <td style="padding: 1rem;">
                        <strong style="color: #111827; display: block;">{c.name}</strong>
                        <span style="font-size: 0.8rem; color: #6B7280;">{c.email}</span>
                      </td>
                      <td style="padding: 1rem;">
                        <a href={`tel:${c.phone}`} style="font-weight: 600; color: #0A1C16; display: block; text-decoration: none;">{c.phone}</a>
                        <a href={`https://wa.me/${(c.phone || '').replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" style="font-size: 0.75rem; color: #059669; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                          <i class="fa-brands fa-whatsapp"></i> WhatsApp Chat
                        </a>
                      </td>
                      <td style="padding: 1rem;">
                        <span style="background: #F3F4F6; padding: 3px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600; text-transform: capitalize; color: #374151;">
                          {c.inquiry_type}
                        </span>
                      </td>
                      <td style="padding: 1rem; color: #4B5563;">
                        {c.company || 'Individual Broker'}
                      </td>
                      <td style="padding: 1rem;">
                        <select class="status-selector" data-id={c.id} style="padding: 0.4rem 0.6rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; border: 1px solid #D1D5DB; background: white;">
                          <option value="new" selected={c.status === 'new'}>New</option>
                          <option value="contacted" selected={c.status === 'contacted'}>Contacted</option>
                          <option value="qualified" selected={c.status === 'qualified'}>Qualified</option>
                          <option value="closed" selected={c.status === 'closed'}>Closed Deal</option>
                          <option value="archived" selected={c.status === 'archived'}>Archived</option>
                        </select>
                      </td>
                      <td style="padding: 1rem; text-align: center;">
                        <button class="btn btn-sm btn-dark-outline manage-lead-btn" data-id={c.id} style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 5px;">
                          <i class="fa-solid fa-pen-to-square"></i> Notes & Details
                        </button>
                        {c.admin_notes && (
                          <div style="font-size: 0.7rem; color: #D97706; margin-top: 3px; display: flex; align-items: center; justify-content: center; gap: 4px;">
                            <i class="fa-solid fa-note-sticky"></i> Note attached
                          </div>
                        )}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          <!-- Server-side Pagination Controls -->
          <div id="leads-pagination-bar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding: 1.25rem 0.5rem 0; border-top: 1px solid #E5E7EB; margin-top: 0.75rem;">
            <div style="font-size: 0.85rem; color: #6B7280;">
              Showing <strong id="pagination-showing-start" style="color: #111827;">{initialPaginatedLeads.total > 0 ? 1 : 0}</strong> - <strong id="pagination-showing-end" style="color: #111827;">{Math.min(initialPaginatedLeads.total, initialPaginatedLeads.limit)}</strong> of <strong id="pagination-total-records" style="color: #111827;">{initialPaginatedLeads.total}</strong> Leads
            </div>

            <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
              <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #4B5563;">
                <span>Rows:</span>
                <select id="pagination-limit-select" style="padding: 0.3rem 0.5rem; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 0.85rem; background: white;">
                  <option value="10">10</option>
                  <option value="25" selected>25</option>
                  <option value="50">50</option>
                  <option value="100">100</option>
                </select>
              </div>

              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <button id="pagination-prev-btn" class="btn btn-sm btn-outline" style="border-radius: 6px; padding: 0.35rem 0.75rem; font-size: 0.8rem;" disabled>
                  <i class="fa-solid fa-chevron-left"></i> Prev
                </button>
                <span id="pagination-page-indicator" style="font-size: 0.85rem; font-weight: 600; color: #374151; padding: 0 0.5rem;">
                  Page 1 of {initialPaginatedLeads.totalPages}
                </span>
                <button id="pagination-next-btn" class="btn btn-sm btn-outline" style="border-radius: 6px; padding: 0.35rem 0.75rem; font-size: 0.8rem;" disabled={!initialPaginatedLeads.hasNext}>
                  Next <i class="fa-solid fa-chevron-right"></i>
                </button>
              </div>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- ========================================================================= -->
  <!-- MAIN PORTAL 2: GOOGLE SEARCH CONSOLE CENTRAL (COMPLETE STANDALONE PORTAL) -->
  <!-- ========================================================================= -->
  <main id="portal-gsc-view" style="display: none; background: #F8FAFC; min-height: 85vh; padding: 2rem 0 4rem;">
    <div class="container" style="max-width: 1400px; margin: 0 auto; padding: 0 1.5rem;">

      <!-- GSC Hub Header Bar -->
      <div style="background: #FFFFFF; border-radius: 16px; border: 1px solid #E2E8F0; padding: 1.35rem 1.5rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
        <div>
          <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <h2 style="font-size: 1.35rem; font-weight: 700; color: #0F172A; display: flex; align-items: center; gap: 8px;">
              <i class="fa-brands fa-google" style="color: #4285F4; font-size: 1.4rem;"></i> Google Search Console Central
            </h2>

            <!-- Status Indicator Badge -->
            {gscData.status === 'connected' && (
              <span style="background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 3px 10px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-circle-check"></i> Connected & Live
              </span>
            )}
            {gscData.status === 'not_configured' && (
              <span style="background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; padding: 3px 10px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-triangle-exclamation"></i> Keys Missing
              </span>
            )}
            {gscData.status === 'permission_denied' && (
              <span style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 3px 10px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-shield-halved"></i> Permission Required in GSC
              </span>
            )}
            {gscData.status === 'auth_error' && (
              <span style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 3px 10px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-triangle-exclamation"></i> Private Key Format Action Needed
              </span>
            )}
            {gscData.status === 'api_error' && (
              <span style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 3px 10px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-triangle-exclamation"></i> GSC API Unavailable
              </span>
            )}

            <span style={`padding: 3px 10px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; ${gscData.isLive ? 'background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;' : 'background: #F1F5F9; color: #64748B; border: 1px solid #E2E8F0;'}`}>
              <i class={`fa-solid ${gscData.isLive ? 'fa-satellite-dish' : 'fa-power-off'}`}></i>
              {gscData.isLive ? 'Live GSC Stream' : 'Live Sync Inactive'}
            </span>

            {gscData.lastFetchedAt && (
              <span style="font-size: 0.75rem; color: #64748B; background: #F1F5F9; border: 1px solid #E2E8F0; padding: 2px 8px; border-radius: 6px;">
                Synced: {new Date(gscData.lastFetchedAt).toLocaleTimeString()}
              </span>
            )}

            <span style="font-size: 0.8rem; color: #475569; font-family: monospace; background: #F1F5F9; border: 1px solid #E2E8F0; padding: 2px 8px; border-radius: 6px;">
              Property: {gscData.siteUrl}
            </span>
          </div>
          <p style="font-size: 0.85rem; color: #64748B; margin-top: 4px;">
            Full-suite replacement for Google Search Console: SERP performance, search queries, URL inspection, XML sitemaps, and striking distance SEO.
          </p>
        </div>

        <!-- Controls: Range Switcher, Refresh & Master Export -->
        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
          <div style="display: flex; background: #F1F5F9; border: 1px solid #E2E8F0; border-radius: 8px; padding: 3px; box-shadow: inset 1px 1px 2px rgba(15, 23, 42, 0.04);">
            <button class="gsc-range-btn" data-range="7d">7 Days</button>
            <button class="gsc-range-btn active" data-range="28d">28 Days</button>
            <button class="gsc-range-btn" data-range="90d">3 Months</button>
          </div>

          <button id="gsc-refresh-btn" class="btn btn-sm btn-outline" style="border-radius: 8px; font-size: 0.8rem; padding: 0.45rem 0.85rem; display: flex; align-items: center; gap: 5px;">
            <i class="fa-solid fa-arrows-rotate" id="gsc-spinner" style="color: #059669;"></i> Refresh Data
          </button>

          <a href="/api/admin/gsc/export?type=all" class="btn btn-sm btn-primary" download style="border-radius: 8px; font-size: 0.8rem; padding: 0.45rem 0.85rem; display: flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-file-arrow-down"></i> Export Master CSV
          </a>
        </div>
      </div>

      <!-- Key Diagnostic Guide Card (Protects .env secrecy & guides the RSA Private Key format) -->
      {gscData.status !== 'connected' && (
        <div style="background: #FFFBEB; border: 1px solid #FCD34D; border-radius: 14px; padding: 1.5rem; margin-bottom: 2rem;">
          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <i class="fa-solid fa-shield-halved" style="color: #D97706; font-size: 1.75rem; margin-top: 2px;"></i>
            <div style="flex: 1;">
              <h4 style="font-weight: 700; color: #92400E; margin-bottom: 0.25rem; font-size: 1.05rem;">
                Google Cloud Service Account Configuration Notice
              </h4>
              <p style="font-size: 0.85rem; color: #B45309; line-height: 1.5;">
                {gscData.statusMessage}
              </p>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; margin-top: 1rem;">
                <div style="background: white; border: 1px solid #FDE68A; border-radius: 8px; padding: 0.75rem;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">1. Client Email</span>
                  <div style="font-size: 0.85rem; font-weight: 600; margin-top: 2px;">
                    {gscData.clientEmail ? (
                      <span style="color: #059669; word-break: break-all;">✓ Loaded from .env</span>
                    ) : (
                      <span style="color: #DC2626;">✗ Missing in .env</span>
                    )}
                  </div>
                </div>

                <div style="background: white; border: 1px solid #FDE68A; border-radius: 8px; padding: 0.75rem;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">2. RSA Private Key</span>
                  <div style="font-size: 0.85rem; font-weight: 600; margin-top: 2px;">
                    {gscData.isKeyFormatValid ? (
                      <span style="color: #059669;">✓ Valid RSA Private Key</span>
                    ) : (
                      <span style="color: #D97706;">⚠ Needs RSA "private_key" from JSON</span>
                    )}
                  </div>
                </div>

                <div style="background: white; border: 1px solid #FDE68A; border-radius: 8px; padding: 0.75rem;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">3. Property Site URL</span>
                  <div style="font-size: 0.85rem; font-weight: 600; color: #0A1C16; margin-top: 2px;">
                    {gscData.siteUrl}
                  </div>
                </div>
              </div>

              <div style="background: white; border-left: 4px solid #D97706; padding: 0.85rem 1rem; border-radius: 6px; margin-top: 1rem; font-size: 0.82rem; color: #78350F; line-height: 1.6;">
                <strong>How to finalize:</strong><br/>
                When downloading a Service Account key from Google Cloud Console, Google gives you a <code>.json</code> file with multiple fields:<br/>
                &bull; <code>client_email</code>: e.g. <code>...@...iam.gserviceaccount.com</code><br/>
                &bull; <strong><code>private_key</code></strong>: A long key starting with <code>"-----BEGIN PRIVATE KEY-----\n..."</code> (be sure to copy this exact field into <code>GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY</code> in <code>.env</code>)<br/>
                &bull; Then in <a href="https://search.google.com/search-console" target="_blank" style="color: #1E40AF; font-weight: 700; text-decoration: underline;">Google Search Console &gt; Settings &gt; Users and Permissions</a>, ensure the service account email is added as a user.
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- 4 Core Organic KPI Cards -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        
        <div style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Total Organic Clicks</span>
            <span style="background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 2px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              <i class="fa-solid fa-arrow-pointer"></i> SERP
            </span>
          </div>
          <div id="gsc-stat-clicks" style="font-size: 2.25rem; font-weight: 700; color: #059669; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {gscData.totalClicks.toLocaleString()}
          </div>
          <p style="font-size: 0.75rem; color: #64748B; margin-top: 0.5rem;">
            Direct organic clicks from Google SERP
          </p>
        </div>

        <div style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Total Impressions</span>
            <span style="background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; padding: 2px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              <i class="fa-solid fa-eye"></i> Views
            </span>
          </div>
          <div id="gsc-stat-impressions" style="font-size: 2.25rem; font-weight: 700; color: #2563EB; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {gscData.totalImpressions.toLocaleString()}
          </div>
          <p style="font-size: 0.75rem; color: #64748B; margin-top: 0.5rem;">
            Appearances in Google search results
          </p>
        </div>

        <div style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Average CTR</span>
            <span style="background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; padding: 2px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              <i class="fa-solid fa-percent"></i> CTR
            </span>
          </div>
          <div id="gsc-stat-ctr" style="font-size: 2.25rem; font-weight: 700; color: #D97706; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {gscData.avgCtr}%
          </div>
          <p style="font-size: 0.75rem; color: #64748B; margin-top: 0.5rem;">
            Click-through rate from search impressions
          </p>
        </div>

        <div style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Average Position</span>
