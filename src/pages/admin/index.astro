                        </td>
                        <td style="padding: 0.9rem 1rem; text-align: right; font-size: 0.8rem; color: #6B7280;">
                          {new Date(v.last_active_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                        </td>
                      </tr>
                    );
                  })
                )}
