                  analytics.visitorLogs.map((v) => {
                    const isLive = (Date.now() - new Date(v.last_active_at).getTime()) < 120000;
                    const cFlag = COUNTRY_META[v.country_code]?.flag || '🌐';
                    return (
                      <tr style="border-bottom: 1px solid #F3F4F6;" class="geo-row" data-country={v.country} data-search={`${v.city} ${v.country} ${v.page} ${v.traffic_source}`.toLowerCase()}>
