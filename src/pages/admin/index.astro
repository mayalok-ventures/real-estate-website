                <tr style="background: #F9FAFB; border-bottom: 2px solid #E5E7EB; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                  <th style="padding: 0.85rem 1rem; text-align: left;">Search Query / Keyword</th>
                  <th style="padding: 0.85rem 1rem; text-align: right;">Organic Clicks</th>
                  <th style="padding: 0.85rem 1rem; text-align: right;">Google Impressions</th>
                  <th style="padding: 0.85rem 1rem; text-align: right;">CTR (%)</th>
                  <th style="padding: 0.85rem 1rem; text-align: center;">Average SERP Position</th>
