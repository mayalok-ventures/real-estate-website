---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getContacts } from '../../lib/db';
import { getRuntimeEnv } from '../../lib/env';
import { getAnalyticsSummary, formatDuration, COUNTRY_META } from '../../lib/analytics';
import { getSearchConsoleData } from '../../lib/googleSearchConsole';

const admin = (Astro.locals as any)?.admin;
if (!admin || !admin.email) {
  return Astro.redirect('/admin/login');
}

let env: any = {};
let contacts: any[] = [];
let analytics: any = {
  totalVisitors: 0,
  uniqueVisitors: 0,
  pageViews: 0,
  avgDwellTime: 0,
  bounceRate: 0,
  realtimeActiveUsers: 0,
  topPages: [],
  topReferrers: [],
  topCountries: [],
  deviceDistribution: {},
  hourlyTraffic: []
};
let gscData: any;

try {
  env = await getRuntimeEnv();
} catch (e) {
  console.warn('[Admin] Failed to load runtime env:', e);
}

try {
  contacts = await getContacts(env?.DB, { limit: 100 });
} catch (e) {
  console.warn('[Admin] Failed to load contacts from DB:', e);
  contacts = [];
}

try {
  analytics = getAnalyticsSummary('24h');
} catch (e) {
  console.warn('[Admin] Failed to load analytics summary:', e);
}

try {
  gscData = await getSearchConsoleData(env || {}, { range: '28d' });
} catch (e) {
  console.error('[Admin] getSearchConsoleData caught in page:', e);
}

// Compute pipeline stats
const totalLeads = contacts.length;
const newLeads = contacts.filter(c => c.status === 'new').length;
const contactedLeads = contacts.filter(c => c.status === 'contacted').length;
const qualifiedLeads = contacts.filter(c => c.status === 'qualified').length;
---

<Layout title="Executive Admin & Analytics Console - Sahyak CRM" description="Real-time website analytics, visitor traffic tracking, dwell time insights, and Google Search Console portal.">

  <!-- Font Awesome & Chart.js CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- TOP ADMIN BAR -->
  <section style="background: #0A1C16; border-bottom: 1px solid rgba(74, 222, 128, 0.2); padding: 1rem 0; position: sticky; top: 0; z-index: 900; backdrop-filter: blur(10px);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <span class="badge-pill" style="margin: 0; background: rgba(74, 222, 128, 0.15); color: #4ADE80; border: 1px solid rgba(74, 222, 128, 0.3); font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 50px; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #4ADE80; box-shadow: 0 0 10px #4ADE80; display: inline-block; animation: pulse 2s infinite;"></span>
          Sahyak Command Center
        </span>
        <span style="color: #9CA3AF; font-size: 0.85rem;">
          Operator: <strong style="color: white;">{admin.email}</strong> ({admin.role})
        </span>
        <div id="live-active-badge" style="background: rgba(0, 230, 118, 0.1); border: 1px solid #00E676; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; color: #00E676; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-circle" style="font-size: 6px;"></i>
          <span id="badge-active-count">{analytics.realtimeActiveUsers}</span> Online Now
        </div>
      </div>

      <!-- Quick Export & Session Controls -->
      <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <div class="export-dropdown" style="position: relative;">
          <button id="export-menu-btn" class="btn btn-sm" style="background: rgba(255, 255, 255, 0.1); color: white; border: 1px solid rgba(255, 255, 255, 0.2); font-size: 0.85rem; padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-file-arrow-down" style="color: #4ADE80;"></i> Export Reports <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
          </button>
          <div id="export-dropdown-menu" style="display: none; position: absolute; right: 0; top: 110%; background: #111827; border: 1px solid #374151; border-radius: 8px; min-width: 250px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); z-index: 1000; overflow: hidden;">
            <div style="padding: 0.5rem 1rem 0.25rem; font-size: 0.7rem; font-weight: 700; color: #9CA3AF; text-transform: uppercase;">Website Traffic</div>
            <a href="/api/admin/analytics/export?type=all" class="export-link" download>
              <i class="fa-solid fa-chart-pie"></i> Master Executive CSV
            </a>
            <a href="/api/admin/analytics/export?type=visitors" class="export-link" download>
              <i class="fa-solid fa-users"></i> Visitor Session Logs (CSV)
            </a>
            <a href="/api/admin/analytics/export?type=pages" class="export-link" download>
              <i class="fa-solid fa-stopwatch"></i> Page & Section Dwell (CSV)
            </a>
            <a href="/api/admin/analytics/export?type=sources" class="export-link" download>
              <i class="fa-solid fa-share-nodes"></i> Traffic Sources & Sites (CSV)
            </a>
            <div style="border-top: 1px solid #374151;"></div>
            <div style="padding: 0.5rem 1rem 0.25rem; font-size: 0.7rem; font-weight: 700; color: #4ADE80; text-transform: uppercase;">Google Search Console</div>
            <a href="/api/admin/gsc/export?type=all" class="export-link" download>
              <i class="fa-brands fa-google"></i> Master GSC Report (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=queries" class="export-link" download>
              <i class="fa-solid fa-magnifying-glass"></i> Top Search Keywords (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=pages" class="export-link" download>
              <i class="fa-solid fa-file-lines"></i> Ranking Landing Pages (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=countries" class="export-link" download>
              <i class="fa-solid fa-earth-americas"></i> Organic Countries (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=clusters" class="export-link" download>
              <i class="fa-solid fa-cubes-stacked"></i> Keyword Clusters (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=audit" class="export-link" download>
              <i class="fa-solid fa-shield-check"></i> Technical SEO Audit (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=truth" class="export-link" download>
              <i class="fa-solid fa-scale-balanced"></i> Product Truth Audit (CSV)
            </a>
            <div style="border-top: 1px solid #374151;"></div>
            <a href="/api/admin/leads?format=csv" class="export-link" download>
              <i class="fa-solid fa-clipboard-list"></i> Form Leads Data (CSV)
            </a>
          </div>
        </div>

        <a href="/api/admin/logout" class="btn btn-sm" style="background: #DC2626; color: white; border-radius: 8px; padding: 0.5rem 0.9rem; font-size: 0.85rem;">
          <i class="fa-solid fa-right-from-bracket"></i> Log out
        </a>
      </div>
    </div>
  </section>

  <!-- HIGH-LEVEL PORTAL SWITCHER: ISOLATE CRM VS SEARCH CONSOLE -->
  <section style="background: #081712; border-bottom: 2px solid rgba(74, 222, 128, 0.15); padding: 0.75rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <button id="portal-switch-crm" class="portal-mode-btn active" data-portal="crm">
          <i class="fa-solid fa-chart-pie"></i> Website CRM & Traffic Hub
        </button>
        <button id="portal-switch-gsc" class="portal-mode-btn" data-portal="gsc">
          <i class="fa-brands fa-google"></i> Google Search Console Central
        </button>
      </div>

      <!-- Quick indicator of active view -->
      <div id="portal-status-label" style="font-size: 0.8rem; color: #9CA3AF; display: flex; align-items: center; gap: 6px;">
        <i class="fa-solid fa-layer-group" style="color: #4ADE80;"></i>
        <span>Viewing: <strong id="current-portal-title" style="color: white;">Website CRM & Traffic Hub</strong></span>
      </div>
    </div>
  </section>

  <!-- SUB-NAVIGATION TABS (Contextual to active portal) -->
  <section id="crm-tabs-bar" style="background: #0D241C; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container">
      <div class="admin-tabs" style="display: flex; gap: 0.5rem; overflow-x: auto; padding: 0.5rem 0;">
        <button class="crm-tab-btn active" data-tab="tab-overview">
          <i class="fa-solid fa-gauge-high"></i> Overview
        </button>
        <button class="crm-tab-btn" data-tab="tab-chart">
          <i class="fa-solid fa-chart-line"></i> Traffic Graph
        </button>
        <button class="crm-tab-btn" data-tab="tab-pages">
          <i class="fa-solid fa-clock"></i> Page & Section Dwell
        </button>
        <button class="crm-tab-btn" data-tab="tab-sources">
          <i class="fa-solid fa-bullhorn"></i> Traffic Sources & 1,000+ Sites
        </button>
        <button class="crm-tab-btn" data-tab="tab-geo">
          <i class="fa-solid fa-globe"></i> Location & Live Sessions
        </button>
        <button class="crm-tab-btn" data-tab="tab-leads">
          <i class="fa-solid fa-envelope-open-text"></i> Form Leads ({totalLeads})
        </button>
      </div>
    </div>
  </section>

  <section id="gsc-tabs-bar" style="display: none; background: #0D241C; border-bottom: 1px solid rgba(255, 255, 255, 0.08); position: sticky; top: 58px; z-index: 850;">
    <div class="container">
      <div class="admin-tabs" style="display: flex; gap: 0.5rem; overflow-x: auto; padding: 0.5rem 0; scrollbar-width: thin;">
        <button class="gsc-tab-btn active" data-gsctab="gsc-tab-overview">
          <i class="fa-solid fa-heart-pulse" style="color: #4ADE80;"></i> Overview & Health
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-perf">
          <i class="fa-solid fa-chart-line"></i> Search Performance
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-opps">
          <i class="fa-solid fa-lightbulb" style="color: #F59E0B;"></i> Opportunities
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-alerts">
          <i class="fa-solid fa-bell"></i> Alerts <span style="background: #10B981; color: #0A1C16; border-radius: 10px; padding: 1px 6px; font-size: 0.7rem; font-weight: 800;">{gscData.alerts?.length || 5}</span>
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-market">
          <i class="fa-solid fa-crosshairs"></i> Market Intelligence
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-tools">
          <i class="fa-solid fa-screwdriver-wrench"></i> Interactive Tools
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-conversion">
          <i class="fa-solid fa-funnel-dollar" style="color: #10B981;"></i> SEO Conversion
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-authority">
          <i class="fa-solid fa-diagram-project"></i> Topic Authority Graph
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-truth">
          <i class="fa-solid fa-scale-balanced" style="color: #3B82F6;"></i> Product Truth
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-clusters">
          <i class="fa-solid fa-cubes-stacked"></i> Clusters
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-keywords">
          <i class="fa-solid fa-magnifying-glass"></i> Keywords
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-pages">
          <i class="fa-solid fa-file-lines"></i> Pages
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-audit">
          <i class="fa-solid fa-shield-check" style="color: #10B981;"></i> Audit Issues
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-sitemaps">
          <i class="fa-solid fa-sitemap"></i> Sitemaps
        </button>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MAIN PORTAL 1: WEBSITE CRM & TRAFFIC HUB (COMPLETELY ISOLATED FROM GSC) -->
  <!-- ========================================================================= -->
  <main id="portal-crm-view" style="background: #F4F6F4; min-height: 85vh; padding: 2.5rem 0 4rem;">
    <div class="container">

      <!-- TOP METRICS CARDS -->
      <div class="metrics-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        
        <!-- Metric 1: Real-time Active Users -->
        <div class="metric-card" style="background: white; border-radius: 12px; padding: 1.5rem; border: 1px solid #E5E7EB; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); position: relative; overflow: hidden;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #4B5563; letter-spacing: 0.05em;">Real-Time Active</span>
            <span style="background: rgba(0, 230, 118, 0.15); color: #059669; padding: 4px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
              Live <i class="fa-solid fa-bolt"></i>
            </span>
          </div>
          <div id="stat-active-users" style="font-size: 2.75rem; font-weight: 800; color: #0A1C16; font-family: 'Playfair Display', serif; line-height: 1;">
            {analytics.realtimeActiveUsers}
          </div>
          <p style="font-size: 0.75rem; color: #059669; margin-top: 0.5rem; font-weight: 600; display: flex; align-items: center; gap: 4px;">
            <i class="fa-solid fa-circle" style="font-size: 8px;"></i> Active in the last 2 minutes
          </p>
        </div>

        <!-- Metric 2: New Visitors Today -->
        <div class="metric-card" style="background: white; border-radius: 12px; padding: 1.5rem; border: 1px solid #E5E7EB; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #4B5563; letter-spacing: 0.05em;">New Visitors Today</span>
            <span style="background: #E0E7FF; color: #3730A3; padding: 4px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
              Today
            </span>
          </div>
          <div id="stat-today-visitors" style="font-size: 2.75rem; font-weight: 800; color: #1E40AF; font-family: 'Playfair Display', serif; line-height: 1;">
            {analytics.todayNewVisitors}
          </div>
          <p style="font-size: 0.75rem; color: #4B5563; margin-top: 0.5rem;">
            Real tracked daily unique sessions
          </p>
        </div>

        <!-- Metric 3: Total Visitors -->
        <div class="metric-card" style="background: white; border-radius: 12px; padding: 1.5rem; border: 1px solid #E5E7EB; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #4B5563; letter-spacing: 0.05em;">Total Visitors</span>
            <span style="background: #DCFCE7; color: #166534; padding: 4px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
              All Time
            </span>
          </div>
          <div id="stat-total-visitors" style="font-size: 2.75rem; font-weight: 800; color: #0A1C16; font-family: 'Playfair Display', serif; line-height: 1;">
            {analytics.totalVisitors}
          </div>
          <p style="font-size: 0.75rem; color: #059669; margin-top: 0.5rem; font-weight: 600;">
            {analytics.totalPageViews} total page impressions
          </p>
        </div>

        <!-- Metric 4: Average Duration of Stay -->
        <div class="metric-card" style="background: white; border-radius: 12px; padding: 1.5rem; border: 1px solid #E5E7EB; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #4B5563; letter-spacing: 0.05em;">Avg Duration of Stay</span>
            <span style="background: #FEF3C7; color: #92400E; padding: 4px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
              Engagement
            </span>
          </div>
          <div id="stat-avg-duration" style="font-size: 2.75rem; font-weight: 800; color: #D97706; font-family: 'Playfair Display', serif; line-height: 1;">
            {formatDuration(analytics.avgStayDurationSeconds)}
          </div>
          <p style="font-size: 0.75rem; color: #4B5563; margin-top: 0.5rem;">
            Real session dwell time
          </p>
        </div>

        <!-- Metric 5: Form Inquiries -->
        <div class="metric-card" style="background: white; border-radius: 12px; padding: 1.5rem; border: 1px solid #E5E7EB; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #4B5563; letter-spacing: 0.05em;">Form Inquiries</span>
            <span style="background: #F3E8FF; color: #6B21A8; padding: 4px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
              Pipeline
            </span>
          </div>
          <div style="font-size: 2.75rem; font-weight: 800; color: #7C3AED; font-family: 'Playfair Display', serif; line-height: 1;">
            {totalLeads}
          </div>
          <p style="font-size: 0.75rem; color: #D97706; margin-top: 0.5rem; font-weight: 600;">
            {newLeads} awaiting review
          </p>
        </div>

      </div>

      <!-- CRM TAB: TRAFFIC GRAPH -->
      <section id="tab-chart" class="crm-tab-panel" style="margin-bottom: 2.5rem;">
        <div style="background: white; border-radius: 16px; border: 1px solid #E5E7EB; padding: 1.75rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
          
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid #F3F4F6; padding-bottom: 1rem;">
            <div>
              <h3 style="font-size: 1.25rem; font-weight: 700; color: #0A1C16; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-chart-area" style="color: #059669;"></i> Real-Time & Historical Traffic Visualization
              </h3>
              <p style="font-size: 0.85rem; color: #6B7280; margin-top: 2px;">
                Analyze active users, unique visitors, page impressions, and dwell duration over flexible timeframes.
              </p>
            </div>

            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
              <!-- Metric Selector -->
              <div style="display: flex; background: #F3F4F6; border-radius: 8px; padding: 3px;">
                <button class="chart-metric-btn active" data-metric="visitors">Visitors</button>
                <button class="chart-metric-btn" data-metric="pageviews">Pageviews</button>
                <button class="chart-metric-btn" data-metric="activeUsers">Active Online</button>
                <button class="chart-metric-btn" data-metric="avgDuration">Stay Duration</button>
              </div>

              <!-- Timeframe Selector -->
              <div style="display: flex; background: #0A1C16; border-radius: 8px; padding: 3px;">
                <button class="chart-range-btn active" data-range="24h">24 Hours</button>
                <button class="chart-range-btn" data-range="7d">7 Days</button>
                <button class="chart-range-btn" data-range="30d">30 Days</button>
              </div>

              <a href="/api/admin/analytics/export?type=all" class="btn btn-sm btn-dark-outline" download style="border-radius: 8px; font-size: 0.8rem; padding: 0.4rem 0.8rem;">
                <i class="fa-solid fa-download"></i> Export Graph CSV
              </a>
            </div>
          </div>

          <!-- Canvas Container -->
          <div style="position: relative; height: 360px; width: 100%;">
            <canvas id="analyticsChart"></canvas>
          </div>
        </div>
      </section>

      <!-- CRM TAB: PAGE & SECTION DWELL -->
      <section id="tab-pages" class="crm-tab-panel" style="margin-bottom: 2.5rem;">
        <div style="background: white; border-radius: 16px; border: 1px solid #E5E7EB; padding: 1.75rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
          
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
            <div>
              <h3 style="font-size: 1.25rem; font-weight: 700; color: #0A1C16; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-stopwatch-20" style="color: #2563EB;"></i> Page & Section Dwell Time Insights
              </h3>
              <p style="font-size: 0.85rem; color: #6B7280; margin-top: 2px;">
                Discover which pages and specific sections keep prospective buyers and brokerages engaged longest.
              </p>
            </div>

            <div style="display: flex; gap: 0.75rem; align-items: center;">
              <input type="text" id="page-search-input" placeholder="Filter pages..." style="padding: 0.5rem 0.85rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" />
              <a href="/api/admin/analytics/export?type=pages" class="btn btn-sm btn-outline" download style="color: #0A1C16; border-color: #D1D5DB; font-size: 0.8rem; border-radius: 8px;">
                <i class="fa-solid fa-file-csv"></i> Export Pages CSV
              </a>
            </div>
          </div>

          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; min-width: 900px; font-size: 0.9rem;">
              <thead>
                <tr style="background: #F9FAFB; border-bottom: 2px solid #E5E7EB; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                  <th style="padding: 1rem; text-align: left;">Page / Path</th>
                  <th style="padding: 1rem; text-align: left;">Title / Description</th>
                  <th style="padding: 1rem; text-align: right;">Total Views</th>
                  <th style="padding: 1rem; text-align: right;">Unique Users</th>
                  <th style="padding: 1rem; text-align: left; min-width: 180px;">Avg Dwell Time</th>
                  <th style="padding: 1rem; text-align: left;">Top Engaged Section</th>
                  <th style="padding: 1rem; text-align: center;">Breakdown</th>
                </tr>
              </thead>
              <tbody id="pages-table-body">
                {analytics.pages.map((p) => {
                  const maxDur = 300;
                  const barWidth = p.avgDurationSeconds > 0 ? Math.min(100, Math.round((p.avgDurationSeconds / maxDur) * 100)) : 0;
                  return (
                    <tr style="border-bottom: 1px solid #F3F4F6;" class="page-row" data-search={`${p.page} ${p.title}`.toLowerCase()}>
                      <td style="padding: 1rem;">
                        <a href={p.page} target="_blank" style="font-weight: 700; color: #059669; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
