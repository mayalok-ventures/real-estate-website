            <div>
              <h3 style="font-size: 1.15rem; font-weight: 700; color: #111827; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-magnifying-glass" style="color: #2563EB;"></i> Top Search Queries & Keywords
              </h3>
              <p style="font-size: 0.8rem; color: #6B7280; margin-top: 2px;">
                Actual search terms entered into Google that displayed Sahyak in results.
              </p>
            </div>

            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <input type="text" id="gsc-query-search" placeholder="Search keywords..." style="padding: 0.45rem 0.8rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem; min-width: 220px;" />
              <a href="/api/admin/gsc/export?type=queries" class="btn btn-sm btn-outline" download style="color: #0A1C16; border-color: #D1D5DB; font-size: 0.8rem; border-radius: 8px;">
