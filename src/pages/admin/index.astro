---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getContactsWithCount } from '../../lib/db';
import { getRuntimeEnv } from '../../lib/env';
import { getAnalyticsSummary, formatDuration, COUNTRY_META } from '../../lib/analytics';
import { getSearchConsoleData } from '../../lib/googleSearchConsole';

const admin = (Astro.locals as any)?.admin;
if (!admin || !admin.email) {
  return Astro.redirect('/admin/login');
}

let env: any = {};
let contacts: any[] = [];
let initialPaginatedLeads: any = {
  contacts: [],
  total: 0,
  page: 1,
  limit: 25,
  totalPages: 1,
  hasNext: false,
  hasPrev: false,
  summary: { total: 0, new: 0, contacted: 0, qualified: 0, closed: 0, archived: 0 }
};
let analytics: any = {
  totalVisitors: 0,
  uniqueVisitors: 0,
  pageViews: 0,
  avgDwellTime: 0,
  bounceRate: 0,
  realtimeActiveUsers: 0,
  topPages: [],
  topReferrers: [],
  topCountries: [],
  deviceDistribution: {},
  hourlyTraffic: []
};
let gscData: any = {
  status: 'not_configured',
  isLive: false,
  statusMessage: 'Loading Google Search Console data...',
  siteUrl: 'https://sahyak.com',
  clientEmail: '',
  hasPrivateKey: false,
  isKeyFormatValid: false,
  startDate: new Date(Date.now() - 28 * 86400000).toISOString().split('T')[0],
  endDate: new Date().toISOString().split('T')[0],
  totalClicks: 0,
  totalImpressions: 0,
  avgCtr: 0,
  avgPosition: 0,
  topQueries: [],
  topPages: [],
  countries: [],
  devices: [],
  timeSeries: [],
  sitemaps: [],
  opportunities: [],
  lastFetchedAt: null,
  healthOverview: null,
  alerts: [],
  marketIntelligence: null,
  conversions: null,
  authorityNodes: [],
  productTruth: [],
  clusters: [],
  auditIssues: []
};

try {
  env = await getRuntimeEnv();
} catch (e) {
  console.warn('[Admin] Failed to load runtime env:', e);
}

try {
  initialPaginatedLeads = await getContactsWithCount(env?.DB, { page: 1, limit: 25 });
  contacts = initialPaginatedLeads.contacts;
} catch (e) {
  console.warn('[Admin] Failed to load contacts from DB:', e);
  contacts = [];
}

try {
  analytics = await getAnalyticsSummary(env?.DB, '24h');
} catch (e) {
  console.warn('[Admin] Failed to load analytics summary:', e);
}

try {
  gscData = await getSearchConsoleData(env || {}, { range: '28d' });
} catch (e: any) {
  console.error('[Admin] getSearchConsoleData caught in page:', e);
  gscData = {
    ...gscData,
    status: 'api_error',
    statusMessage: `Failed to load Search Console data: ${e?.message || String(e)}`
  };
}

// Authoritative pipeline stats across all leads in the database
const leadSummary = initialPaginatedLeads.summary;
const totalLeads = leadSummary.total;
const newLeads = leadSummary.new;
---

<Layout title="Executive Admin & Analytics Console - Sahyak CRM" description="Real-time website analytics, visitor traffic tracking, dwell time insights, and Google Search Console portal.">

  <!-- Font Awesome & Chart.js CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- TOP EXECUTIVE ADMIN HEADER -->
  <header class="admin-top-header" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0; padding: 0.75rem 0; position: sticky; top: 0; z-index: 900; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 4px 12px -2px rgba(15, 23, 42, 0.03);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; max-width: 1400px; margin: 0 auto; padding: 0 1.5rem;">
      
      <!-- Brand & Status Group -->
      <div style="display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
        <a href="/admin" style="display: flex; align-items: center; gap: 0.6rem; text-decoration: none;">
          <img src="/images/sahyak-logo.png" alt="Sahyak CRM" style="height: 28px; width: auto; object-fit: contain;" />
          <span style="font-weight: 700; font-size: 1.1rem; color: #0F172A; letter-spacing: -0.02em; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">Sahyak<span style="color: #059669;">.</span></span>
        </a>

        <span class="badge-pill" style="margin: 0; background: #F1F5F9; color: #334155; border: 1px solid #E2E8F0; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em;">
          Command Center
        </span>

        <div id="live-active-badge" style="background: #ECFDF5; border: 1px solid #A7F3D0; padding: 0.25rem 0.75rem; border-radius: 50px; font-size: 0.75rem; color: #059669; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 1px 2px rgba(5, 150, 105, 0.06);">
          <span style="width: 7px; height: 7px; border-radius: 50%; background: #10B981; box-shadow: 0 0 6px #10B981; display: inline-block; animation: pulse 2s infinite;"></span>
          <span id="badge-active-count">{analytics.realtimeActiveUsers}</span> Online Now
        </div>
      </div>

      <!-- Centered Portal Mode Switcher (Website CRM vs Search Console) -->
      <div class="portal-segmented-control" style="display: inline-flex; background: #F1F5F9; padding: 3px; border-radius: 12px; border: 1px solid #E2E8F0; box-shadow: inset 1px 1px 2px rgba(15, 23, 42, 0.04);">
        <button id="portal-switch-crm" class="portal-mode-btn active" data-portal="crm">
          <i class="fa-solid fa-chart-pie" style="color: #059669;"></i> Website CRM & Traffic
        </button>
        <button id="portal-switch-gsc" class="portal-mode-btn" data-portal="gsc">
          <i class="fa-brands fa-google" style="color: #4285F4;"></i> Search Console Central
        </button>
      </div>

      <!-- Operator, Export & Logout Controls -->
      <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 6px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 0.35rem 0.75rem; border-radius: 8px; font-size: 0.8rem; color: #64748B;">
          <i class="fa-regular fa-user" style="color: #059669; font-size: 0.75rem;"></i>
          <span style="color: #1E293B; font-weight: 600;">{admin.email}</span>
          <span style="background: #E2E8F0; color: #475569; font-size: 0.675rem; font-weight: 700; padding: 1px 5px; border-radius: 4px; text-transform: uppercase;">{admin.role}</span>
        </div>

        <div class="export-dropdown" style="position: relative;">
          <button id="export-menu-btn" class="btn btn-sm" style="background: #FFFFFF; color: #334155; border: 1px solid #CBD5E1; font-size: 0.8rem; padding: 0.45rem 0.85rem; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 0.45rem; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); font-weight: 600;">
            <i class="fa-solid fa-file-arrow-down" style="color: #059669;"></i> Export <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem; color: #94A3B8;"></i>
          </button>
          <div id="export-dropdown-menu" style="display: none; position: absolute; right: 0; top: 120%; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; min-width: 260px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12), -2px -2px 10px rgba(255, 255, 255, 0.95); z-index: 1000; overflow: hidden; padding: 0.35rem 0;">
            <div style="padding: 0.5rem 1rem 0.25rem; font-size: 0.68rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em;">Website Traffic Reports</div>
            <a href="/api/admin/analytics/export?type=all" class="export-link" download>
              <i class="fa-solid fa-chart-pie" style="color: #059669; width: 16px;"></i> Master Executive CSV
            </a>
            <a href="/api/admin/analytics/export?type=visitors" class="export-link" download>
              <i class="fa-solid fa-users" style="color: #2563EB; width: 16px;"></i> Visitor Session Logs (CSV)
            </a>
            <a href="/api/admin/analytics/export?type=pages" class="export-link" download>
              <i class="fa-solid fa-stopwatch" style="color: #D97706; width: 16px;"></i> Page & Section Dwell (CSV)
            </a>
            <a href="/api/admin/analytics/export?type=sources" class="export-link" download>
              <i class="fa-solid fa-share-nodes" style="color: #7C3AED; width: 16px;"></i> Traffic Sources & Sites (CSV)
            </a>
            <div style="border-top: 1px solid #F1F5F9; margin: 0.35rem 0;"></div>
            <div style="padding: 0.5rem 1rem 0.25rem; font-size: 0.68rem; font-weight: 700; color: #059669; text-transform: uppercase; letter-spacing: 0.05em;">Google Search Console</div>
            <a href="/api/admin/gsc/export?type=all" class="export-link" download>
              <i class="fa-brands fa-google" style="color: #4285F4; width: 16px;"></i> Master GSC Report (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=queries" class="export-link" download>
              <i class="fa-solid fa-magnifying-glass" style="color: #059669; width: 16px;"></i> Top Search Keywords (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=pages" class="export-link" download>
              <i class="fa-solid fa-file-lines" style="color: #2563EB; width: 16px;"></i> Ranking Landing Pages (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=countries" class="export-link" download>
              <i class="fa-solid fa-earth-americas" style="color: #D97706; width: 16px;"></i> Organic Countries (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=clusters" class="export-link" download>
              <i class="fa-solid fa-cubes-stacked" style="color: #7C3AED; width: 16px;"></i> Keyword Clusters (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=audit" class="export-link" download>
              <i class="fa-solid fa-shield-check" style="color: #10B981; width: 16px;"></i> Technical SEO Audit (CSV)
            </a>
            <a href="/api/admin/gsc/export?type=truth" class="export-link" download>
              <i class="fa-solid fa-scale-balanced" style="color: #3B82F6; width: 16px;"></i> Product Truth Audit (CSV)
            </a>
            <div style="border-top: 1px solid #F1F5F9; margin: 0.35rem 0;"></div>
            <a href="/api/admin/leads?format=csv" class="export-link" download>
              <i class="fa-solid fa-clipboard-list" style="color: #059669; width: 16px;"></i> Form Leads Data (CSV)
            </a>
          </div>
        </div>

        <button id="btn-admin-logout" type="button" class="btn btn-sm" style="background: #FEF2F2; color: #DC2626; border: 1px solid #FCA5A5; border-radius: 8px; padding: 0.45rem 0.85rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; transition: all 0.2s ease;">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </button>
      </div>

    </div>
  </header>

  <!-- SUB-NAVIGATION BAR (Contextual to active portal) -->
  <nav id="crm-tabs-bar" style="background: rgba(248, 250, 252, 0.95); backdrop-filter: blur(10px); border-bottom: 1px solid #E2E8F0; position: sticky; top: 57px; z-index: 850; padding: 0.45rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; gap: 1rem;">
      <div class="admin-tabs" style="display: flex; gap: 0.4rem; overflow-x: auto; padding: 2px 0;">
        <button class="crm-tab-btn active" data-tab="tab-overview">
          <i class="fa-solid fa-gauge-high"></i> Overview
        </button>
        <button class="crm-tab-btn" data-tab="tab-chart">
          <i class="fa-solid fa-chart-line"></i> Traffic Graph
        </button>
        <button class="crm-tab-btn" data-tab="tab-pages">
          <i class="fa-solid fa-clock"></i> Page & Section Dwell
        </button>
        <button class="crm-tab-btn" data-tab="tab-sources">
          <i class="fa-solid fa-bullhorn"></i> Traffic Sources & 1,000+ Sites
        </button>
        <button class="crm-tab-btn" data-tab="tab-geo">
          <i class="fa-solid fa-globe"></i> Location & Live Sessions
        </button>
        <button class="crm-tab-btn" data-tab="tab-leads">
          <i class="fa-solid fa-envelope-open-text"></i> Form Leads ({totalLeads})
        </button>
      </div>

      <!-- Quick indicator of active view -->
      <div id="portal-status-label" style="font-size: 0.78rem; color: #64748B; display: flex; align-items: center; gap: 6px; white-space: nowrap;">
        <i class="fa-solid fa-layer-group" style="color: #059669;"></i>
        <span>Viewing: <strong id="current-portal-title" style="color: #0F172A; font-weight: 600;">Website CRM & Traffic Hub</strong></span>
      </div>
    </div>
  </nav>

  <nav id="gsc-tabs-bar" style="display: none; background: rgba(248, 250, 252, 0.95); backdrop-filter: blur(10px); border-bottom: 1px solid #E2E8F0; position: sticky; top: 57px; z-index: 850; padding: 0.45rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; gap: 1rem;">
      <div class="admin-tabs" style="display: flex; gap: 0.35rem; overflow-x: auto; padding: 2px 0; scrollbar-width: thin;">
        <button class="gsc-tab-btn active" data-gsctab="gsc-tab-overview">
          <i class="fa-solid fa-heart-pulse" style="color: #059669;"></i> Overview & Health
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-perf">
          <i class="fa-solid fa-chart-line" style="color: #2563EB;"></i> Search Performance
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-opps">
          <i class="fa-solid fa-lightbulb" style="color: #D97706;"></i> Opportunities
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-alerts">
          <i class="fa-solid fa-bell" style="color: #059669;"></i> Alerts <span style="background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; border-radius: 10px; padding: 1px 6px; font-size: 0.68rem; font-weight: 700;">{gscData.alerts?.length || 5}</span>
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-market">
          <i class="fa-solid fa-crosshairs"></i> Market Intelligence
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-tools">
          <i class="fa-solid fa-screwdriver-wrench"></i> Interactive Tools
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-conversion">
          <i class="fa-solid fa-funnel-dollar" style="color: #059669;"></i> SEO Conversion
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-authority">
          <i class="fa-solid fa-diagram-project"></i> Topic Authority Graph
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-truth">
          <i class="fa-solid fa-scale-balanced" style="color: #3B82F6;"></i> Product Truth
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-clusters">
          <i class="fa-solid fa-cubes-stacked"></i> Clusters
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-keywords">
          <i class="fa-solid fa-magnifying-glass"></i> Keywords
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-pages">
          <i class="fa-solid fa-file-lines"></i> Pages
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-audit">
          <i class="fa-solid fa-shield-check" style="color: #059669;"></i> Audit Issues
        </button>
        <button class="gsc-tab-btn" data-gsctab="gsc-tab-sitemaps">
          <i class="fa-solid fa-sitemap"></i> Sitemaps
        </button>
      </div>
    </div>
  </nav>

  <!-- ========================================================================= -->
  <!-- MAIN PORTAL 1: WEBSITE CRM & TRAFFIC HUB (COMPLETELY ISOLATED FROM GSC) -->
  <!-- ========================================================================= -->
  <main id="portal-crm-view" style="background: #F8FAFC; min-height: 85vh; padding: 2rem 0 4rem;">
    <div class="container" style="max-width: 1400px; margin: 0 auto; padding: 0 1.5rem;">

      <!-- TOP METRICS CARDS -->
      <div class="metrics-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        
        <!-- Metric 1: Real-time Active Users -->
        <div class="metric-card" style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95); position: relative; overflow: hidden;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Real-Time Active</span>
            <span style="background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 3px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
              Live <i class="fa-solid fa-bolt" style="font-size: 0.65rem;"></i>
            </span>
          </div>
          <div id="stat-active-users" style="font-size: 2.25rem; font-weight: 700; color: #059669; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {analytics.realtimeActiveUsers}
          </div>
          <p style="font-size: 0.75rem; color: #059669; margin-top: 0.5rem; font-weight: 600; display: flex; align-items: center; gap: 5px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #10B981; display: inline-block;"></span> Active in the last 2 minutes
          </p>
        </div>

        <!-- Metric 2: New Visitors Today -->
        <div class="metric-card" style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">New Visitors Today</span>
            <span style="background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; padding: 3px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              Today
            </span>
          </div>
          <div id="stat-today-visitors" style="font-size: 2.25rem; font-weight: 700; color: #2563EB; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {analytics.todayNewVisitors}
          </div>
          <p style="font-size: 0.75rem; color: #64748B; margin-top: 0.5rem;">
            Real tracked daily unique sessions
          </p>
        </div>

        <!-- Metric 3: Total Visitors -->
        <div class="metric-card" style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Total Visitors</span>
            <span style="background: #F1F5F9; color: #334155; border: 1px solid #E2E8F0; padding: 3px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              All Time
            </span>
          </div>
          <div id="stat-total-visitors" style="font-size: 2.25rem; font-weight: 700; color: #0F172A; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {analytics.totalVisitors}
          </div>
          <p style="font-size: 0.75rem; color: #059669; margin-top: 0.5rem; font-weight: 600;">
            {analytics.totalPageViews} total page impressions
          </p>
        </div>

        <!-- Metric 4: Average Duration of Stay -->
        <div class="metric-card" style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Avg Duration of Stay</span>
            <span style="background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; padding: 3px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              Engagement
            </span>
          </div>
          <div id="stat-avg-duration" style="font-size: 2.25rem; font-weight: 700; color: #D97706; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {formatDuration(analytics.avgStayDurationSeconds)}
          </div>
          <p style="font-size: 0.75rem; color: #64748B; margin-top: 0.5rem;">
            Real session dwell time
          </p>
        </div>

        <!-- Metric 5: Form Inquiries -->
        <div class="metric-card" style="background: #FFFFFF; border-radius: 16px; padding: 1.35rem 1.5rem; border: 1px solid #E2E8F0; box-shadow: 0 1px 3px rgba(15,23,42,0.03), 0 8px 20px -4px rgba(15,23,42,0.03), -2px -2px 10px rgba(255,255,255,0.95);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748B; letter-spacing: 0.05em;">Form Inquiries</span>
            <span style="background: #FAF5FF; color: #7C3AED; border: 1px solid #E9D5FF; padding: 3px 8px; border-radius: 20px; font-size: 0.725rem; font-weight: 700;">
              Pipeline
            </span>
          </div>
          <div id="stat-total-leads" style="font-size: 2.25rem; font-weight: 700; color: #7C3AED; line-height: 1.1; font-variant-numeric: tabular-nums;">
            {totalLeads}
          </div>
          <p style="font-size: 0.75rem; color: #D97706; margin-top: 0.5rem; font-weight: 600;">
            <span id="stat-new-leads">{newLeads}</span> awaiting review
          </p>
        </div>

      </div>

