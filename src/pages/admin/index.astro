                        </a>
                      </td>
                      <td style="padding: 1rem; color: #4B5563; font-weight: 500;">
                        {p.title}
                      </td>
                      <td style="padding: 1rem; text-align: right; font-weight: 700; color: #111827;">
                        {p.totalViews.toLocaleString()}
                      </td>
                      <td style="padding: 1rem; text-align: right; color: #4B5563;">
                        {p.uniqueVisitors.toLocaleString()}
                      </td>
                      <td style="padding: 1rem;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                          <strong style="color: #0A1C16; font-size: 0.85rem;">{formatDuration(p.avgDurationSeconds)}</strong>
                          <span style="font-size: 0.75rem; color: #6B7280;">Bounce: {p.bounceRate}%</span>
                        </div>
                        <div style="width: 100%; height: 6px; background: #E5E7EB; border-radius: 4px; overflow: hidden;">
                          <div style={`width: ${barWidth}%; height: 100%; background: linear-gradient(90deg, #10B981, #059669); border-radius: 4px;`}></div>
                        </div>
                      </td>
                      <td style="padding: 1rem;">
                        <span style="background: rgba(74, 222, 128, 0.15); color: #065F46; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; display: inline-block;">
                          <i class="fa-solid fa-star" style="font-size: 0.7rem; color: #D97706; margin-right: 4px;"></i> {p.topSection}
