              let bg = '#FFFFFF';
              if (alert.severity === 'critical') {
                borderColor = '#FCA5A5'; iconColor = '#EF4444'; iconClass = 'fa-triangle-exclamation'; bg = '#FEF2F2';
              } else if (alert.severity === 'warning') {
                borderColor = '#FCD34D'; iconColor = '#F59E0B'; iconClass = 'fa-circle-exclamation'; bg = '#FFFBEB';
              } else if (alert.severity === 'info') {
                borderColor = '#BFDBFE'; iconColor = '#3B82F6'; iconClass = 'fa-circle-info'; bg = '#EFF6FF';
              } else {
                borderColor = '#A7F3D0'; iconColor = '#10B981'; iconClass = 'fa-circle-check'; bg = '#ECFDF5';
              }

              return (
                <div style={`background: ${bg}; border: 1px solid ${borderColor}; border-radius: 12px; padding: 1.15rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;`}>
