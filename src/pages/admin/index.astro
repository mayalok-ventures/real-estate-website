      </select>
    </div>

    <!-- SECTION 1: Original Prospect Message (Read-Only) -->
    <div style="margin-bottom: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #475569; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
        <i class="fa-solid fa-comment-dots" style="color: #2563EB;"></i> Original Prospect Message (Read-Only)
      </div>
      <div id="modal-prospect-message" style="background: #F8FAFC; padding: 1rem; border-radius: 10px; border: 1px solid #E2E8F0; font-size: 0.875rem; line-height: 1.5; color: #334155; white-space: pre-wrap; max-height: 140px; overflow-y: auto; box-shadow: inset 1px 1px 3px rgba(0,0,0,0.03);">
        <!-- Populated via JS -->
      </div>
    </div>

    <!-- SECTION 2: Internal Admin Notes (Editable & Persisted) -->
    <div style="margin-bottom: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #D97706; letter-spacing: 0.05em;">
          <i class="fa-solid fa-lock" style="font-size: 0.75rem;"></i> Confidential Admin Notes (Private)
        </div>
        <span id="modal-notes-char-count" style="font-size: 0.75rem; color: #94A3B8; font-variant-numeric: tabular-nums;">0 / 5,000</span>
      </div>
      <textarea id="modal-admin-notes" rows="5" maxlength="5000" placeholder="Add confidential notes about client requirements, property preferences, phone follow-up summary, site visit schedule..." style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 1px solid #CBD5E1; border-radius: 10px; font-size: 0.875rem; line-height: 1.5; font-family: inherit; resize: vertical; outline: none; background: #F8FAFC; box-shadow: inset 1px 1px 4px rgba(0,0,0,0.03); color: #0F172A;"></textarea>
      <div id="modal-save-feedback" style="min-height: 20px; margin-top: 6px; font-size: 0.8rem; font-weight: 600;"></div>
    </div>

    <!-- Modal Action Buttons -->
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-top: 1px solid #E2E8F0; padding-top: 1rem;">
      <button id="modal-cancel-btn" class="btn btn-sm btn-outline" style="border-radius: 8px; padding: 0.5rem 1.25rem; font-weight: 600; border: 1px solid #CBD5E1; color: #475569; background: white; cursor: pointer;">Cancel</button>
      <button id="modal-save-btn" class="btn btn-sm" style="background: #059669; color: white; border-radius: 8px; padding: 0.5rem 1.5rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: none; box-shadow: 0 2px 4px rgba(5,150,105,0.25);">
        <i class="fa-solid fa-floppy-disk"></i> Save Notes & Status
      </button>
    </div>
  </dialog>

  <!-- Real-time In-App Toast Container for New Lead Alerts -->
  <div id="admin-toast-container" style="position: fixed; top: 80px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; max-width: 380px; pointer-events: none;"></div>

  <!-- Pass Server Data safely to client script -->
  <script is:inline id="analytics-init-data" type="application/json" set:html={JSON.stringify(analytics.timeSeries)} />
  <script is:inline id="gsc-init-data" type="application/json" set:html={JSON.stringify(gscData.timeSeries)} />

  <!-- Client-side Interactive Dashboard Script -->
  <script is:inline>
    // ==========================================
    // PORTAL SWITCHER: CRM VS SEARCH CONSOLE
    // ==========================================
    const switchCrm = document.getElementById('portal-switch-crm');
    const switchGsc = document.getElementById('portal-switch-gsc');
    const portalCrmView = document.getElementById('portal-crm-view');
    const portalGscView = document.getElementById('portal-gsc-view');
    const crmTabsBar = document.getElementById('crm-tabs-bar');
    const gscTabsBar = document.getElementById('gsc-tabs-bar');
    const portalTitle = document.getElementById('current-portal-title');

    function setPortal(portal) {
      if (portal === 'gsc') {
        switchGsc.classList.add('active');
        switchCrm.classList.remove('active');
        portalCrmView.style.display = 'none';
        portalGscView.style.display = 'block';
        crmTabsBar.style.display = 'none';
        gscTabsBar.style.display = 'block';
        portalTitle.textContent = 'Google Search Console Central';

        // Ensure active GSC panel is visible
        const activeGscBtn = document.querySelector('.gsc-tab-btn.active');
        const targetId = activeGscBtn ? activeGscBtn.getAttribute('data-gsctab') : 'gsc-tab-overview';
        gscSubPanels.forEach(p => {
          p.style.display = (p.id === targetId) ? '' : 'none';
        });

        if (targetId === 'gsc-tab-perf') {
          setTimeout(() => renderGscChart(), 50);
        }
      } else {
        switchCrm.classList.add('active');
        switchGsc.classList.remove('active');
        portalCrmView.style.display = 'block';
        portalGscView.style.display = 'none';
        crmTabsBar.style.display = 'block';
        gscTabsBar.style.display = 'none';
        portalTitle.textContent = 'Website CRM & Traffic Hub';
      }
    }

    switchCrm?.addEventListener('click', () => setPortal('crm'));
    switchGsc?.addEventListener('click', () => setPortal('gsc'));

    // ==========================================
    // CRM SUB-TABS
    // ==========================================
    const crmTabBtns = document.querySelectorAll('.crm-tab-btn');
    const crmTabPanels = document.querySelectorAll('.crm-tab-panel');

    crmTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        crmTabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const targetId = btn.getAttribute('data-tab');
        if (targetId === 'tab-overview') {
          crmTabPanels.forEach(p => p.style.display = '');
        } else {
          crmTabPanels.forEach(p => {
            p.style.display = (p.id === targetId) ? '' : 'none';
          });
        }
      });
    });

    // ==========================================
    // GSC SUB-TABS
    // ==========================================
    const gscTabBtns = document.querySelectorAll('.gsc-tab-btn');
    const gscSubPanels = document.querySelectorAll('.gsc-sub-panel');

    gscTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        gscTabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const targetId = btn.getAttribute('data-gsctab');
        gscSubPanels.forEach(p => {
          p.style.display = (p.id === targetId) ? '' : 'none';
        });

        if (targetId === 'gsc-tab-perf') {
          setTimeout(() => renderGscChart(), 50);
        }
      });
    });

    // GSC Quick Navigation Shortcut Buttons
    document.querySelectorAll('.gsc-quick-jump-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        const tabBtn = document.querySelector(`.gsc-tab-btn[data-gsctab="${target}"]`);
        if (tabBtn) tabBtn.click();
      });
    });

    // GSC Keyword Search Instant Filter
    const querySearchInput = document.getElementById('gsc-query-search');
    querySearchInput?.addEventListener('input', () => {
      const q = querySearchInput.value.toLowerCase().trim();
      document.querySelectorAll('.gsc-query-row').forEach(row => {
        const rowQuery = row.getAttribute('data-query') || '';
        row.style.display = !q || rowQuery.includes(q) ? '' : 'none';
      });
    });

    // Interactive Robots.txt Tester
    const robotsInput = document.getElementById('robots-test-input');
    const robotsBtn = document.getElementById('robots-test-btn');
    const robotsOutput = document.getElementById('robots-test-output');

    function runRobotsTest(path) {
      if (!robotsOutput) return;
      const testPath = (path || robotsInput.value || '').trim();
      if (!testPath) return;

      robotsOutput.style.display = 'block';
      const isBlocked = testPath.startsWith('/admin') || testPath.startsWith('/api/admin');

      if (isBlocked) {
        robotsOutput.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px; color: #DC2626; font-weight: 700; font-size: 0.95rem;">
            <i class="fa-solid fa-shield-xmark" style="font-size: 1.2rem;"></i> DISALLOWED / QUARANTINED
          </div>
          <p style="font-size: 0.825rem; color: #4B5563; margin-top: 4px;">
            Path <code>${testPath}</code> matches rule <code>Disallow: /admin</code> or <code>Disallow: /api/admin</code>. Googlebot is strictly prohibited from crawling or indexing this URL.
          </p>
        `;
        robotsOutput.style.borderColor = '#FCA5A5';
        robotsOutput.style.background = '#FEF2F2';
      } else {
        robotsOutput.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px; color: #059669; font-weight: 700; font-size: 0.95rem;">
            <i class="fa-solid fa-circle-check" style="font-size: 1.2rem;"></i> ALLOWED / FULLY CRAWLABLE
          </div>
          <p style="font-size: 0.825rem; color: #4B5563; margin-top: 4px;">
            Path <code>${testPath}</code> matches rule <code>User-agent: * Allow: /</code>. Googlebot will discover, crawl, and index this public URL.
          </p>
        `;
        robotsOutput.style.borderColor = '#A7F3D0';
        robotsOutput.style.background = '#ECFDF5';
      }
    }

    robotsBtn?.addEventListener('click', () => runRobotsTest(robotsInput?.value));
    document.querySelectorAll('.robots-quick-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-path');
        if (robotsInput) robotsInput.value = p;
        runRobotsTest(p);
      });
    });

    // Live Google SERP Snippet Previewer
    const serpSelect = document.getElementById('serp-preview-page-select');
    const serpTitleInput = document.getElementById('serp-title-input');
    const serpDescInput = document.getElementById('serp-desc-input');
    const serpTitleCount = document.getElementById('serp-title-count');
    const serpDescCount = document.getElementById('serp-desc-count');
    const serpPreviewUrl = document.getElementById('serp-preview-url');
    const serpPreviewTitle = document.getElementById('serp-preview-title');
    const serpPreviewDesc = document.getElementById('serp-preview-desc');

    const serpPageData = {
      home: {
        url: 'https://sahyak.com',
        title: 'Sahyak CRM | Premier Real Estate CRM for Indian Brokers',
        desc: 'Transform your real estate sales with Sahyak CRM. Integrated WhatsApp follow-ups, site visit attendance, inventory tracking, and zero hidden fees.'
      },
      pricing: {
        url: 'https://sahyak.com/pricing',
        title: 'Simple, Transparent Real Estate CRM Pricing | Sahyak',
        desc: 'Explore affordable real estate CRM pricing starting at ₹499/mo. Tiered plans for solo brokers, growing agencies, and enterprise builders with zero hidden fees.'
      },
      features: {
        url: 'https://sahyak.com/features',
        title: 'Features Built Exclusively for Indian Real Estate | Sahyak',
        desc: 'Discover Sahyak features: WhatsApp 1-tap messaging, live site visit tracking, developer inventory control, broker team security, and automated follow-ups.'
      },
      resources: {
        url: 'https://sahyak.com/resources',
        title: 'Real Estate Sales Scripts, Playbooks & Tools | Sahyak',
        desc: 'Free downloadable real estate sales scripts, WhatsApp objection-handling templates, site visit checklists, and ROI calculators for property agents.'
      },
      contact: {
        url: 'https://sahyak.com/contact',
        title: 'Contact Sahyak CRM Support & Book a Live Demo',
        desc: 'Get in touch with the Sahyak real estate SaaS team. Book a personalized demo, ask pricing questions, or speak with our migration engineers today.'
      },
      security: {
        url: 'https://sahyak.com/security',
        title: 'Enterprise Bank-Grade Data Security & Compliance | Sahyak',
        desc: 'Your client records and property commissions are protected with Cloudflare TLS 1.3 encryption, tenant isolation, and strict Indian RERA compliance.'
      },
      about: {
        url: 'https://sahyak.com/about',
        title: 'About Sahyak - Empowering India\'s Real Estate Community',
        desc: 'Learn about Sahyak\'s mission to replace clunky legacy software with lightning-fast, broker-friendly real estate technology designed for Indian developers.'
      }
    };

    serpSelect?.addEventListener('change', () => {
      const p = serpPageData[serpSelect.value];
      if (p) {
        if (serpTitleInput) serpTitleInput.value = p.title;
        if (serpDescInput) serpDescInput.value = p.desc;
        if (serpPreviewUrl) serpPreviewUrl.textContent = p.url;
        if (serpPreviewTitle) serpPreviewTitle.textContent = p.title;
        if (serpPreviewDesc) serpPreviewDesc.textContent = p.desc;
        if (serpTitleCount) serpTitleCount.textContent = p.title.length;
        if (serpDescCount) serpDescCount.textContent = p.desc.length;
      }
    });

    serpTitleInput?.addEventListener('input', () => {
      if (serpPreviewTitle) serpPreviewTitle.textContent = serpTitleInput.value;
      if (serpTitleCount) serpTitleCount.textContent = serpTitleInput.value.length;
    });

    serpDescInput?.addEventListener('input', () => {
      if (serpPreviewDesc) serpPreviewDesc.textContent = serpDescInput.value;
      if (serpDescCount) serpDescCount.textContent = serpDescInput.value.length;
    });

    // Dropdown toggle
    const exportBtn = document.getElementById('export-menu-btn');
    const exportMenu = document.getElementById('export-dropdown-menu');
    if (exportBtn && exportMenu) {
      exportBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        exportMenu.style.display = exportMenu.style.display === 'block' ? 'none' : 'block';
      });
      document.addEventListener('click', () => {
        exportMenu.style.display = 'none';
      });
    }

    // ==========================================
    // WEBSITE ANALYTICS CHART
    // ==========================================
    let rawSeries = {};
    try {
      rawSeries = JSON.parse(document.getElementById('analytics-init-data').textContent || '{}');
    } catch(e) {
      rawSeries = {};
    }

    let currentRange = '24h';
    let currentMetric = 'visitors';
    let chartInstance = null;

    const ctx = document.getElementById('analyticsChart')?.getContext('2d');

    const metricConfig = {
      visitors: { label: 'Unique Visitors', color: '#10B981', bgColor: 'rgba(16, 185, 129, 0.15)', unit: ' visitors' },
      pageviews: { label: 'Total Pageviews', color: '#3B82F6', bgColor: 'rgba(59, 130, 246, 0.15)', unit: ' views' },
      activeUsers: { label: 'Active Users', color: '#059669', bgColor: 'rgba(5, 150, 105, 0.15)', unit: ' online' },
      avgDuration: { label: 'Stay Duration (Seconds)', color: '#F59E0B', bgColor: 'rgba(245, 158, 11, 0.15)', unit: 's' }
    };

    function renderChart() {
      if (!ctx) return;
      const series = rawSeries[currentRange] || { labels: [], visitors: [], pageviews: [], activeUsers: [], avgDuration: [] };
      const config = metricConfig[currentMetric];
      const dataValues = series[currentMetric] || [];

      if (chartInstance) {
        chartInstance.destroy();
      }

      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: series.labels,
          datasets: [{
            label: config.label,
            data: dataValues,
            borderColor: config.color,
            backgroundColor: config.bgColor,
            borderWidth: 3,
            fill: true,
            tension: 0.38,
            pointRadius: 4,
            pointHoverRadius: 7,
            pointBackgroundColor: config.color
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0F172A',
              titleColor: '#FFFFFF',
              bodyColor: '#34D399',
              padding: 12,
              cornerRadius: 10,
              callbacks: {
                label: function(context) { return ` ${context.parsed.y}${config.unit}`; }
              }
            }
          },
          scales: {
            x: { grid: { color: 'rgba(0, 0, 0, 0.04)' }, ticks: { color: '#6B7280', font: { size: 11 } } },
            y: { beginAtZero: true, grid: { color: 'rgba(0, 0, 0, 0.06)' }, ticks: { color: '#6B7280', font: { size: 11 } } }
          }
        }
      });
    }

    renderChart();

    // Metric Toggle Buttons
    document.querySelectorAll('.chart-metric-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chart-metric-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentMetric = btn.getAttribute('data-metric');
        renderChart();
      });
    });

    // Range Toggle Buttons
    document.querySelectorAll('.chart-range-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chart-range-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentRange = btn.getAttribute('data-range');
        renderChart();
      });
    });

    // Real-Time Polling every 12 seconds for real visitor sessions
    async function pollLiveAnalytics() {
      try {
        const res = await fetch('/api/admin/analytics?range=' + currentRange);
        if (res.ok) {
          const json = await res.json();
          if (json.success && json.data) {
            const d = json.data;
            document.getElementById('badge-active-count').textContent = d.realtimeActiveUsers;
            document.getElementById('stat-active-users').textContent = d.realtimeActiveUsers;
            document.getElementById('stat-today-visitors').textContent = d.todayNewVisitors;
            document.getElementById('stat-total-visitors').textContent = d.totalVisitors;
            if (d.timeSeries) {
              rawSeries = d.timeSeries;
              renderChart();
            }
          }
        }
      } catch(e) {}
    }
    setInterval(pollLiveAnalytics, 12000);

    // ==========================================
    // GOOGLE SEARCH CONSOLE CLIENT SCRIPT
    // ==========================================
    let gscSeries = [];
    try {
      gscSeries = JSON.parse(document.getElementById('gsc-init-data').textContent || '[]');
    } catch(e) {
      gscSeries = [];
    }

    let gscChartInstance = null;
    const gscCtx = document.getElementById('gscChart')?.getContext('2d');

    function renderGscChart(datesData) {
      if (!gscCtx) return;
      const dataToUse = datesData || gscSeries;

      const labels = dataToUse.map(d => d.date);
      const clicks = dataToUse.map(d => d.clicks);
      const impressions = dataToUse.map(d => d.impressions);

      if (gscChartInstance) {
        gscChartInstance.destroy();
      }

      gscChartInstance = new Chart(gscCtx, {
        type: 'line',
        data: {
          labels: labels.length > 0 ? labels : ['Past Days'],
          datasets: [
            {
              label: 'Clicks',
              data: clicks.length > 0 ? clicks : [0],
              borderColor: '#10B981',
              backgroundColor: 'rgba(16, 185, 129, 0.1)',
              borderWidth: 2.5,
              tension: 0.3,
              fill: true,
              yAxisID: 'yClicks'
            },
            {
              label: 'Impressions',
              data: impressions.length > 0 ? impressions : [0],
              borderColor: '#3B82F6',
              backgroundColor: 'rgba(59, 130, 246, 0.05)',
              borderWidth: 2,
              borderDash: [4, 4],
              tension: 0.3,
              fill: false,
              yAxisID: 'yImpressions'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0F172A',
              titleColor: '#FFFFFF',
              padding: 10,
              cornerRadius: 10
            }
          },
          scales: {
            x: { grid: { color: 'rgba(0, 0, 0, 0.04)' }, ticks: { color: '#6B7280', font: { size: 10 } } },
            yClicks: {
              type: 'linear',
              position: 'left',
              beginAtZero: true,
              title: { display: true, text: 'Clicks', color: '#10B981' },
              grid: { color: 'rgba(0, 0, 0, 0.04)' }
            },
            yImpressions: {
              type: 'linear',
              position: 'right',
              beginAtZero: true,
              title: { display: true, text: 'Impressions', color: '#3B82F6' },
              grid: { drawOnChartArea: false }
            }
          }
        }
      });
    }

    renderGscChart();

    // GSC Range Toggles
    document.querySelectorAll('.gsc-range-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        document.querySelectorAll('.gsc-range-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const range = btn.getAttribute('data-range');
        loadGscData(range);
      });
    });

    // GSC Refresh Button
    document.getElementById('gsc-refresh-btn')?.addEventListener('click', () => {
      const activeBtn = document.querySelector('.gsc-range-btn.active');
      const range = activeBtn ? activeBtn.getAttribute('data-range') : '28d';
      loadGscData(range, true);
    });

    async function loadGscData(range, forceRefresh = false) {
      const spinner = document.getElementById('gsc-spinner');
      if (spinner) spinner.classList.add('fa-spin');

      try {
        const url = `/api/admin/gsc/data?range=${range}${forceRefresh ? '&refresh=true' : ''}`;
        const res = await fetch(url);
        if (res.ok) {
          const json = await res.json();
          if (json.success && json.data) {
            const d = json.data;
            document.getElementById('gsc-stat-clicks').textContent = Number(d.totalClicks).toLocaleString();
            document.getElementById('gsc-stat-impressions').textContent = Number(d.totalImpressions).toLocaleString();
            document.getElementById('gsc-stat-ctr').textContent = `${d.avgCtr}%`;
            document.getElementById('gsc-stat-pos').textContent = `#${d.avgPosition}`;
            renderGscChart(d.timeSeries);
          }
        }
      } catch (e) {
      } finally {
        if (spinner) spinner.classList.remove('fa-spin');
      }
    }

    // GSC Query Search Filter
    const gscSearch = document.getElementById('gsc-query-search');
    gscSearch?.addEventListener('input', () => {
      const q = gscSearch.value.toLowerCase().trim();
      document.querySelectorAll('.gsc-query-row').forEach(row => {
        const query = row.getAttribute('data-query') || '';
        row.style.display = !q || query.includes(q) ? '' : 'none';
      });
    });

    // ==========================================
    // LIVE URL INSPECTION TOOL SCRIPT
    // ==========================================
    const inspectInput = document.getElementById('gsc-inspect-input');
    const inspectQuickSelect = document.getElementById('gsc-inspect-quick-select');
    const inspectBtn = document.getElementById('gsc-inspect-btn');
    const inspectBox = document.getElementById('gsc-inspect-result-box');

    inspectQuickSelect?.addEventListener('change', () => {
      inspectInput.value = inspectQuickSelect.value;
    });

    inspectBtn?.addEventListener('click', async () => {
      const urlToTest = inspectInput.value.trim() || '/';
      inspectBtn.disabled = true;
      inspectBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Inspecting...';

      try {
        const res = await fetch('/api/admin/gsc/inspect', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: urlToTest })
        });

        if (res.ok) {
          const json = await res.json();
          if (json.success && json.data) {
            const r = json.data;
            let badgeBg = '#F3F4F6';
            let badgeColor = '#374151';
            let verdictLabel = r.verdict;

            if (r.verdict === 'INDEXED') {
              badgeBg = 'rgba(16, 185, 129, 0.15)';
              badgeColor = '#059669';
              verdictLabel = 'Google Indexed (Official API)';
            } else if (r.verdict === 'HTTP_ACCESSIBLE') {
              badgeBg = 'rgba(59, 130, 246, 0.15)';
              badgeColor = '#2563EB';
              verdictLabel = 'HTTP 200 Accessible (Live Page Check)';
            } else if (r.verdict === 'NOINDEX_DETECTED') {
              badgeBg = '#FEF3C7';
              badgeColor = '#D97706';
              verdictLabel = 'Noindex Detected (Blocked from Search)';
            } else {
              badgeBg = '#FEE2E2';
              badgeColor = '#DC2626';
              verdictLabel = `Error: ${r.verdict}`;
            }

            inspectBox.style.display = 'block';
            inspectBox.innerHTML = `
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                <div>
                  <span style="background: ${badgeBg}; color: ${badgeColor}; padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 5px;">
                    <i class="fa-solid ${r.verdict === 'INDEXED' || r.verdict === 'HTTP_ACCESSIBLE' ? 'fa-circle-check' : 'fa-triangle-exclamation'}"></i> Verdict: ${verdictLabel}
                  </span>
                  <h4 style="font-size: 1.1rem; font-weight: 700; color: #111827; margin-top: 6px; word-break: break-all;">
                    ${r.url}
                  </h4>
                </div>
                <span style="font-size: 0.75rem; color: #6B7280;">Inspected: ${new Date(r.inspectedAt).toLocaleTimeString()}</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; font-size: 0.85rem;">
                <div style="background: white; border: 1px solid #E5E7EB; padding: 0.75rem; border-radius: 8px;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">HTTP Status</span>
                  <div style="font-weight: 700; color: ${r.httpStatus === 200 ? '#059669' : '#DC2626'}; margin-top: 2px;">
                    ${r.httpStatus || 0} ${r.httpStatus === 200 ? 'OK' : ''}
                  </div>
                </div>
                <div style="background: white; border: 1px solid #E5E7EB; padding: 0.75rem; border-radius: 8px;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">Robots Meta Tag</span>
                  <div style="font-weight: 600; color: #111827; margin-top: 2px;">
                    ${r.metaRobots}
                  </div>
                </div>
                <div style="background: white; border: 1px solid #E5E7EB; padding: 0.75rem; border-radius: 8px;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">Sitemap Inclusion</span>
                  <div style="font-weight: 700; color: #059669; margin-top: 2px;">
                    ${r.isSitemapIncluded ? '✓ In /sitemap-index.xml' : '✗ Excluded'}
                  </div>
                </div>
                <div style="background: white; border: 1px solid #E5E7EB; padding: 0.75rem; border-radius: 8px;">
                  <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">Canonical URL</span>
                  <div style="font-weight: 600; color: #059669; margin-top: 2px; font-size: 0.75rem; word-break: break-all;">
                    ${r.canonicalUrl}
                  </div>
                </div>
              </div>

              <div style="background: white; border: 1px solid #E5E7EB; padding: 0.75rem; border-radius: 8px; margin-top: 0.75rem; font-size: 0.85rem;">
                <span style="font-size: 0.7rem; color: #6B7280; font-weight: 700; text-transform: uppercase;">HTML Title Tag</span>
                <div style="font-weight: 600; color: #111827; margin-top: 2px;">${r.title}</div>
              </div>

              <div style="background: ${r.inspectionSource === 'google_api' ? '#ECFDF5' : '#FFFBEB'}; border: 1px solid ${r.inspectionSource === 'google_api' ? '#A7F3D0' : '#FDE68A'}; padding: 0.75rem 1rem; border-radius: 8px; margin-top: 0.75rem; font-size: 0.8rem; color: ${r.inspectionSource === 'google_api' ? '#065F46' : '#92400E'}; line-height: 1.4;">
                <strong>Source:</strong> ${r.inspectionSource === 'google_api' ? 'Official Google Search Console URL Inspection API' : 'Live Page HTTP Validator'} &bull; ${r.inspectionMessage || ''}
              </div>
            `;
          }
        }
      } catch (err) {
        alert('Inspection request failed.');
      } finally {
        inspectBtn.disabled = false;
        inspectBtn.innerHTML = '<i class="fa-solid fa-search"></i> Inspect URL';
      }
    });

    // Section Breakdown Modal Logic
    const secDialog = document.getElementById('section-breakdown-dialog');
    const secModalTitle = document.getElementById('sec-modal-title');
    const secModalSubtitle = document.getElementById('sec-modal-subtitle');
    const secModalContent = document.getElementById('sec-modal-content');

    document.querySelectorAll('.view-sections-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const page = btn.getAttribute('data-page');
        const title = btn.getAttribute('data-title');
        const sections = JSON.parse(btn.getAttribute('data-sections') || '[]');

        secModalTitle.textContent = `Sections Dwell: ${page}`;
        secModalSubtitle.textContent = title;
        secModalContent.innerHTML = '';

        if (!sections || sections.length === 0) {
          secModalContent.innerHTML = '<div style="text-align: center; padding: 2rem; color: #6B7280; font-size: 0.9rem;">No section engagement observations recorded for this page yet.</div>';
        } else {
          sections.forEach(s => {
            const row = document.createElement('div');
            row.style.background = '#F9FAFB';
            row.style.padding = '0.85rem 1rem';
            row.style.borderRadius = '8px';
            row.style.border = '1px solid #E5E7EB';
            const statText = s.avgSeconds > 0
              ? `${s.avgSeconds}s avg (${s.viewPercent}%)`
              : `<span style="color: #9CA3AF; font-weight: 500; font-size: 0.8rem;">No observations</span>`;
            const barWidth = s.avgSeconds > 0 ? s.viewPercent : 0;
            const barColor = s.avgSeconds > 0 ? '#10B981' : '#E5E7EB';
            row.innerHTML = `
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <strong style="color: #111827; font-size: 0.9rem;">${s.label}</strong>
                <span style="font-weight: 700; color: ${s.avgSeconds > 0 ? '#059669' : '#6B7280'}; font-size: 0.85rem;">${statText}</span>
              </div>
              <div style="width: 100%; height: 6px; background: #E5E7EB; border-radius: 4px; overflow: hidden;">
                <div style="width: ${barWidth}%; height: 100%; background: ${barColor}; border-radius: 4px;"></div>
              </div>
            `;
            secModalContent.appendChild(row);
          });
        }

        secDialog.showModal();
      });
    });

    document.getElementById('close-sec-modal-btn')?.addEventListener('click', () => secDialog.close());
    document.getElementById('close-sec-btn-bottom')?.addEventListener('click', () => secDialog.close());

    // Page Search Filter
    const pageSearch = document.getElementById('page-search-input');
    pageSearch?.addEventListener('input', () => {
      const q = pageSearch.value.toLowerCase().trim();
      document.querySelectorAll('.page-row').forEach(row => {
        const s = row.getAttribute('data-search') || '';
        row.style.display = !q || s.includes(q) ? '' : 'none';
      });
    });

    // Traffic Source Search Filter (Supports 1,000+ Domains)
    const sourceSearch = document.getElementById('source-search-input');
    sourceSearch?.addEventListener('input', () => {
      const q = sourceSearch.value.toLowerCase().trim();
      document.querySelectorAll('.domain-row').forEach(row => {
        const s = row.getAttribute('data-search') || '';
        row.style.display = !q || s.includes(q) ? '' : 'none';
      });
    });

    // Geolocation Filter
    const geoFilter = document.getElementById('geo-country-filter');
    const geoSearch = document.getElementById('geo-search-input');

    function filterGeo() {
      const country = geoFilter.value;
      const q = (geoSearch.value || '').toLowerCase().trim();

      document.querySelectorAll('.geo-row').forEach(row => {
        const rCountry = row.getAttribute('data-country') || '';
        const rSearch = row.getAttribute('data-search') || '';

        const matchCountry = country === 'all' || rCountry === country;
        const matchSearch = !q || rSearch.includes(q);

        row.style.display = (matchCountry && matchSearch) ? '' : 'none';
      });
    }

    geoFilter?.addEventListener('change', filterGeo);
    geoSearch?.addEventListener('input', filterGeo);

    // ========================================================
    // PHASE 3: LEADS PAGINATION, NOTES EDITOR, KPIS & POLLING
    // ========================================================
    let currentLeadPage = 1;
    let currentLeadLimit = 25;
    let currentLeadStatus = 'all';
    let currentLeadSearch = '';
    let latestKnownLeadId = 0;
    const knownLeadIds = new Set();
    let isLeadPolling = false;

    // DOM Elements
    const searchInput = document.getElementById('admin-search-input');
    const statusFilter = document.getElementById('admin-status-filter');
    const leadsTableBody = document.getElementById('leads-table-body');
    const leadsPaginationBar = document.getElementById('leads-pagination-bar');
    const paginationStart = document.getElementById('pagination-showing-start');
    const paginationEnd = document.getElementById('pagination-showing-end');
    const paginationTotal = document.getElementById('pagination-total-records');
    const paginationPageInd = document.getElementById('pagination-page-indicator');
    const paginationPrevBtn = document.getElementById('pagination-prev-btn');
    const paginationNextBtn = document.getElementById('pagination-next-btn');
    const paginationLimitSelect = document.getElementById('pagination-limit-select');
    const exportCsvBtn = document.getElementById('export-leads-csv-btn');
    const syncIndicator = document.getElementById('leads-sync-indicator');

    // Modal Elements
    const leadNotesModal = document.getElementById('lead-notes-modal');
    const modalLeadId = document.getElementById('modal-lead-id');
    const modalLeadName = document.getElementById('modal-lead-name');
    const modalLeadMeta = document.getElementById('modal-lead-meta');
    const modalLeadStatus = document.getElementById('modal-lead-status');
    const modalProspectMsg = document.getElementById('modal-prospect-message');
    const modalAdminNotes = document.getElementById('modal-admin-notes');
    const modalNotesCount = document.getElementById('modal-notes-char-count');
    const modalSaveFeedback = document.getElementById('modal-save-feedback');
    const modalSaveBtn = document.getElementById('modal-save-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalCloseX = document.getElementById('modal-close-x');
    const toastContainer = document.getElementById('admin-toast-container');

    let currentEditingLead = null;

    // Utility: Safe HTML Escape
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Populate initially known lead IDs
    document.querySelectorAll('.lead-row').forEach(row => {
      const id = parseInt(row.getAttribute('data-id') || '0', 10);
      if (id > 0) {
        knownLeadIds.add(id);
        if (id > latestKnownLeadId) latestKnownLeadId = id;
      }
    });

    // Update KPI counters across dashboard
    function updateLeadKpis(summary) {
      if (!summary) return;
      const statTotal = document.getElementById('stat-total-leads');
      const statNew = document.getElementById('stat-new-leads');
      if (statTotal && summary.total !== undefined) statTotal.textContent = String(summary.total);
      if (statNew && summary.new !== undefined) statNew.textContent = String(summary.new);

      const pillTotal = document.getElementById('pill-total-leads');
      const pillNew = document.getElementById('pill-new-leads');
      const pillContacted = document.getElementById('pill-contacted-leads');
      const pillQualified = document.getElementById('pill-qualified-leads');
      const pillClosed = document.getElementById('pill-closed-leads');
      const pillArchived = document.getElementById('pill-archived-leads');

      if (pillTotal && summary.total !== undefined) pillTotal.textContent = String(summary.total);
      if (pillNew && summary.new !== undefined) pillNew.textContent = String(summary.new);
      if (pillContacted && summary.contacted !== undefined) pillContacted.textContent = String(summary.contacted);
      if (pillQualified && summary.qualified !== undefined) pillQualified.textContent = String(summary.qualified);
      if (pillClosed && summary.closed !== undefined) pillClosed.textContent = String(summary.closed);
      if (pillArchived && summary.archived !== undefined) pillArchived.textContent = String(summary.archived);
    }

    // Build lead table row HTML
    function buildLeadRowHtml(c) {
      const dateStr = c.created_at ? new Date(c.created_at).toLocaleDateString() : 'Today';
      const cleanPhone = (c.phone || '').replace(/[^0-9]/g, '');
      const hasNote = Boolean(c.admin_notes && c.admin_notes.trim().length > 0);

      return `
        <tr style="border-bottom: 1px solid #F1F5F9;" class="lead-row" data-id="${c.id}" data-status="${escapeHtml(c.status)}" data-notes="${escapeHtml(c.admin_notes || '')}" data-message="${escapeHtml(c.message || '')}" data-name="${escapeHtml(c.name)}" data-email="${escapeHtml(c.email)}" data-phone="${escapeHtml(c.phone)}" data-company="${escapeHtml(c.company || '')}" data-type="${escapeHtml(c.inquiry_type)}" data-created="${escapeHtml(c.created_at || '')}">
          <td style="padding: 1rem;">
            <strong style="color: #0F172A; font-variant-numeric: tabular-nums;">#${c.id}</strong>
            <div style="font-size: 0.75rem; color: #64748B;">${dateStr}</div>
          </td>
          <td style="padding: 1rem;">
            <strong style="color: #0F172A; display: block;">${escapeHtml(c.name)}</strong>
            <span style="font-size: 0.8rem; color: #64748B;">${escapeHtml(c.email)}</span>
          </td>
          <td style="padding: 1rem;">
            <a href="tel:${escapeHtml(c.phone)}" style="font-weight: 600; color: #0F172A; display: block; text-decoration: none;">${escapeHtml(c.phone)}</a>
            <a href="https://wa.me/${cleanPhone}" target="_blank" rel="noopener noreferrer" style="font-size: 0.75rem; color: #059669; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
              <i class="fa-brands fa-whatsapp"></i> WhatsApp Chat
            </a>
          </td>
          <td style="padding: 1rem;">
            <span style="background: #F3F4F6; padding: 3px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600; text-transform: capitalize; color: #374151;">
              ${escapeHtml(c.inquiry_type)}
            </span>
          </td>
          <td style="padding: 1rem; color: #4B5563;">
            ${escapeHtml(c.company || 'Individual Broker')}
          </td>
          <td style="padding: 1rem;">
            <select class="status-selector" data-id="${c.id}" style="padding: 0.4rem 0.6rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; border: 1px solid #D1D5DB; background: white;">
              <option value="new" ${c.status === 'new' ? 'selected' : ''}>New</option>
              <option value="contacted" ${c.status === 'contacted' ? 'selected' : ''}>Contacted</option>
              <option value="qualified" ${c.status === 'qualified' ? 'selected' : ''}>Qualified</option>
              <option value="closed" ${c.status === 'closed' ? 'selected' : ''}>Closed Deal</option>
              <option value="archived" ${c.status === 'archived' ? 'selected' : ''}>Archived</option>
            </select>
          </td>
          <td style="padding: 1rem; text-align: center;">
            <button class="btn btn-sm btn-dark-outline manage-lead-btn" data-id="${c.id}" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 5px;">
              <i class="fa-solid fa-pen-to-square"></i> Notes & Details
            </button>
            ${hasNote ? `
              <div style="font-size: 0.7rem; color: #D97706; margin-top: 3px; display: flex; align-items: center; justify-content: center; gap: 4px;">
                <i class="fa-solid fa-note-sticky"></i> Note attached
              </div>` : ''}
          </td>
        </tr>
      `;
    }

    // Attach row event listeners (status dropdown + notes button)
    function attachRowEventListeners() {
      // Status selector change
      document.querySelectorAll('.status-selector').forEach(sel => {
        sel.onchange = async () => {
          const id = sel.getAttribute('data-id');
          const newStatus = sel.value;
          sel.disabled = true;

          try {
            const res = await fetch('/api/admin/leads', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, status: newStatus })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              const parentRow = sel.closest('.lead-row');
              if (parentRow) parentRow.setAttribute('data-status', newStatus);
              if (data.summary) updateLeadKpis(data.summary);
            } else {
              alert(data.message || 'Failed to update status.');
              // Revert selection
              const parentRow = sel.closest('.lead-row');
              if (parentRow) sel.value = parentRow.getAttribute('data-status') || 'new';
            }
          } catch {
            alert('Network error while updating lead status.');
          } finally {
            sel.disabled = false;
          }
        };
      });

      // Manage Notes & Details button
      document.querySelectorAll('.manage-lead-btn').forEach(btn => {
        btn.onclick = () => {
          const row = btn.closest('.lead-row');
          if (!row) return;

          currentEditingLead = {
            id: row.getAttribute('data-id'),
            name: row.getAttribute('data-name'),
            email: row.getAttribute('data-email'),
            phone: row.getAttribute('data-phone'),
            company: row.getAttribute('data-company'),
            inquiry_type: row.getAttribute('data-type'),
            created_at: row.getAttribute('data-created'),
            status: row.getAttribute('data-status') || 'new',
            message: row.getAttribute('data-message') || '',
            admin_notes: row.getAttribute('data-notes') || ''
          };

          modalLeadId.textContent = `#${currentEditingLead.id}`;
          modalLeadName.textContent = currentEditingLead.name || 'Prospect';
          modalLeadMeta.innerHTML = `
            <span><i class="fa-regular fa-envelope"></i> ${escapeHtml(currentEditingLead.email)}</span>
            <span><i class="fa-solid fa-phone"></i> ${escapeHtml(currentEditingLead.phone)}</span>
            ${currentEditingLead.company ? `<span><i class="fa-regular fa-building"></i> ${escapeHtml(currentEditingLead.company)}</span>` : ''}
            <span><i class="fa-regular fa-calendar"></i> ${currentEditingLead.created_at ? new Date(currentEditingLead.created_at).toLocaleDateString() : 'Today'}</span>
          `;

          modalLeadStatus.value = currentEditingLead.status;
          modalProspectMsg.textContent = currentEditingLead.message || 'No additional message left by prospect.';
          modalAdminNotes.value = currentEditingLead.admin_notes || '';
          modalNotesCount.textContent = `${modalAdminNotes.value.length} / 5,000`;
          modalSaveFeedback.innerHTML = '';
          modalSaveBtn.disabled = false;

          leadNotesModal.showModal();
        };
      });
    }

    // Server-side fetch leads with pagination, filters, and search
    async function fetchLeads(page = 1) {
      currentLeadPage = page;
      const params = new URLSearchParams({
        page: String(currentLeadPage),
        limit: String(currentLeadLimit),
        status: currentLeadStatus,
        search: currentLeadSearch
      });

      // Update CSV download link
      if (exportCsvBtn) {
        exportCsvBtn.href = `/api/admin/leads?format=csv&status=${currentLeadStatus}&search=${encodeURIComponent(currentLeadSearch)}`;
      }

      leadsTableBody.innerHTML = `
        <tr>
          <td colspan="7" style="padding: 2.5rem 1rem; text-align: center; color: #6B7280;">
            <i class="fa-solid fa-spinner fa-spin" style="font-size: 1.5rem; color: #059669; margin-bottom: 0.5rem; display: block;"></i>
            Loading inquiries from database...
          </td>
        </tr>
      `;

      try {
        const res = await fetch(`/api/admin/leads?${params.toString()}`);
        if (!res.ok) throw new Error('Failed to load leads');
        const data = await res.json();

        if (data.success) {
          const list = data.contacts || [];
          if (list.length === 0) {
            leadsTableBody.innerHTML = `
              <tr>
                <td colspan="7" style="padding: 3rem 1rem; text-align: center; color: #6B7280;">
                  <div style="font-size: 2rem; margin-bottom: 0.5rem; color: #D1D5DB;"><i class="fa-solid fa-inbox"></i></div>
                  <div style="font-weight: 700; color: #111827; font-size: 1rem;">No Matching Inquiries Found</div>
                  <p style="font-size: 0.85rem; margin-top: 0.25rem; color: #9CA3AF;">Try clearing your search query or selecting a different status filter.</p>
                </td>
              </tr>
            `;
          } else {
            leadsTableBody.innerHTML = list.map(buildLeadRowHtml).join('');
            // Track known IDs
            list.forEach(c => {
              if (c.id) {
                knownLeadIds.add(c.id);
                if (c.id > latestKnownLeadId) latestKnownLeadId = c.id;
              }
            });
            attachRowEventListeners();
          }

          // Update pagination controls
          const p = data.pagination || {};
          const total = p.total || 0;
          const start = total === 0 ? 0 : (p.page - 1) * p.limit + 1;
          const end = Math.min(total, p.page * p.limit);

          if (paginationStart) paginationStart.textContent = String(start);
          if (paginationEnd) paginationEnd.textContent = String(end);
          if (paginationTotal) paginationTotal.textContent = String(total);
          if (paginationPageInd) paginationPageInd.textContent = `Page ${p.page || 1} of ${p.totalPages || 1}`;

          if (paginationPrevBtn) paginationPrevBtn.disabled = !p.hasPrev;
          if (paginationNextBtn) paginationNextBtn.disabled = !p.hasNext;

          // Update KPI metrics
          if (data.summary) {
            updateLeadKpis(data.summary);
          }
        }
      } catch (err) {
        leadsTableBody.innerHTML = `
          <tr>
            <td colspan="7" style="padding: 2.5rem 1rem; text-align: center; color: #DC2626;">
              <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.5rem; margin-bottom: 0.5rem; display: block;"></i>
              Failed to load inquiries from server. Please check database connectivity.
            </td>
          </tr>
        `;
      }
    }

    // Debounced search
    let searchTimeout = null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentLeadSearch = (searchInput.value || '').trim();
          fetchLeads(1);
        }, 300);
      });
    }

    // Status filter dropdown
    if (statusFilter) {
      statusFilter.addEventListener('change', () => {
        currentLeadStatus = statusFilter.value;
        // Sync status pill active state
        document.querySelectorAll('.lead-pill-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-status') === currentLeadStatus);
          btn.style.background = btn.getAttribute('data-status') === currentLeadStatus ? '#0F172A' : '#F8FAFC';
          btn.style.color = btn.getAttribute('data-status') === currentLeadStatus ? 'white' : '#475569';
          btn.style.borderColor = btn.getAttribute('data-status') === currentLeadStatus ? '#0F172A' : '#E2E8F0';
        });
        fetchLeads(1);
      });
    }

    // Pipeline status pills
    document.querySelectorAll('.lead-pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetStatus = btn.getAttribute('data-status') || 'all';
        currentLeadStatus = targetStatus;
        if (statusFilter) statusFilter.value = targetStatus;

        document.querySelectorAll('.lead-pill-btn').forEach(b => {
          const isActive = b.getAttribute('data-status') === targetStatus;
          b.classList.toggle('active', isActive);
          b.style.background = isActive ? '#0F172A' : '#F8FAFC';
          b.style.color = isActive ? 'white' : '#475569';
          b.style.borderColor = isActive ? '#0F172A' : '#E2E8F0';
        });

        fetchLeads(1);
      });
    });

    // Pagination limit selector
    if (paginationLimitSelect) {
      paginationLimitSelect.addEventListener('change', () => {
        currentLeadLimit = parseInt(paginationLimitSelect.value, 10) || 25;
        fetchLeads(1);
      });
    }

    // Prev / Next button clicks
    if (paginationPrevBtn) {
      paginationPrevBtn.addEventListener('click', () => {
        if (currentLeadPage > 1) fetchLeads(currentLeadPage - 1);
      });
    }

    if (paginationNextBtn) {
      paginationNextBtn.addEventListener('click', () => {
        fetchLeads(currentLeadPage + 1);
      });
    }

    // Notes character counter
    if (modalAdminNotes) {
      modalAdminNotes.addEventListener('input', () => {
        modalNotesCount.textContent = `${modalAdminNotes.value.length} / 5,000`;
      });
    }

    // Save notes and status
    if (modalSaveBtn) {
      modalSaveBtn.addEventListener('click', async () => {
        if (!currentEditingLead) return;
        const id = currentEditingLead.id;
        const newStatus = modalLeadStatus.value;
        const newNotes = modalAdminNotes.value;

        modalSaveBtn.disabled = true;
        modalSaveFeedback.innerHTML = `<span style="color: #4B5563;"><i class="fa-solid fa-spinner fa-spin"></i> Persisting to Cloudflare D1...</span>`;

        try {
          const res = await fetch('/api/admin/leads', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: newStatus, admin_notes: newNotes })
          });
          const data = await res.json();

          if (res.ok && data.success) {
            modalSaveFeedback.innerHTML = `<span style="color: #059669;"><i class="fa-solid fa-check"></i> Changes saved successfully!</span>`;

            // Update row in DOM if currently rendered
            const row = document.querySelector(`.lead-row[data-id="${id}"]`);
            if (row) {
              row.setAttribute('data-status', newStatus);
              row.setAttribute('data-notes', newNotes);
              const sel = row.querySelector('.status-selector');
              if (sel) sel.value = newStatus;

              // Update or append note attached icon
              const actionsTd = row.querySelector('td:last-child');
              if (actionsTd) {
                let noteInd = actionsTd.querySelector('.note-snippet-attached');
                if (newNotes.trim().length > 0) {
                  if (!noteInd) {
                    const div = document.createElement('div');
                    div.className = 'note-snippet-attached';
                    div.style.cssText = 'font-size: 0.7rem; color: #D97706; margin-top: 3px; display: flex; align-items: center; justify-content: center; gap: 4px;';
                    div.innerHTML = `<i class="fa-solid fa-note-sticky"></i> Note attached`;
                    actionsTd.appendChild(div);
                  }
                } else if (noteInd) {
                  noteInd.remove();
                }
              }
            }

            // Update KPIs with fresh authoritative server summary
            if (data.summary) {
              updateLeadKpis(data.summary);
            }

            setTimeout(() => {
              leadNotesModal.close();
              modalSaveFeedback.innerHTML = '';
            }, 600);
          } else {
            modalSaveFeedback.innerHTML = `<span style="color: #DC2626;"><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(data.message || 'Save failed.')}</span>`;
            modalSaveBtn.disabled = false;
          }
        } catch {
          modalSaveFeedback.innerHTML = `<span style="color: #DC2626;"><i class="fa-solid fa-triangle-exclamation"></i> Network error while persisting notes.</span>`;
          modalSaveBtn.disabled = false;
        }
      });
    }

    if (modalCancelBtn) modalCancelBtn.addEventListener('click', () => leadNotesModal.close());
    if (modalCloseX) modalCloseX.addEventListener('click', () => leadNotesModal.close());

    // In-App Toast notification for newly arrived leads
    function showNewLeadToast(lead) {
      if (!toastContainer) return;
      const toast = document.createElement('div');
      toast.style.cssText = 'background: #FFFFFF; color: #0F172A; border: 1px solid #A7F3D0; border-radius: 14px; padding: 1rem 1.25rem; box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.15), 0 0 15px rgba(16, 185, 129, 0.15), -2px -2px 10px rgba(255, 255, 255, 0.95); pointer-events: auto; animation: pulse 0.3s ease; display: flex; flex-direction: column; gap: 6px; font-family: var(--admin-font);';
      toast.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #059669; text-transform: uppercase; display: flex; align-items: center; gap: 6px; letter-spacing: 0.04em;">
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #10B981; box-shadow: 0 0 6px #10B981; display: inline-block;"></span> New Inquiry Received!
          </span>
          <button class="toast-close-btn" style="background: none; border: none; color: #94A3B8; cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 0 2px;">&times;</button>
        </div>
        <div style="font-weight: 700; font-size: 0.95rem; color: #0F172A;">${escapeHtml(lead.name)}</div>
        <div style="font-size: 0.8rem; color: #64748B;">${escapeHtml(lead.company || lead.phone || lead.inquiry_type)}</div>
        <button class="toast-view-btn" data-id="${lead.id}" style="align-self: flex-start; margin-top: 4px; background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: all 0.2s ease;">
          View Lead &rarr;
        </button>
      `;

      toast.querySelector('.toast-close-btn')?.addEventListener('click', () => toast.remove());
      toast.querySelector('.toast-view-btn')?.addEventListener('click', () => {
        toast.remove();
        // Open lead modal directly
        currentEditingLead = lead;
        modalLeadId.textContent = `#${lead.id}`;
        modalLeadName.textContent = lead.name || 'Prospect';
        modalLeadMeta.innerHTML = `
          <span><i class="fa-regular fa-envelope"></i> ${escapeHtml(lead.email)}</span>
          <span><i class="fa-solid fa-phone"></i> ${escapeHtml(lead.phone)}</span>
          ${lead.company ? `<span><i class="fa-regular fa-building"></i> ${escapeHtml(lead.company)}</span>` : ''}
          <span><i class="fa-regular fa-calendar"></i> Today</span>
        `;
        modalLeadStatus.value = lead.status || 'new';
        modalProspectMsg.textContent = lead.message || 'No additional message left by prospect.';
        modalAdminNotes.value = lead.admin_notes || '';
        modalNotesCount.textContent = `${modalAdminNotes.value.length} / 5,000`;
        modalSaveFeedback.innerHTML = '';
        modalSaveBtn.disabled = false;
        leadNotesModal.showModal();
      });

      toastContainer.appendChild(toast);
      setTimeout(() => { if (toast.parentNode) toast.remove(); }, 10000);
    }

    // Real-time polling for new leads (every 20 seconds while tab is active)
    async function pollForNewLeads() {
      if (document.visibilityState === 'hidden') return;
      if (isLeadPolling) return;
      isLeadPolling = true;

      try {
        const res = await fetch(`/api/admin/leads?since_id=${latestKnownLeadId}&limit=10`);
        if (!res.ok) {
          if (syncIndicator) {
            syncIndicator.innerHTML = `<span style="width: 6px; height: 6px; border-radius: 50%; background: #F59E0B; display: inline-block;"></span> Reconnecting...`;
            syncIndicator.style.color = '#D97706';
          }
          return;
        }

        if (syncIndicator) {
          syncIndicator.innerHTML = `<span style="width: 6px; height: 6px; border-radius: 50%; background: #059669; display: inline-block;"></span> Live Sync Active`;
          syncIndicator.style.color = '#059669';
        }

        const data = await res.json();
        if (data.success && Array.isArray(data.contacts) && data.contacts.length > 0) {
          const freshLeads = data.contacts.filter(c => c.id && !knownLeadIds.has(c.id));
          if (freshLeads.length > 0) {
            freshLeads.forEach(lead => {
              knownLeadIds.add(lead.id);
              if (lead.id > latestKnownLeadId) latestKnownLeadId = lead.id;

              // 1. In-app toast alert
              showNewLeadToast(lead);

              // 2. Prepend row to table if on page 1 and matches active status filter
              if (currentLeadPage === 1 && (currentLeadStatus === 'all' || currentLeadStatus === lead.status)) {
                const emptyRow = leadsTableBody.querySelector('td[colspan="7"]')?.closest('tr');
                if (emptyRow) emptyRow.remove();

                const tempDiv = document.createElement('tbody');
                tempDiv.innerHTML = buildLeadRowHtml(lead);
                const newRow = tempDiv.firstElementChild;
                if (newRow) {
                  newRow.style.background = '#ECFDF5';
                  leadsTableBody.insertBefore(newRow, leadsTableBody.firstChild);
                  setTimeout(() => { newRow.style.transition = 'background 2s ease'; newRow.style.background = ''; }, 3000);
                }
              }
            });

            attachRowEventListeners();

            // 3. Update KPI counters with authoritative summary
            if (data.summary) {
              updateLeadKpis(data.summary);
            }
          }
        }
      } catch {
        if (syncIndicator) {
          syncIndicator.innerHTML = `<span style="width: 6px; height: 6px; border-radius: 50%; background: #F59E0B; display: inline-block;"></span> Reconnecting...`;
          syncIndicator.style.color = '#D97706';
        }
      } finally {
        isLeadPolling = false;
      }
    }

    // Initial event listener binding for server-rendered rows
    attachRowEventListeners();

    // Start background polling every 20 seconds
    setInterval(pollForNewLeads, 20000);

    // Poll immediately when tab becomes visible after backgrounding
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        pollForNewLeads();
      }
    });

    // Wire secure POST logout
    const logoutBtn = document.getElementById('btn-admin-logout');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        logoutBtn.disabled = true;
        logoutBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Logging out...';
        try {
          await fetch('/api/admin/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
        } finally {
          window.location.href = '/admin/login';
        }
      });
    }
  </script>

  <style>
