                        </td>
                        <td style="padding: 0.9rem 1rem;">
                          <span style="background: #F3F4F6; padding: 3px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; color: #374151;">
                            {v.traffic_source}
