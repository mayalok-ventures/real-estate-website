                    return (
                      <tr style="border-bottom: 1px solid #F3F4F6;" class="gsc-query-row" data-query={q.query.toLowerCase()}>
                        <td style="padding: 0.85rem 1rem;">
                          <strong style="color: #111827; display: flex; align-items: center; gap: 6px;">
