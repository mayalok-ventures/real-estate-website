---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getRuntimeEnv } from '../../lib/env';
import { verifySessionToken, sanitizeRedirectUrl } from '../../lib/auth';

// Check if user is already authenticated with a valid cryptographic session
const sessionCookie = Astro.cookies.get('sahyak_admin_session')?.value;
if (sessionCookie && sessionCookie.startsWith('session_')) {
  try {
    const env = await getRuntimeEnv();
    const adminEmailsConfig = env.ADMIN_EMAILS.split(',').map((e: string) => e.trim().toLowerCase());
    if (!adminEmailsConfig.includes('admin@sahyak.com')) {
      adminEmailsConfig.push('admin@sahyak.com');
    }
    const sessionSecret = env.ADMIN_SESSION_SECRET || env.ADMIN_SECRET;

    if (sessionSecret) {
      const verification = await verifySessionToken(sessionCookie, sessionSecret, adminEmailsConfig, env.DB);
      if (verification.valid) {
        const targetRedirect = sanitizeRedirectUrl(Astro.url.searchParams.get('redirect'), '/admin');
        return Astro.redirect(targetRedirect);
      }
    }
  } catch {}

  // If session is expired or forged, purge cookie to avoid redirect loop
  Astro.cookies.delete('sahyak_admin_session', { path: '/' });
}

const seoTitle = "Administrator Authentication - Sahyak CRM";
const seoDesc = "Secure administrator portal access for Sahyak Real Estate CRM.";
---

<Layout title={seoTitle} description={seoDesc}>
  <section style="min-height: 88vh; display: flex; align-items: center; justify-content: center; position: relative; background: #F8FAFC; padding: 2rem 1rem;">
    <!-- Ambient subtle background glow -->
    <div style="position: absolute; top: 20%; left: 50%; transform: translate(-50%, -50%); width: 500px; height: 500px; background: radial-gradient(circle, rgba(5, 150, 105, 0.05) 0%, rgba(248, 250, 252, 0) 70%); pointer-events: none;"></div>

    <div class="container" style="max-width: 460px; position: relative; z-index: 10; width: 100%;">
      <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; padding: 2.75rem 2.25rem; box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.03), 0 20px 32px -8px rgba(15, 23, 42, 0.06), -2px -2px 10px rgba(255, 255, 255, 0.95);">
        
        <div style="text-align: center; margin-bottom: 2rem;">
          <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 16px; background: #F1F5F9; border: 1px solid #E2E8F0; margin-bottom: 1.25rem; box-shadow: inset 1px 1px 2px rgba(15, 23, 42, 0.04);">
            <img src="/images/sahyak-logo.png" alt="Sahyak CRM" style="height: 36px; width: auto; object-fit: contain;" />
          </div>
          <h1 style="font-size: 1.5rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; letter-spacing: -0.01em;">Admin Access Portal</h1>
          <p style="font-size: 0.825rem; color: #64748B; display: inline-flex; align-items: center; gap: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Cloudflare Access & Cryptographic Sessions
          </p>
        </div>

        <div id="login-alert" class="form-status-alert error" style="display: none; background: #FEF2F2; border: 1px solid #FCA5A5; color: #DC2626; padding: 0.75rem 1rem; border-radius: 10px; font-size: 0.85rem; margin-bottom: 1.25rem;"></div>

        <form id="admin-login-form">
          <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="admin-email" class="form-label" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.5rem;">Admin Email</label>
            <input type="email" id="admin-email" name="email" class="form-input" style="width: 100%; box-sizing: border-box; background: #F8FAFC; border: 1px solid #CBD5E1; color: #0F172A; border-radius: 10px; padding: 0.75rem 1rem; font-size: 0.9rem; box-shadow: inset 1px 1px 2px rgba(15, 23, 42, 0.04); outline: none; transition: all 0.2s ease;" placeholder="name@company.com" required autocomplete="username" />
          </div>

          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label for="admin-password" class="form-label" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.5rem;">Security Key / Password</label>
            <input type="password" id="admin-password" name="password" class="form-input" style="width: 100%; box-sizing: border-box; background: #F8FAFC; border: 1px solid #CBD5E1; color: #0F172A; border-radius: 10px; padding: 0.75rem 1rem; font-size: 0.9rem; box-shadow: inset 1px 1px 2px rgba(15, 23, 42, 0.04); outline: none; transition: all 0.2s ease;" placeholder="Enter password" required autocomplete="current-password" />
          </div>

          <button type="submit" id="login-btn" class="btn btn-primary" style="width: 100%; padding: 0.85rem 1.25rem; background: #059669; color: #FFFFFF; border: 1px solid #047857; border-radius: 10px; font-weight: 600; font-size: 0.95rem; cursor: pointer; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.2); transition: all 0.2s ease; display: flex; align-items: center; justify-content: center; gap: 8px;">
            Authenticate &rarr;
          </button>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('admin-login-form');
    const alertEl = document.getElementById('login-alert');
    const submitBtn = document.getElementById('login-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        alertEl.style.display = 'none';

        const email = document.getElementById('admin-email').value.trim();
        const password = document.getElementById('admin-password').value;

        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Verifying credentials...';

        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();

          if (res.ok && data.success) {
            // Strictly sanitize redirect destination to eliminate Open Redirect vulnerabilities
            function getSafeRedirectUrl(raw) {
              if (!raw || typeof raw !== 'string') return '/admin';
              const trimmed = raw.trim();
              if (!trimmed) return '/admin';
              // Reject control characters (0x00 - 0x1F, 0x7F - 0x9F)
              if (/[\u0000-\u001F\u007F-\u009F]/.test(trimmed)) return '/admin';
              // Reject backslashes anywhere before query/hash
              const pathPart = trimmed.split('?')[0].split('#')[0];
              if (pathPart.includes('\\')) return '/admin';
              // Reject protocol-relative or backslash-prefixed paths
              if (!trimmed.startsWith('/') || trimmed.startsWith('//') || trimmed.startsWith('/\\')) return '/admin';
              // Reject explicit schemes (e.g. javascript:, data:, https:)
              if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(trimmed)) return '/admin';

              try {
                // Parse relative to current origin to inspect standard URL component resolution
                const parsed = new URL(trimmed, window.location.origin);
                if (parsed.origin !== window.location.origin) return '/admin';
                if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return '/admin';
                if (!parsed.pathname.startsWith('/') || parsed.pathname.startsWith('//')) return '/admin';

                const cleanRelative = parsed.pathname + parsed.search + parsed.hash;
                // Restrict redirect strictly to admin portal routes
                if (cleanRelative !== '/admin' && !cleanRelative.startsWith('/admin/') && !cleanRelative.startsWith('/admin?') && !cleanRelative.startsWith('/admin#')) {
                  return '/admin';
                }
                return cleanRelative;
              } catch {
                return '/admin';
              }
            }

            const urlParams = new URLSearchParams(window.location.search);
            const redirectUrl = getSafeRedirectUrl(urlParams.get('redirect'));
            window.location.href = redirectUrl;
          } else {
            alertEl.textContent = data.message || 'Authentication failed. Please check your credentials.';
            alertEl.style.display = 'block';
          }
        } catch (err) {
          alertEl.textContent = 'Network error while attempting to log in.';
          alertEl.style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Authenticate &rarr;';
        }
      });
    }
  </script>
</Layout>
