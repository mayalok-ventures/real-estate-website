                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                +91 87964 75107
                            </a>
                        </div>
                    </div>
                </aside>

                <!-- MAIN DOCUMENT BODY -->
                <article class="lg:col-span-8 bg-white p-8 md:p-12 rounded-3xl border border-gray-200 shadow-sm legal-prose legal-card">

                    <!-- Subtle Digital Repeating Watermark Background -->
                    <div class="legal-watermark-bg" aria-hidden="true"></div>

                    <!-- Print-Only Official Attribution Header -->
                    <div class="hidden print-attribution-header">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <strong>Sahyak CRM &bull; Official Legal Documentation</strong>
                            <span>https://sahyak.com/privacy/</span>
                        </div>
                        <div>Copyright &copy; 2026 Sahyak Real Estate Technologies Private Limited. All rights reserved. Archival copy.</div>
                    </div>

                    <!-- PROPRIETARY WORK PRODUCT & COPYRIGHT NOTICE -->
                    <div class="mb-10 p-5 rounded-2xl bg-gray-50 border border-gray-200 text-xs text-gray-700 relative overflow-hidden not-prose">
