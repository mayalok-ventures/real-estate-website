    <!-- Table of Contents Active Link Highlight Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const sections = document.querySelectorAll('article section[id]');
            const navLinks = document.querySelectorAll('.toc-link');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        navLinks.forEach(link => {
                            if (link.getAttribute('href') === `#${id}`) {
                                link.classList.add('active');
                            } else {
                                link.classList.remove('active');
                            }
                        });
                    }
                });
            }, { rootMargin: '-10% 0px -75% 0px' });

            sections.forEach(sec => observer.observe(sec));

            // Anti-Plagiarism Clipboard Attribution Appender
            document.addEventListener('copy', (e) => {
                const sel = window.getSelection();
                if (!sel || sel.rangeCount === 0 || sel.toString().trim().length < 35) return;
                const text = sel.toString();
                const notice = '\n\n[Source: Sahyak CRM Privacy Policy — https://sahyak.com/privacy/ | Copyright © 2026 Sahyak Real Estate Technologies Private Limited. All rights reserved. Commercial reproduction or unauthorized competitor adoption prohibited.]';
                if (e.clipboardData) {
                    e.clipboardData.setData('text/plain', text + notice);
                    e.preventDefault();
                }
            });
        });
    </script>
