                    <!-- Quick Support & Verification Card -->
                    <div class="bg-brand-dark text-white p-6 rounded-2xl shadow-sm border border-white/10 sahyak-card-dark">
                        <span class="text-xs uppercase tracking-wider text-brand-green font-bold block mb-2">Privacy Desk</span>
                        <h4 class="font-serif text-lg font-bold mb-2">Have privacy inquiries?</h4>
                        <p class="text-xs text-gray-300 mb-4 leading-relaxed">
