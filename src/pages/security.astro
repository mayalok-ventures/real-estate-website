---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const seoTitle = "Real Estate CRM Security & Data Compliance | Sahyak CRM";
const seoDesc = "Enterprise-grade security, isolated multi-tenant architecture, bank-grade encryption and role-based access for real estate teams across 15+ countries.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sahyak.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Security",
      "item": "https://sahyak.com/security"
    }
  ]
};

const securitySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDesc,
  "url": "https://sahyak.com/security",
  "mainEntity": {
    "@type": "SecurityService",
    "name": "Sahyak CRM Enterprise Security Architecture",
    "serviceType": "Cloud CRM Security & Data Compliance",
    "provider": {
      "@type": "Organization",
      "name": "Sahyak CRM",
      "url": "https://sahyak.com"
    },
    "description": "AES-256 bit encryption at rest and in transit, multi-tenant isolation, role-based access controls, and automated compliance backups for real estate developers and brokers."
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href="https://sahyak.com/security" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sahyak.com/security" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDesc} />
    <meta property="og:image" content="https://sahyak.com/images/security/1.png" />
    <meta property="og:site_name" content="Sahyak CRM" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://sahyak.com/security" />
    <meta property="twitter:title" content={seoTitle} />
    <meta property="twitter:description" content={seoDesc} />
    <meta property="twitter:image" content="https://sahyak.com/images/security/1.png" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mumbai" />
    <meta name="geo.position" content="19.0657;72.8682" />
    <meta name="ICBM" content="19.0657, 72.8682" />

    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    
    <script type="application/ld+json" set:html={JSON.stringify(securitySchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <style is:global>
        :root {
            --neon: #39FF14;
            --dark: #0a0a0a;
            --dark-gray: #141414;
            --light: #f8f9fa;
            --light-gray: #e9ecef;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark);
            color: white;
            overflow-x: hidden;
        }

        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
        }

        .text-neon { color: var(--neon); }
        .bg-neon { background-color: var(--neon); }
        .border-neon { border-color: var(--neon); }

        /* Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(57, 255, 20, 0.2); }
            50% { box-shadow: 0 0 30px rgba(57, 255, 20, 0.6); }
        }

        .animate-float { animation: float 5s ease-in-out infinite; }
        .animate-float-delayed { animation: float 5s ease-in-out 2.5s infinite; }
        .animate-pulse-glow { animation: pulseGlow 3s infinite; }

        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Custom Layouts */
        .split-screen {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            align-items: center;
        }
        @media (min-width: 1024px) {
            .split-screen { grid-template-columns: 1fr 1fr; }
            .split-screen.reverse { grid-template-columns: 1fr 1fr; }
            .split-screen.reverse > *:first-child { order: 2; }
        }

        .glass-card {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
        }

        .glass-card-light {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .editorial-overlap {
            position: relative;
        }
        .editorial-overlap .text-content {
            position: relative;
            z-index: 10;
            mix-blend-mode: difference;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--dark); }
        ::-webkit-scrollbar-thumb { background: var(--neon); border-radius: 4px; }
    </style>
</head>
<body class="antialiased">
    <a href="#commitment" class="skip-link">Skip to main content</a>

    <!-- Global Navigation -->
    <Navbar active="security" />

    <!-- Breadcrumb Navigation -->
    <div class="breadcrumb-container max-w-7xl mx-auto px-6 lg:px-8 pt-4">
        <nav aria-label="Breadcrumb" class="breadcrumb-nav">
            <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
                    <meta itemprop="position" content="1" />
                </li>
                <li class="breadcrumb-separator" aria-hidden="true">/</li>
                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <span class="breadcrumb-current" itemprop="name" aria-current="page">Security</span>
                    <meta itemprop="position" content="2" />
                </li>
            </ol>
        </nav>
    </div>

    <!-- ================= SECTION 1: HERO (Low-Angle Hero Shot) ================= -->
    <section class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden">
        <!-- Background Image Placeholder -->
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop" 
                 width="1920" height="1080" fetchpriority="high" loading="eager"
                 alt="Modern commercial architectural skyscraper symbolizing enterprise security" class="w-full h-full object-cover opacity-40 mix-blend-luminosity">
            <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-[#0a0a0a]/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <!-- Text Content -->
                <div class="lg:col-span-7 reveal">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8 bg-neon rounded flex items-center justify-center">
                            <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </div>
                        <span class="text-sm font-semibold tracking-widest uppercase text-neon">Security</span>
                    </div>
                    
                    <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6">
                        Your Data <br>
                        Built for <br>
                        What's <span class="text-neon italic">Next.</span>
                    </h1>
                    
                    <p class="text-gray-400 text-lg mb-8 max-w-xl leading-relaxed">
                        Your leads, conversations and business data power your growth. We protect them with enterprise-grade security, so you can focus on what you do best — closing deals.
                    </p>

                    <div class="flex flex-wrap gap-4 mb-12">
                        <a href="#commitment" class="bg-neon text-black px-8 py-3 rounded-full font-semibold hover:bg-white transition-colors duration-300 flex items-center gap-2">
                            Our security approach
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                        </a>
                        <a href="/contact" class="border border-gray-600 text-white px-8 py-3 rounded-full font-semibold hover:border-neon hover:text-neon transition-colors duration-300">
                            Talk to us
                        </a>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="flex -space-x-3">
                            <img src="https://i.pravatar.cc/100?img=11" width="40" height="40" loading="lazy" decoding="async" alt="Enterprise broker avatar" class="w-10 h-10 rounded-full border-2 border-[#0a0a0a]">
                            <img src="https://i.pravatar.cc/100?img=12" width="40" height="40" loading="lazy" decoding="async" alt="Real estate developer avatar" class="w-10 h-10 rounded-full border-2 border-[#0a0a0a]">
                            <img src="https://i.pravatar.cc/100?img=13" width="40" height="40" loading="lazy" decoding="async" alt="Property manager avatar" class="w-10 h-10 rounded-full border-2 border-[#0a0a0a]">
                        </div>
                        <p class="text-sm text-gray-400">Trusted by real estate teams <br> across 15+ countries worldwide</p>
                    </div>
                </div>

                <!-- Floating Cards / Visuals -->
                <div class="lg:col-span-5 relative h-full min-h-[400px] hidden lg:block reveal">
                    <!-- Main Image -->
                    <img src="/images/security/1.png" 
                         width="600" height="700" fetchpriority="high" loading="eager"
                         alt="Enterprise real estate security architecture and lead data protection" class="absolute right-0 top-0 w-full h-full object-cover object-center rounded-2xl opacity-90" style="clip-path: polygon(10% 0, 100% 0, 100% 100%, 0% 100%);">
                    
                    <!-- Floating Card 1 -->
                    <div class="absolute top-10 right-10 glass-card p-4 animate-float w-48">
                        <div class="flex items-start gap-3">
                            <div class="bg-neon/20 p-2 rounded-lg"><svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg></div>
                            <div>
                                <h4 class="text-sm font-semibold text-white">Encrypted data</h4>
                                <p class="text-xs text-gray-400">At rest and in transit</p>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Card 2 -->
                    <div class="absolute top-1/3 right-4 glass-card p-4 animate-float-delayed w-48">
                        <div class="flex items-start gap-3">
                            <div class="bg-neon/20 p-2 rounded-lg"><svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></div>
                            <div>
                                <h4 class="text-sm font-semibold text-white">Role-based access</h4>
                                <p class="text-xs text-gray-400">Control who can see what</p>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Card 3 -->
                    <div class="absolute bottom-1/4 right-12 glass-card p-4 animate-float w-48">
                        <div class="flex items-start gap-3">
                            <div class="bg-neon/20 p-2 rounded-lg"><svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg></div>
                            <div>
                                <h4 class="text-sm font-semibold text-white">Secure infrastructure</h4>
                                <p class="text-xs text-gray-400">Trusted cloud platforms</p>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Card 4 -->
                    <div class="absolute bottom-10 right-0 glass-card p-4 animate-float-delayed w-48">
                        <div class="flex items-start gap-3">
                            <div class="bg-neon/20 p-2 rounded-lg"><svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg></div>
                            <div>
                                <h4 class="text-sm font-semibold text-white">Regular audits</h4>
                                <p class="text-xs text-gray-400">Continuous monitoring</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 2: OUR COMMITMENT (Isometric 3D Diorama) ================= -->
    <section id="commitment" class="bg-[#f8f9fa] text-gray-900 py-24 md:py-32 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="split-screen">
                <!-- Text -->
                <div class="reveal">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-2 h-2 bg-neon rounded-full"></div>
                        <span class="text-sm font-semibold tracking-widest uppercase text-neon">Our Commitment</span>
                    </div>
                    <h2 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
                        Security & trust are at the <span class="text-neon">core</span> of Sahyak CRM.
                    </h2>
                    <p class="text-gray-600 text-lg mb-8 leading-relaxed max-w-lg">
                        From day one, we've built Sahyak CRM with a simple belief — real estate teams deserve a CRM that is private, secure and reliable, without unnecessary complexity.
                    </p>
                </div>

                <!-- Isometric Diorama Visual -->
                <div class="relative reveal">
                    <!-- Isometric Image Placeholder -->
                    <img src="/images/security/2.png" 
                         width="800" height="550" loading="lazy" decoding="async"
                         alt="Sahyak CRM multi-layered security and encryption commitment diorama" class="w-full h-auto rounded-2xl shadow-2xl object-cover object-center">
                    
                    <!-- Floating Labels -->
                    <div class="absolute top-10 left-0 glass-card-light p-3 flex items-center gap-2 animate-float">
                        <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        <span class="text-sm font-semibold text-gray-800">Protect your data</span>
                    </div>
                    <div class="absolute top-10 right-0 glass-card-light p-3 flex items-center gap-2 animate-float-delayed">
                        <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        <span class="text-sm font-semibold text-gray-800">Maintain your trust</span>
                    </div>
                    <div class="absolute bottom-10 left-10 glass-card-light p-3 flex items-center gap-2 animate-float">
                        <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        <span class="text-sm font-semibold text-gray-800">Enable secure collaboration</span>
                    </div>
                    <div class="absolute bottom-10 right-10 glass-card-light p-3 flex items-center gap-2 animate-float-delayed">
                        <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        <span class="text-sm font-semibold text-gray-800">Stay transparent</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 3: DATA PROTECTION (POV / Text-Character Interlocking) ================= -->
    <section class="bg-[#0a0a0a] py-24 md:py-32 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="split-screen">
                <!-- Text -->
                <div class="reveal z-10">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-2 h-2 bg-neon rounded-full"></div>
                        <span class="text-sm font-semibold tracking-widest uppercase text-neon">Data Protection</span>
                    </div>
                    <h2 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
                        Your data. <br>
                        Always <span class="text-neon italic">yours.</span>
                    </h2>
                    <p class="text-gray-400 text-lg mb-8 leading-relaxed max-w-lg">
                        We ensure your data is protected, encrypted and accessible only to authorized members of your organization.
                    </p>
                    
                    <ul class="space-y-4 mb-8">
                        <li class="flex items-center gap-3 text-gray-300">
                            <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Encryption at rest and in transit
                        </li>
                        <li class="flex items-center gap-3 text-gray-300">
                            <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Secure access controls
                        </li>
                        <li class="flex items-center gap-3 text-gray-300">
                            <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Regular security audits
                        </li>
                        <li class="flex items-center gap-3 text-gray-300">
                            <svg class="w-5 h-5 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Industry best practices and compliance
                        </li>
                    </ul>
                </div>

                <!-- POV Visual -->
                <div class="relative reveal">
                    <!-- POV Image Placeholder -->
                    <img src="/images/security/3.png" 
                         width="800" height="550" loading="lazy" decoding="async"
                         alt="Real estate broker securely accessing customer CRM records on smartphone" class="w-full h-auto rounded-2xl object-cover object-center">
                    
                    <!-- Floating Phone UI Card -->
                    <div class="absolute -bottom-10 -right-4 lg:right-10 glass-card p-6 w-64 animate-float">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="text-sm font-semibold text-white">Data Protection</h4>
                            <div class="bg-neon p-1 rounded-full"><svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg></div>
                        </div>
                        <div class="space-y-3">
                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                <div class="w-1.5 h-1.5 bg-neon rounded-full"></div> Secure Transmission
                            </div>
                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                <div class="w-1.5 h-1.5 bg-neon rounded-full"></div> Encrypted Storage
                            </div>
                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                <div class="w-1.5 h-1.5 bg-neon rounded-full"></div> Access Control
                            </div>
                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                <div class="w-1.5 h-1.5 bg-neon rounded-full"></div> Activity Monitoring
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 4: MULTI-TENANT SECURITY (Isometric 3D / Split-Screen Contrast) ================= -->
    <section class="bg-[#f8f9fa] text-gray-900 py-24 md:py-32 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
