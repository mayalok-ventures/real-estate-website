---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const seoTitle = "Sahyak CRM — Real Estate CRM for Developers & Brokers";
const seoDesc = "Mobile-first Real Estate CRM for agents, brokers, and developers. Automate lead capture, WhatsApp tracking, site visits, and sales pipelines across 15+ countries.";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://sahyak.com/#organization",
  "name": "Sahyak CRM",
  "legalName": "Sahyak Real Estate Technologies Private Limited",
  "url": "https://sahyak.com",
  "logo": "https://sahyak.com/images/sahyak-logo.png",
  "description": "Mobile-first Real Estate CRM engineered for brokers, developers, and sales agencies across 15+ countries.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bandra Kurla Complex, Bandra East",
    "addressLocality": "Mumbai",
    "addressRegion": "Maharashtra",
    "postalCode": "400051",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 19.0657,
    "longitude": 72.8682
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91 87964 75107",
    "contactType": "sales",
    "email": "support@sahyak.com",
    "availableLanguage": ["English", "Hindi"]
  }
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://sahyak.com/#website",
  "url": "https://sahyak.com",
  "name": "Sahyak CRM",
  "publisher": { "@id": "https://sahyak.com/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://sahyak.com/resources?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sahyak Real Estate CRM",
  "operatingSystem": "Web, Android, iOS",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "499",
    "priceCurrency": "INR"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "148"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href="https://sahyak.com/" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- GEO SEO Meta Tags -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mumbai, Maharashtra, India" />
    <meta name="geo.position" content="19.0657;72.8682" />
    <meta name="ICBM" content="19.0657, 72.8682" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sahyak.com/" />
    <meta property="og:site_name" content="Sahyak Real Estate CRM" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDesc} />
    <meta property="og:image" content="https://sahyak.com/images/previews/homepage.png" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_IN" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sahyakcrm" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDesc} />
    <meta name="twitter:image" content="https://sahyak.com/images/previews/homepage.png" />

    <link rel="icon" type="image/png" href="/images/sahyak-logo.png" />
    <link rel="apple-touch-icon" href="/images/sahyak-logo.png" />

    <!-- Static compiled Tailwind CSS -->
    <link rel="stylesheet" href="/css/tailwind.css" />
    <!-- Google Fonts: Playfair Display (Headings), Inter (Body), Caveat (Handwritten notes) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <style is:global>
        .hero-bg-sketch {
            background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            opacity: 0.1;
            mix-blend-mode: luminosity;
        }
        .text-gradient {
            background: linear-gradient(to right, #4ADE80, #22c55e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="font-sans antialiased text-textDark bg-lightBg overflow-x-hidden">
    <!-- Global Navigation -->
    <Navbar active="home" />

    <main id="main-content">
    <!-- ================= SECTION 1: HERO (DARK) ================= -->
    <section class="relative bg-darkGreen text-white min-h-screen flex items-center py-20 px-6 md:px-12 lg:px-20 overflow-hidden">
        <!-- Background Sketch Overlay -->
        <div class="absolute inset-0 hero-bg-sketch z-0"></div>

        <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center w-full">
            <!-- Left Content -->
            <div class="space-y-6">
                <!-- Logo -->
                <div class="flex items-center gap-2 mb-10">
                    <div class="w-8 h-8 bg-brandGreen rounded flex items-center justify-center text-darkGreen font-bold text-xl">S</div>
                    <span class="text-2xl font-bold tracking-tight">Sahyak</span>
                </div>

                <div class="flex items-center gap-2 text-brandGreen text-sm font-semibold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
                    Built for Real Estate Teams
                </div>

                <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif leading-tight">
                    The Real Estate <br> CRM Built <br> for <span class="text-brandGreen italic">Real People.</span>
                </h1>

                <p class="text-gray-300 text-lg max-w-lg leading-relaxed">
                    Capture leads, follow up, share property details, coordinate site visits and close more deals — all from your mobile, with Sahyak CRM.
                </p>

                <div class="flex flex-wrap items-center gap-4 pt-4">
                    <a href="https://crm.sahyak.com" class="bg-brandGreen text-darkGreen px-8 py-3 rounded-full font-semibold hover:bg-green-400 transition flex items-center gap-2">
                        Start free <span>&rarr;</span>
                    </a>
                    <a href="/features" class="border border-gray-600 text-white px-8 py-3 rounded-full font-semibold hover:bg-gray-800 transition flex items-center gap-2">
                        <span class="text-brandGreen">&#9654;</span> Watch demo
                    </a>
                </div>

                <div class="flex items-center gap-4 pt-8">
                    <div class="flex -space-x-3">
                        <img src="https://i.pravatar.cc/100?img=1" alt="User" class="w-10 h-10 rounded-full border-2 border-darkGreen">
                        <img src="https://i.pravatar.cc/100?img=2" alt="User" class="w-10 h-10 rounded-full border-2 border-darkGreen">
                        <img src="https://i.pravatar.cc/100?img=3" alt="User" class="w-10 h-10 rounded-full border-2 border-darkGreen">
                    </div>
                    <p class="text-sm text-gray-400">Trusted by real estate teams<br>across 15+ countries worldwide</p>
                </div>
            </div>

            <!-- Right Content (Phone Mockup) -->
            <div class="relative flex justify-center lg:justify-end">
                <!-- Handwritten Notes -->
                <div class="absolute -top-10 right-10 text-brandGreen font-handwriting text-2xl rotate-12 hidden md:block z-20">
                    LEADS <br> TO SITE VISITS <br> TO CLOSED <br> DEALS
                </div>
                <div class="absolute bottom-20 right-0 text-white font-handwriting text-2xl -rotate-12 hidden md:block z-20">
                    A SMARTER <br> WAY <br> TO SELL <br> REAL ESTATE
                </div>

                <!-- Phone Mockup with 1.png (Hero LCP Optimized) -->
                <div class="relative w-[300px] sm:w-[350px] md:w-[380px] lg:w-[420px] flex items-center justify-center">
                    <img src="/images/homepage/1.png" alt="Sahyak Real Estate CRM mobile app displaying client inquiry pipeline and site visits" width="420" height="780" fetchpriority="high" loading="eager" class="w-full h-auto object-contain drop-shadow-2xl -scale-x-100" style="transform: scaleX(-1);">
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 2: THE CHAOS (LIGHT) ================= -->
    <section class="py-24 px-6 md:px-12 lg:px-20 bg-lightBg">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left Text -->
            <div class="space-y-6">
                <div class="flex items-center gap-2 text-gray-500 text-sm font-semibold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
                    The Chaos We Replace
                </div>
                <h2 class="text-4xl md:text-5xl font-serif leading-tight text-darkGreen">
                    Too many leads. <br> Too many tools. <br> <span class="text-brandGreen italic">Too much to manage.</span>
                </h2>
                <p class="text-gray-600 text-lg max-w-md">
                    Property inquiries come from everywhere. Follow-ups get missed. Site visits are hard to coordinate. Inventory updates create confusion. Your sales team deserves better.
                </p>
            </div>

            <!-- Right Images Collage with 2.png -->
            <div class="relative min-h-[460px] lg:min-h-[500px] w-full flex items-center justify-end">
                <img src="/images/homepage/2.png" alt="Real estate broker dealing with fragmented communication tools and missed client inquiries" width="600" height="480" loading="lazy" decoding="async" class="w-full h-auto max-h-[480px] object-contain rounded-2xl drop-shadow-xl z-10">
                
                <!-- Floating UI Cards (CSS built) -->
                <div class="absolute top-0 left-0 bg-white p-4 rounded-xl shadow-lg z-20 w-48 border border-gray-100 hidden sm:block">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-6 h-6 bg-pink-100 rounded-full flex items-center justify-center text-pink-500 text-xs">IG</div>
                        <span class="text-xs font-bold">New Lead</span>
                    </div>
                    <p class="text-[10px] text-gray-500">From Meta Ads</p>
                    <p class="text-xs font-semibold mt-1">+91 98765 43210</p>
                </div>

                <div class="absolute bottom-16 left-4 bg-white p-4 rounded-xl shadow-lg z-20 w-48 border border-gray-100 hidden sm:block">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center text-green-500 text-xs">&#127968;</div>
                        <span class="text-xs font-bold">Property Portal</span>
                    </div>
                    <p class="text-[10px] text-gray-500">99acres Inquiry</p>
                    <p class="text-xs font-semibold mt-1">2BHK in Andheri</p>
                </div>

                <!-- Handwritten Note -->
                <div class="absolute -bottom-5 right-10 font-handwriting text-2xl text-darkGreen rotate-[-5deg] bg-yellow-100 p-2 shadow-sm z-30">
                    DIFFERENT <br> SOURCES <br> SAME <br> PROBLEM
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 3: FEATURES OVERVIEW (LIGHT) ================= -->
    <section class="py-24 px-6 md:px-12 lg:px-20 bg-lightBg border-t border-gray-200">
        <div class="max-w-7xl mx-auto space-y-16">
            <!-- Top Text -->
            <div class="space-y-6 max-w-2xl">
                <div class="flex items-center gap-2 text-gray-500 text-sm font-semibold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
                    A CRM That Actually Fits Your Work
                </div>
                <h2 class="text-4xl md:text-5xl font-serif leading-tight text-darkGreen">
                    Everything you need <br> to sell, <span class="text-brandGreen italic">in one place.</span>
                </h2>
                <p class="text-gray-600 text-lg">
                    From lead capture to deal closure, Sahyak CRM brings your entire real estate sales process into a single, easy-to-use mobile CRM.
                </p>
            </div>

            <!-- Icons Grid -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <!-- Feature 1 -->
                <div class="bg-darkGreen text-white p-6 rounded-xl flex flex-col items-center text-center gap-3 hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-brandGreen text-xl">&#128229;</div>
                    <span class="text-sm font-medium">Capture Leads</span>
                </div>
                <!-- Feature 2 -->
                <div class="bg-darkGreen text-white p-6 rounded-xl flex flex-col items-center text-center gap-3 hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-brandGreen text-xl">&#128260;</div>
                    <span class="text-sm font-medium">Manage Follow-ups</span>
                </div>
                <!-- Feature 3 -->
                <div class="bg-darkGreen text-white p-6 rounded-xl flex flex-col items-center text-center gap-3 hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-brandGreen text-xl">&#127970;</div>
                    <span class="text-sm font-medium">Share Properties</span>
                </div>
                <!-- Feature 4 -->
                <div class="bg-darkGreen text-white p-6 rounded-xl flex flex-col items-center text-center gap-3 hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-brandGreen text-xl">&#128205;</div>
                    <span class="text-sm font-medium">Coordinate Site Visits</span>
                </div>
                <!-- Feature 5 -->
                <div class="bg-darkGreen text-white p-6 rounded-xl flex flex-col items-center text-center gap-3 hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-brandGreen text-xl">&#128230;</div>
                    <span class="text-sm font-medium">Track Inventory</span>
                </div>
                <!-- Feature 6 -->
                <div class="bg-darkGreen text-white p-6 rounded-xl flex flex-col items-center text-center gap-3 hover:-translate-y-1 transition duration-300">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-brandGreen text-xl">&#129309;</div>
                    <span class="text-sm font-medium">Close More Deals</span>
                </div>
            </div>

            <!-- Bottom Image Area with 3.png (rotated 180deg horizontally) -->
            <div class="relative mt-16 rounded-3xl overflow-hidden bg-darkGreen min-h-[380px] md:h-[400px] flex items-center">
                <img src="/images/homepage/3.png" alt="Real estate agent scheduling client property viewings on mobile phone" width="450" height="400" loading="lazy" decoding="async" class="absolute right-0 bottom-0 h-full max-h-[380px] md:max-h-[400px] w-auto object-contain object-bottom z-0 -scale-x-100" style="transform: scaleX(-1);">
                
                <div class="relative z-10 p-8 md:p-12 max-w-lg">
                    <h3 class="text-3xl font-serif text-white mb-4">Built for on-the-go teams</h3>
                    <p class="text-gray-300">Access your entire CRM from your pocket. Update leads, schedule visits, and close deals right from the site.</p>
                </div>
                
                <!-- Handwritten Note -->
                <div class="absolute top-10 right-10 text-brandGreen font-handwriting text-2xl rotate-12 hidden md:block z-10">
                    BUILT <br> FOR <br> ON-THE-GO <br> TEAMS
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 4: POWERFUL FEATURES (LIGHT) ================= -->
    <section class="py-24 px-6 md:px-12 lg:px-20 bg-lightBg">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left Text -->
            <div class="space-y-6">
                <div class="flex items-center gap-2 text-gray-500 text-sm font-semibold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
                    Designed for how real estate teams work
                </div>
                <h2 class="text-4xl md:text-5xl font-serif leading-tight text-darkGreen">
                    Powerful features. <br> <span class="text-brandGreen italic">Real impact.</span>
                </h2>
                <p class="text-gray-600 text-lg max-w-md">
                    Lead management, WhatsApp engagement, field operations, site visit coordination and inventory control — all built for the realities of real estate sales.
                </p>
                <a href="/features" class="inline-flex bg-darkGreen text-white px-8 py-3 rounded-full font-semibold hover:bg-gray-800 transition items-center gap-2 mt-4">
                    Explore all features <span>&rarr;</span>
                </a>
            </div>

            <!-- Right Image (Isometric Illustration with 4.png) -->
            <div class="relative w-full flex items-center justify-center">
                <img src="/images/homepage/4.png" alt="Sahyak Real Estate CRM ecosystem 3D isometric diagram of lead capture and inventory tools" width="600" height="500" loading="lazy" decoding="async" class="w-full h-auto max-h-[500px] object-contain drop-shadow-2xl rounded-2xl">
            </div>
        </div>
    </section>

    <!-- ================= SECTION 5: CTA & STATS (LIGHT) ================= -->
    <section class="py-24 px-6 md:px-12 lg:px-20 bg-lightBg">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left Image with 5.png -->
            <div class="relative h-[500px] md:h-[600px] rounded-3xl overflow-hidden">
                <img src="/images/homepage/5.png" alt="Confident real estate entrepreneur and broker scaling property sales" width="600" height="600" loading="lazy" decoding="async" class="w-full h-full object-cover">
                <!-- Green Overlay Shape -->
                <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-darkGreen to-transparent"></div>
                
                <!-- Handwritten Note -->
                <div class="absolute top-10 left-10 text-brandGreen font-handwriting text-3xl rotate-[-10deg] z-10">
                    MORE <br> FOLLOW-UPS <br> MORE SITE VISITS <br> MORE CLOSINGS
                </div>
            </div>

            <!-- Right Text & Stats -->
            <div class="space-y-8">
                <div class="flex items-center gap-2 text-gray-500 text-sm font-semibold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
                    Start at your own pace
                </div>
                <h2 class="text-4xl md:text-5xl font-serif leading-tight text-darkGreen">
                    Get started for free. <br> <span class="text-brandGreen italic">No credit card required.</span>
                </h2>
                <p class="text-gray-600 text-lg">
                    Try Sahyak CRM with 20 leads, 1 user seat and essential features. Upgrade anytime as your team grows.
                </p>
                
                <div class="flex flex-wrap items-center gap-4">
                    <a href="https://crm.sahyak.com" class="bg-brandGreen text-darkGreen px-8 py-3 rounded-full font-semibold hover:bg-green-400 transition flex items-center gap-2">
                        Start free now <span>&rarr;</span>
                    </a>
                    <a href="/pricing" class="border border-gray-400 text-darkGreen px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition">
                        View pricing
                    </a>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-8 border-t border-gray-300">
                    <div>
                        <div class="text-3xl font-bold text-darkGreen">20</div>
                        <div class="text-sm text-gray-500">Leads</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-darkGreen">1</div>
                        <div class="text-sm text-gray-500">User seat</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-darkGreen">10</div>
                        <div class="text-sm text-gray-500">WhatsApp actions</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-darkGreen">3</div>
                        <div class="text-sm text-gray-500">Property listings</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SECTION 6: FOOTER / ABOUT (DARK) ================= -->
    <section class="relative bg-darkGreen text-white py-24 px-6 md:px-12 lg:px-20 overflow-hidden">
        <!-- Background Image with 6.png -->
        <div class="absolute inset-0 z-0 opacity-30">
            <img src="/images/homepage/6.png" alt="Futuristic smart city high-rise architecture representing modern real estate technology" width="1920" height="1080" loading="lazy" decoding="async" class="w-full h-full object-cover">
        </div>

        <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left Text -->
            <div class="space-y-6">
                <div class="flex items-center gap-2 text-brandGreen text-sm font-semibold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
                    Built for a bigger tomorrow
                </div>
                <h2 class="text-4xl md:text-5xl font-serif leading-tight">
                    Real estate moves fast. <br> <span class="text-brandGreen italic">So do we.</span>
                </h2>
                <p class="text-gray-300 text-lg max-w-md">
                    We're building the most practical, mobile-first CRM for real estate teams — with powerful features, a simple experience and a deep understanding of your world.
                </p>
                <a href="/about" class="inline-flex bg-brandGreen text-darkGreen px-8 py-3 rounded-full font-semibold hover:bg-green-400 transition items-center gap-2 mt-4">
                    Be part of the journey <span>&rarr;</span>
                </a>
            </div>

            <!-- Right Side -->
            <div class="relative h-[300px] hidden lg:flex items-center justify-end">
                <div class="text-brandGreen font-handwriting text-3xl rotate-[-5deg] text-right">
                    SAME <br> GOAL <br> A STRONGER <br> REAL ESTATE <br> TOMORROW
                </div>
            </div>
        </div>
    </section>
    </main>

    <!-- Universal Footer -->
    <Footer />

</body>
</html>
