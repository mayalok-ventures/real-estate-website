                <img src="/images/features/6.png" width="800" height="550" loading="lazy" decoding="async" alt="Sahyak WhatsApp Business API automation and verified broker chat templates" class="w-full h-auto max-h-[550px] object-contain drop-shadow-2xl rounded-2xl relative z-10 transition-transform duration-500 hover:scale-[1.02]">
            </div>
        </div>
    </section>

    <!-- Feature 6: Analytics & Reports (Dynamic Action Splash) -->
    <section class="bg-[var(--bg-dark)] py-20 px-4 md:px-10 relative overflow-hidden">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left Text -->
            <div class="fade-up">
                <span class="text-sm font-bold text-[var(--accent-green)] uppercase tracking-wider">06 Analytics & Reports</span>
                <h2 class="text-3xl md:text-5xl font-bold mt-4 mb-6 leading-tight">
                    Clear insights. <br><span class="text-[var(--accent-green)] italic">Smarter decisions.</span>
                </h2>
                <p class="text-gray-400 mb-8 text-lg">
                    Get real-time insights on leads, follow-ups, site visits, team performance and deal progress to make better decisions, every day.
                </p>
                <a href="/contact" class="btn-primary inline-flex px-6 py-3 rounded-full font-semibold items-center gap-2">
                    Explore analytics <span>&rarr;</span>
                </a>
            </div>
            
            <!-- Right Visual (Isometric 3D Analytics Dashboard) -->
            <div class="relative flex justify-center items-center fade-up" style="transition-delay: 200ms;">
                <!-- Background Glow -->
                <div class="absolute inset-0 bg-[var(--accent-green)] opacity-20 blur-[100px] rounded-full pointer-events-none"></div>
                <img src="/images/features/7.png" width="800" height="550" loading="lazy" decoding="async" alt="Sahyak Real Estate Analytics dashboard tracking broker conversions and revenue" class="w-full h-auto max-h-[550px] object-contain drop-shadow-2xl rounded-2xl relative z-10 transition-transform duration-500 hover:scale-[1.02]">
            </div>
        </div>
    </section>

    <!-- Universal Footer -->
    <Footer />

    <!-- JavaScript for Scroll Animations -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, {
                threshold: 0.1,
                rootMargin: "0px 0px -50px 0px"
            });

            document.querySelectorAll('.fade-up').forEach((el) => {
                observer.observe(el);
            });
        });
    </script>
</body>
