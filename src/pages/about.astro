---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const seoTitle = "About Sahyak CRM — Built for Modern Real Estate Teams";
const seoDesc = "Learn about Sahyak CRM: our mission, leadership, broker-first innovation, and how we empower real estate developers across 15+ countries worldwide.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sahyak.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": "https://sahyak.com/about"
    }
  ]
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": seoTitle,
  "description": seoDesc,
  "url": "https://sahyak.com/about",
  "mainEntity": {
    "@type": "Organization",
    "name": "Sahyak CRM",
    "url": "https://sahyak.com",
    "logo": "https://sahyak.com/images/logo.png",
    "foundingLocation": {
      "@type": "Place",
      "name": "Mumbai, Maharashtra, India"
    },
    "founder": {
      "@type": "Person",
      "name": "Sahyak Engineering & Real Estate Leadership",
      "jobTitle": "Co-Founders & Real Estate Architects",
      "worksFor": {
        "@type": "Organization",
        "name": "Sahyak CRM"
      }
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+91-87964-75107",
      "contactType": "customer service",
      "email": "support@sahyak.com",
      "areaServed": ["IN", "AE", "US", "GB", "AU", "CA", "SG"],
      "availableLanguage": ["en", "hi"]
    }
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href="https://sahyak.com/about/" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sahyak.com/about/" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDesc} />
    <meta property="og:image" content="https://sahyak.com/images/about/1.png" />
    <meta property="og:site_name" content="Sahyak CRM" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://sahyak.com/about/" />
    <meta property="twitter:title" content={seoTitle} />
    <meta property="twitter:description" content={seoDesc} />
    <meta property="twitter:image" content="https://sahyak.com/images/about/1.png" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mumbai" />
    <meta name="geo.position" content="19.0657;72.8682" />
    <meta name="ICBM" content="19.0657, 72.8682" />

    <link rel="icon" type="image/png" href="/images/sahyak-logo.png" />
    <link rel="apple-touch-icon" href="/images/sahyak-logo.png" />

    <!-- Shared Design System & Utility Styles -->
    <link rel="stylesheet" href="/css/tailwind.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <style is:global>
        /* --- GLOBAL VARIABLES (UNIFIED HOMEPAGE PALETTE) --- */
        :root {
            --bg-dark: #0A1C16;
            --bg-light: #F4F6F4;
            --text-dark: #111827;
            --text-light: #F3F4F6;
            --text-muted: #9CA3AF;
            --accent: #4ADE80;
            --accent-dark: #22c55e;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Inter', sans-serif;
        }

        /* --- RESET & BASE --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: var(--font-serif);
            font-weight: 400;
            line-height: 1.2;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        .container {
            width: 90%;
            max-width: 1400px;
            margin: 0 auto;
            position: relative;
        }

        /* --- UTILITY CLASSES --- */
        .section-dark { background-color: var(--bg-dark); color: var(--text-light); }
        .section-light { background-color: var(--bg-light); color: var(--text-dark); }
        
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background-color: var(--accent);
            color: var(--bg-dark);
            border: none;
        }

        .btn-primary:hover {
            background-color: var(--accent-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 230, 118, 0.2);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--text-light);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn-secondary:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .tagline {
            font-family: var(--font-sans);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .tagline::before {
            content: '';
            display: inline-block;
            width: 8px;
            height: 8px;
            background-color: var(--accent);
            border-radius: 50%;
        }

        /* --- ANIMATIONS --- */
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(2deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- SECTIONS --- */
        
        /* Hero Section */
        .hero {
            padding: 5rem 0 4rem;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #0A0A0A 0%, #1A1A1A 100%);
        }

        .hero .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            align-items: center;
        }

        .hero-text h1 {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            margin-bottom: 1.5rem;
        }

        .hero-text h1 span {
            color: var(--accent);
            font-style: italic;
        }

        .hero-text p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 500px;
            margin-bottom: 2rem;
        }

        .hero-cta {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .hero-social {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .avatars {
            display: flex;
        }

        .avatars img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: 2px solid var(--bg-dark);
            margin-left: -10px;
        }

        .avatars img:first-child { margin-left: 0; }

        .hero-visual {
            position: relative;
            height: 600px;
        }

        .hero-img-main {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 10px;
            filter: grayscale(20%) contrast(110%);
        }

        .floating-note {
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 1rem;
            border-radius: 5px;
            font-size: 0.8rem;
            font-weight: 500;
            max-width: 200px;
            animation: float 6s ease-in-out infinite;
        }

        .note-1 {
            top: 10%;
            right: -5%;
            transform: rotate(5deg);
            background: rgba(0, 230, 118, 0.1);
            border-color: var(--accent);
            color: var(--accent);
        }

        .note-2 {
            bottom: 20%;
            left: -10%;
            transform: rotate(-3deg);
            animation-delay: 2s;
        }

        /* Purpose Section */
        .purpose {
            padding: 6rem 0;
            background-color: var(--bg-light);
            color: var(--text-dark);
            position: relative;
        }

        .purpose .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .purpose-text h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            margin-bottom: 1.5rem;
        }

        .purpose-text h2 span {
            color: var(--accent-dark);
            font-style: italic;
        }

        .purpose-text p {
            color: #555;
            margin-bottom: 2rem;
        }

        .purpose-visual {
            position: relative;
        }

        .purpose-img {
            width: 100%;
            border-radius: 10px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .ui-card {
            position: absolute;
            background: white;
            padding: 0.8rem 1.2rem;
            border-radius: 8px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-dark);
            animation: float 5s ease-in-out infinite;
        }

        .ui-card:nth-child(2) { top: 10%; left: -10%; animation-delay: 1s; }
        .ui-card:nth-child(3) { top: 40%; right: -10%; animation-delay: 2s; }
        .ui-card:nth-child(4) { bottom: 10%; left: 10%; animation-delay: 3s; }

        /* Teams Section */
        .teams {
            padding: 6rem 0;
            background-color: var(--bg-dark);
        }

        .teams .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .teams-text h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            margin-bottom: 1.5rem;
        }

        .teams-text h2 span {
            color: var(--accent);
            font-style: italic;
        }

        .teams-visual {
            position: relative;
            height: 600px;
        }

        .collage-img {
            position: absolute;
            border-radius: 8px;
            object-fit: cover;
            box-shadow: 0 15px 30px rgba(0,0,0,0.5);
            transition: transform 0.4s ease;
        }

        .collage-img:hover {
            transform: scale(1.05) rotate(0deg) !important;
            z-index: 10;
        }

        .collage-1 { top: 0; left: 0; width: 60%; height: 50%; transform: rotate(-3deg); }
        .collage-2 { top: 20%; right: 0; width: 55%; height: 45%; transform: rotate(4deg); }
        .collage-3 { bottom: 0; left: 15%; width: 70%; height: 45%; transform: rotate(-2deg); }

        .collage-label {
            position: absolute;
            background: var(--accent);
            color: var(--bg-dark);
            padding: 0.3rem 0.8rem;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            border-radius: 4px;
            z-index: 5;
        }

        /* Product Section */
        .product {
            padding: 6rem 0;
            background-color: var(--bg-light);
            color: var(--text-dark);
        }

        .product .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .product-text h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            margin-bottom: 1.5rem;
        }

        .product-text h2 span {
            color: var(--accent-dark);
            font-style: italic;
        }

        .phone-mockup {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .phone-frame {
            width: 300px;
            height: 600px;
            background: #111;
            border-radius: 40px;
            border: 8px solid #333;
            box-shadow: 0 30px 60px rgba(0,0,0,0.2);
            overflow: hidden;
            position: relative;
            animation: float 8s ease-in-out infinite;
        }

        .phone-screen {
            width: 100%;
            height: 100%;
            background: #1A1A1A;
            padding: 20px;
            color: white;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .app-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .stat-card {
            background: #2A2A2A;
            padding: 15px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .stat-card span:first-child {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent);
        }

        .stat-card span:last-child {
            font-size: 0.7rem;
            color: #888;
        }

        .activity-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .activity-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #2A2A2A;
            padding: 10px;
            border-radius: 8px;
        }

        .activity-icon {
            width: 30px;
            height: 30px;
            background: rgba(0, 230, 118, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 0.8rem;
        }

        /* Beliefs Section */
        .beliefs {
            padding: 6rem 0;
            background-color: var(--bg-dark);
            position: relative;
            overflow: hidden;
        }

        .beliefs-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 50%;
            height: 100%;
            object-fit: cover;
            opacity: 0.4;
            mask-image: linear-gradient(to right, black 50%, transparent 100%);
            -webkit-mask-image: linear-gradient(to right, black 50%, transparent 100%);
        }

        .beliefs .container {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
        }

        .beliefs-text h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            margin-bottom: 1.5rem;
        }

        .beliefs-text h2 span {
            color: var(--accent);
            font-style: italic;
        }

        .beliefs-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .belief-item {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .belief-icon {
            width: 40px;
            height: 40px;
            background: rgba(0, 230, 118, 0.1);
            border: 1px solid var(--accent);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
        }

        .belief-item h4 {
            font-family: var(--font-sans);
            font-size: 1rem;
            font-weight: 600;
        }

        .belief-item p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Road Ahead Section */
        .road-ahead {
            padding: 6rem 0;
            background-color: var(--bg-light);
            color: var(--text-dark);
        }

        .road-ahead .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .road-text h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            margin-bottom: 1.5rem;
        }

        .road-text h2 span {
            color: var(--accent-dark);
            font-style: italic;
        }

        .road-visual {
            position: relative;
            height: 400px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .portal-circle {
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
            opacity: 0.3;
            animation: pulse 4s ease-in-out infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.2); opacity: 0.5; }
            100% { transform: scale(1); opacity: 0.3; }
        }

        .road-img {
            width: 80%;
            height: 100%;
            object-fit: cover;
            border-radius: 10px;
            z-index: 2;
            mask-image: radial-gradient(circle at center, black 65%, transparent 100%);
            -webkit-mask-image: radial-gradient(circle at center, black 65%, transparent 100%);
            animation: float 6s ease-in-out infinite;
        }

        /* Footer CTA Section */
        .footer-cta {
            padding: 6rem 0;
            background: linear-gradient(135deg, #1A1A1A 0%, #0A0A0A 100%);
            position: relative;
            overflow: hidden;
        }

        .footer-cta .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .footer-text h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            margin-bottom: 1.5rem;
        }

        .footer-text h2 span {
            color: var(--accent);
            font-style: italic;
        }

        .footer-visual {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .footer-phone-img {
            width: 300px;
            max-width: 100%;
            height: 300px;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 20px;
            border: 2px solid rgba(74, 222, 128, 0.25);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(74, 222, 128, 0.1);
            animation: float 7s ease-in-out infinite;
        }

        .footer-phone {
            width: 250px;
            height: 500px;
            background: #111;
            border-radius: 30px;
            border: 6px solid #333;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            animation: float 7s ease-in-out infinite;
        }

        .footer-phone-logo {
            width: 80px;
            height: 80px;
            border: 2px solid var(--accent);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--accent);
            font-weight: bold;
        }

        .floating-note-footer {
            position: absolute;
            top: -10px;
            right: 15px;
            background: rgba(0, 230, 118, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid var(--accent);
            color: var(--accent);
            padding: 0.85rem 1rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            max-width: 170px;
            transform: rotate(5deg);
            animation: float 5s ease-in-out infinite;
            z-index: 5;
        }

        /* --- RESPONSIVE DESIGN --- */
        @media (max-width: 992px) {
            .grid-2, .hero .container, .purpose .container, .teams .container, 
            .product .container, .beliefs .container, .road-ahead .container, 
            .footer-cta .container {
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            .hero-visual, .teams-visual, .road-visual {
                height: 400px;
            }

            .beliefs-bg {
                width: 100%;
                mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
                -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
            }

            .beliefs-grid {
                grid-template-columns: 1fr;
            }

            .floating-note, .ui-card, .floating-note-footer {
                display: none; /* Hide floating elements on mobile for cleaner look */
            }
        }

        @media (max-width: 576px) {
            .hero-text h1, .purpose-text h2, .teams-text h2, .product-text h2, 
            .beliefs-text h2, .road-text h2, .footer-text h2 {
                font-size: 2rem;
            }

            .hero-cta {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <Navbar active="about" />

    <Breadcrumb items={[
        { name: 'Home', url: '/' },
        { name: 'About Us' }
    ]} />

    <main id="main-content">

    <!-- HERO SECTION -->
    <section class="hero section-dark">
        <div class="container">
            <div class="hero-text reveal">
                <div class="tagline">About Sahyak</div>
                <h1>Built around the people who build <span>real estate.</span></h1>
                <p>Sahyak is a mobile-first CRM designed for real estate teams — to help you capture leads, follow up, coordinate site visits and close more deals, with less chaos.</p>
                <div class="hero-cta">
                    <a href="#purpose" class="btn btn-primary">Our story &rarr;</a>
                    <a href="/features" class="btn btn-secondary">Explore product</a>
                </div>
                <div class="hero-social">
                    <div class="avatars">
                        <img src="https://i.pravatar.cc/100?img=1" width="40" height="40" loading="lazy" decoding="async" alt="Broker partner avatar">
                        <img src="https://i.pravatar.cc/100?img=2" width="40" height="40" loading="lazy" decoding="async" alt="Real estate consultant avatar">
                        <img src="https://i.pravatar.cc/100?img=3" width="40" height="40" loading="lazy" decoding="async" alt="Agency director avatar">
                    </div>
                    <span>Built for real estate teams across India and beyond</span>
                </div>
