---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { isCountrySupported, getCountryPricing, COUNTRY_PRICING, type SupportedCountryCode } from '../lib/pricingData';

const seoTitle = "Real Estate CRM Pricing — ₹499 Base Access | Sahyak CRM";
const seoDesc = "Transparent real estate CRM pricing. Start with ₹499 base access, zero hidden fees, unlimited WhatsApp messaging, and add seats as your team expands.";

const serverDetectedCountry: SupportedCountryCode = 'IN';
const serverIsSupported = true;
const initialPricing = getCountryPricing('IN') || COUNTRY_PRICING['IN'];

const pricingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is included in Sahyak CRM Base Access?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Base Access provides complete CRM functionality: lead pipelines, WhatsApp chat integration, automated site visit tracking, property inventory management, and basic sales analytics."
      }
    },
    {
      "@type": "Question",
      "name": "Can I scale users and lead capacity anytime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Sahyak CRM is fully modular. You can add or reduce team seats, lead storage tiers, and document capacity anytime with immediate prorated adjustments."
      }
    },
    {
      "@type": "Question",
      "name": "Are there setup or data migration charges?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. There are zero setup fees and zero data migration charges. We provide free CSV imports and guided team onboarding for all plans."
      }
    },
    {
      "@type": "Question",
      "name": "Is WhatsApp Business messaging included?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Sahyak includes built-in WhatsApp Web automation and official Meta Cloud WhatsApp Business API integration without separate platform markup."
      }
    },
    {
      "@type": "Question",
      "name": "Does Sahyak support international multi-currency pricing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we support localized pricing across 15+ countries including India (INR), UAE (AED), United States (USD), United Kingdom (GBP), Australia (AUD), and Canada (CAD)."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sahyak.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pricing",
      "item": "https://sahyak.com/pricing"
    }
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sahyak CRM",
  "operatingSystem": "Web, iOS, Android",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": initialPricing?.currency || "INR",
    "lowPrice": initialPricing?.basePrice || 499,
    "offerCount": "15"
  },
  "description": "Transparent, modular real estate CRM pricing for brokers and developers across 15+ countries."
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href="https://sahyak.com/pricing" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sahyak.com/pricing" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDesc} />
    <meta property="og:image" content="https://sahyak.com/images/pricing/1.png" />
    <meta property="og:site_name" content="Sahyak CRM" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://sahyak.com/pricing" />
    <meta property="twitter:title" content={seoTitle} />
    <meta property="twitter:description" content={seoDesc} />
    <meta property="twitter:image" content="https://sahyak.com/images/pricing/1.png" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mumbai" />
    <meta name="geo.position" content="19.0657;72.8682" />
    <meta name="ICBM" content="19.0657, 72.8682" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(pricingFaqSchema)} />

    <style is:global>
        /* CSS VARIABLES (HOMEPAGE UNIFIED PALETTE) */
        :root {
            --bg-dark: #0A1C16;
            --bg-light: #F4F6F4;
            --green-primary: #4ADE80;
            --green-hover: #22c55e;
            --text-white: #FFFFFF;
            --text-dark: #111827;
            --text-gray: #6B7280;
            --text-light-gray: #9CA3AF;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-white);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'DM Serif Display', serif;
            font-weight: 400;
            line-height: 1.2;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        section {
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }

        /* ANIMATIONS */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .reveal-left { transform: translateX(-40px); }
        .reveal-right { transform: translateX(40px); }
        .reveal-left.active, .reveal-right.active { transform: translateX(0); }

        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
        .floating { animation: float 6s ease-in-out infinite; }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            border: none;
        }
        .btn-primary {
            background-color: var(--green-primary);
            color: #0A1C16;
            font-weight: 700;
        }
        .btn-primary:hover {
            background-color: var(--green-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(74, 222, 128, 0.3);
        }
        .btn-outline {
            background-color: transparent;
            color: var(--text-white);
            border: 1px solid rgba(255,255,255,0.3);
        }
        .btn-outline:hover {
            border-color: var(--text-white);
            background: rgba(255,255,255,0.1);
        }
        .btn-dark-outline {
            background-color: transparent;
            color: var(--text-dark);
            border: 1px solid rgba(0,0,0,0.2);
        }
        .btn-dark-outline:hover {
            border-color: var(--text-dark);
            background: rgba(0,0,0,0.05);
        }

        /* SECTION 1: HERO */
        .hero {
            background-color: var(--bg-dark);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
            min-height: 90vh;
            position: relative;
            overflow: hidden;
        }
        .hero-bg-wrapper {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }
        .hero-bg-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: contrast(125%) brightness(0.7);
        }
        .hero-bg-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(10, 28, 22, 0.88) 0%, rgba(10, 28, 22, 0.95) 60%, rgba(10, 28, 22, 0.84) 100%);
            mix-blend-mode: multiply;
        }
        .hero-content { position: relative; z-index: 1; }
        .hero h1 { font-size: 3.8rem; margin-bottom: 20px; }
        .hero h1 span { color: var(--green-primary); font-style: italic; }
        .hero p { font-size: 1.1rem; color: var(--text-light-gray); margin-bottom: 30px; max-width: 440px; }
        .hero-cta { display: flex; gap: 15px; margin-bottom: 40px; flex-wrap: wrap; }
        .trust-badge { display: flex; align-items: center; gap: 15px; font-size: 0.9rem; color: var(--text-light-gray); }
        .trust-badge img { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--bg-dark); margin-left: -15px; }
        .trust-badge img:first-child { margin-left: 0; }
        
        .hero-visual { position: relative; z-index: 1; display: flex; justify-content: center; }
        .phone-mockup {
            width: 330px;
            min-height: 640px;
            background: #fff;
            border-radius: 40px;
            border: 8px solid #1a1a1a;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.5);
            animation: float 6s ease-in-out infinite;
        }
        .phone-screen { padding: 24px; color: var(--text-dark); height: 100%; display: flex; flex-direction: column; justify-content: space-between; }
        .phone-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .phone-header h4 { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.1rem; }
        .phone-plan { background: #f0fdf4; border: 1px solid #bbf7d0; padding: 14px; border-radius: 12px; margin-bottom: 18px; }
        .phone-plan h5 { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.95rem; color: #166534; margin-bottom: 4px; }
        .phone-plan p { font-size: 0.8rem; color: var(--text-gray); }
        .phone-slider { margin-bottom: 16px; }
        .phone-slider label { font-size: 0.8rem; font-weight: 600; display: flex; justify-content: space-between; margin-bottom: 4px; }
        .phone-slider input { width: 100%; accent-color: var(--green-primary); }
        .phone-total { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 15px; border-top: 1px solid #eee; }
        .phone-total h3 { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.5rem; color: var(--text-dark); }

        /* SECTION 2: ISOMETRIC */
        .isometric-section { background-color: var(--bg-light); color: var(--text-dark); position: relative; overflow: hidden; }
        .isometric-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 60px; align-items: center; }
        .isometric-text h2 { font-size: 3rem; margin-bottom: 20px; }
        .isometric-text h2 span { color: var(--green-primary); font-style: italic; }
        .isometric-text p { color: var(--text-gray); font-size: 1.1rem; }
        .isometric-visual { position: relative; min-height: 480px; display: flex; justify-content: center; align-items: center; }
        .iso-img {
            width: 100%;
            max-width: 580px;
            max-height: 480px;
            object-fit: contain;
            border-radius: 20px;
            position: relative;
            z-index: 1;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.12));
            transition: transform 0.5s ease;
        }
        .iso-img.floating {
            animation: float 7s ease-in-out infinite;
        }
        .floating-card {
            position: absolute;
            background: #fff;
            padding: 15px 20px;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 10;
            font-weight: 600;
            font-size: 0.9rem;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(0,0,0,0.05);
        }
        .fc-1 { top: 8%; left: -10px; animation: float 5s ease-in-out infinite; }
        .fc-2 { bottom: 10%; left: 15px; animation: float 7s ease-in-out infinite 1s; }
        .fc-3 { top: 22%; right: -10px; animation: float 6s ease-in-out infinite 0.5s; }

        /* SECTION 3: CALCULATOR */
        .calculator-section { background-color: var(--bg-dark); }
        .calc-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 60px; align-items: center; }
        .calc-text h2 { font-size: 3.5rem; margin-bottom: 20px; }
        .calc-text h2 span { color: var(--green-primary); font-style: italic; }
        .calc-text p { color: var(--text-light-gray); font-size: 1.1rem; margin-bottom: 25px; }
        .billing-toggle-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 25px; background: rgba(255,255,255,0.05); padding: 8px 16px; border-radius: 30px; width: fit-content; border: 1px solid rgba(255,255,255,0.1); }
        .billing-toggle-label { font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--text-light-gray); }
        .billing-toggle-label.active { color: var(--green-primary); }
        .billing-switch {
            position: relative; display: inline-block; width: 44px; height: 24px;
        }
        .billing-switch input { opacity: 0; width: 0; height: 0; }
        .billing-slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #374151; transition: .3s; border-radius: 24px;
        }
        .billing-slider:before {
            position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px;
            background-color: white; transition: .3s; border-radius: 50%;
        }
        input:checked + .billing-slider { background-color: var(--green-primary); }
        input:checked + .billing-slider:before { transform: translateX(20px); }
        .discount-pill { background: rgba(74, 222, 128, 0.2); color: var(--green-primary); font-size: 0.75rem; padding: 2px 8px; border-radius: 12px; font-weight: 700; margin-left: 6px; }

        .calc-visual {
            background: #fff;
            border-radius: 20px;
            padding: 40px;
            color: var(--text-dark);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }
        .calc-controls label { display: flex; justify-content: space-between; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; }
        .calc-controls input[type="range"] { width: 100%; margin-bottom: 22px; accent-color: var(--green-primary); cursor: pointer; }
        .calc-summary { border-left: 1px solid #eee; padding-left: 40px; display: flex; flex-direction: column; justify-content: space-between; }
        .calc-summary h4 { font-family: 'Inter', sans-serif; font-size: 1.2rem; margin-bottom: 16px; }
        .calc-line { display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--text-gray); margin-bottom: 10px; }
        .calc-total { display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 700; margin-top: 15px; padding-top: 15px; border-top: 1px solid #eee; color: var(--text-dark); }
        .calc-note { font-size: 0.75rem; color: var(--text-gray); margin-top: 6px; }

        /* SECTION 4: PRICING CARDS */
        .pricing-section { background-color: var(--bg-light); color: var(--text-dark); }
        .pricing-header { text-align: center; margin-bottom: 60px; }
        .pricing-header h2 { font-size: 3.5rem; margin-bottom: 20px; }
        .pricing-header h2 span { color: var(--green-primary); font-style: italic; }
        .pricing-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 900px; margin: 0 auto; }
        .pricing-card {
            background: #fff;
            border-radius: 20px;
            padding: 40px;
            border: 1px solid #eee;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .pricing-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.06); }
        .pricing-card.popular { border: 2px solid var(--green-primary); position: relative; }
        .popular-badge {
            position: absolute;
            top: -15px;
            right: 40px;
            background: var(--green-primary);
            color: #0A1C16;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }
        .pricing-card h3 { font-family: 'Inter', sans-serif; font-size: 1.5rem; margin-bottom: 10px; }
        .pricing-card .price { font-size: 3rem; font-weight: 700; margin-bottom: 15px; color: var(--text-dark); }
        .pricing-card .price span { font-size: 1rem; color: var(--text-gray); font-weight: 400; }
        .pricing-card ul { list-style: none; margin-bottom: 35px; }
        .pricing-card ul li { margin-bottom: 14px; display: flex; align-items: flex-start; gap: 10px; color: var(--text-gray); font-size: 0.95rem; }
        .pricing-card ul li::before { content: '✓'; color: #16a34a; font-weight: bold; }

        /* NON-SUPPORTED COUNTRY SPECIFIC CARD */
        .unsupported-cta-box {
            background: #fff;
            border-radius: 24px;
            padding: 48px;
            max-width: 820px;
            margin: 0 auto;
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            border: 2px solid #e5e7eb;
            text-align: center;
        }
        .unsupported-badge {
            display: inline-block;
            background: #ecfdf5;
            color: #065f46;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 20px;
            border: 1px solid #a7f3d0;
        }
        .unsupported-cta-box h3 { font-size: 2.4rem; margin-bottom: 16px; color: var(--text-dark); }
        .unsupported-cta-box p { color: var(--text-gray); font-size: 1.1rem; line-height: 1.7; max-width: 650px; margin: 0 auto 30px auto; }
        .unsupported-features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            text-align: left;
            margin-bottom: 35px;
            padding: 24px;
            background: #f9fafb;
            border-radius: 16px;
        }
        .unsupported-feat-item { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; color: #374151; }
        .unsupported-feat-item span { color: #16a34a; font-weight: bold; font-size: 1.1rem; }

        /* SECTION 5: FEATURES */
        .features-section { background-color: var(--bg-dark); position: relative; overflow: hidden; }
        .features-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; position: relative; z-index: 1; }
        .features-text h2 { font-size: 3.5rem; margin-bottom: 20px; }
        .features-text h2 span { color: var(--green-primary); font-style: italic; }
        .features-text p { color: var(--text-light-gray); font-size: 1.1rem; margin-bottom: 30px; }
        .features-visual { position: relative; display: flex; justify-content: center; align-items: center; }
        .features-ambient-wrapper {
            position: absolute;
            inset: -40px -40px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 0;
            pointer-events: none;
        }
        .features-ambient-img {
            width: 100%;
            height: 100%;
            max-width: 600px;
            object-fit: cover;
            border-radius: 30px;
            opacity: 0.35;
            filter: contrast(120%) brightness(0.85);
            mix-blend-mode: screen;
            transform: scale(1.06);
            transition: opacity 0.3s ease;
        }
        .features-phone {
            width: 350px;
            height: 700px;
            background: #fff;
            border-radius: 45px;
            border: 10px solid #1a1a1a;
            position: relative;
            z-index: 1;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.6), 0 0 50px rgba(74, 222, 128, 0.15);
        }
        .features-screen { padding: 30px; color: var(--text-dark); height: 100%; }
        .features-screen h4 { font-family: 'Inter', sans-serif; font-size: 1.2rem; margin-bottom: 20px; }
        .feature-item { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; padding: 15px; border-radius: 12px; background: #f9f9f9; }
        .feature-icon { width: 40px; height: 40px; background: var(--green-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #0A1C16; font-weight: bold; }

        /* SECTION 6: TRANSPARENT */
        .transparent-section { background-color: var(--bg-light); color: var(--text-dark); }
        .trans-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 60px; align-items: center; }
        .trans-text h2 { font-size: 3.5rem; margin-bottom: 20px; }
        .trans-text h2 span { color: var(--green-primary); font-style: italic; }
        .trans-text p { color: var(--text-gray); font-size: 1.1rem; }
        .trans-features { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
        .trans-item { display: flex; gap: 15px; }
        .trans-item-icon { width: 50px; height: 50px; background: #fff; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #16a34a; font-size: 1.5rem; box-shadow: 0 5px 15px rgba(0,0,0,0.05); flex-shrink: 0; }
        .trans-item h4 { font-family: 'Inter', sans-serif; font-size: 1rem; margin-bottom: 5px; }
        .trans-item p { font-size: 0.9rem; color: var(--text-gray); }

        /* SECTION 7: CTA */
        .cta-section { background-color: var(--bg-dark); text-align: left; padding: 120px 0; position: relative; }
        .cta-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://images.unsplash.com/photo-1449824913935-59a10b8d2000?q=80&w=2070&auto=format&fit=crop') center/cover;
            opacity: 0.15;
            filter: grayscale(100%) contrast(120%);
            pointer-events: none;
        }
        .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; position: relative; z-index: 1; }
        .cta-text h2 { font-size: 4rem; margin-bottom: 20px; }
        .cta-text h2 span { color: var(--green-primary); font-style: italic; }
        .cta-text p { color: var(--text-light-gray); font-size: 1.1rem; margin-bottom: 30px; }
        .cta-visual { display: flex; justify-content: center; }
        .portal-frame {
            width: 320px;
            height: 620px;
            border: 5px solid var(--green-primary);
            border-radius: 45px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 0 60px rgba(74, 222, 128, 0.35), 0 30px 60px rgba(0,0,0,0.6);
            background: #000;
        }
        .portal-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
            transition: transform 0.8s ease;
        }
        .portal-frame:hover img {
            transform: scale(1.04);
        }
        .portal-notch {
            position: absolute;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            width: 90px;
            height: 18px;
            background: #000;
            border-radius: 20px;
            z-index: 10;
        }
        .portal-reflection {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 40%);
            pointer-events: none;
            z-index: 5;
        }

        /* VIEW TOGGLE HELPERS */
        .pricing-supported-only { display: block; }
        .pricing-unsupported-only { display: none; }

        body.unsupported-region .pricing-supported-only { display: none !important; }
        body.unsupported-region .pricing-unsupported-only { display: block !important; }

        /* RESPONSIVE DESIGN (Mobile First) */
        @media (max-width: 1024px) {
            .hero h1 { font-size: 3rem; }
            .calc-grid, .features-grid, .trans-grid, .cta-grid { grid-template-columns: 1fr; gap: 40px; }
            .calc-visual { grid-template-columns: 1fr; }
            .calc-summary { border-left: none; border-top: 1px solid #eee; padding-left: 0; padding-top: 20px; }
            .isometric-grid { grid-template-columns: 1fr; }
            .pricing-cards { grid-template-columns: 1fr; }
        }
        @media (max-width: 768px) {
            .hero { grid-template-columns: 1fr; text-align: center; padding-top: 60px; }
            .hero-cta { justify-content: center; }
            .trust-badge { justify-content: center; }
            .hero-visual { margin-top: 40px; }
            .hero h1 { font-size: 2.5rem; }
            .isometric-text h2, .calc-text h2, .pricing-header h2, .features-text h2, .trans-text h2, .cta-text h2 { font-size: 2.5rem; }
            .trans-features { grid-template-columns: 1fr; }
            .phone-mockup, .features-phone { width: 300px; height: 600px; }
            .portal-frame { width: 270px; height: 530px; }
            .features-ambient-wrapper { inset: -20px -20px; }
            .fc-1 { left: 0; }
            .fc-2 { left: 10px; }
            .fc-3 { right: 0; }
        }
        @media (max-width: 480px) {
            .phone-mockup, .features-phone { width: 280px; min-height: 540px; }
            .portal-frame { width: 240px; height: 480px; }
            .unsupported-cta-box { padding: 30px 20px; }
        }
    </style>
