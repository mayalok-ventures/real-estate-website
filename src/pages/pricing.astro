            // 3. Geolocation & Country Resolution
            let currentCountry = 'IN';
            let isSupported = true;

            const urlParams = new URLSearchParams(window.location.search);
            const countryParam = urlParams.get('country');

            // Quick client timezone detection fallback
            let clientTz = '';
            try {
                clientTz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            } catch(e) {}

            try {
                let geoApiUrl = '/api/geo';
                const queryParts = [];
                if (countryParam) queryParts.push('country=' + encodeURIComponent(countryParam));
                if (clientTz) queryParts.push('tz=' + encodeURIComponent(clientTz));
                if (queryParts.length > 0) geoApiUrl += '?' + queryParts.join('&');

                const res = await fetch(geoApiUrl);
                if (res.ok) {
                    const geoData = await res.json();
                    if (geoData.isSupported && geoData.country && COUNTRY_DATA[geoData.country]) {
                        currentCountry = geoData.country;
                        isSupported = true;
                    } else if (geoData.isSupported === false) {
                        isSupported = false;
                        currentCountry = geoData.country || 'OTHER';
                    }
                }
            } catch(err) {
                console.warn('Geo detection fallback:', err);
                if (countryParam && !COUNTRY_DATA[countryParam.toUpperCase()]) {
                    isSupported = false;
                }
            }

            // Apply body class based on support status
            if (isSupported) {
                document.body.classList.remove('unsupported-region');
            } else {
                document.body.classList.add('unsupported-region');
            }

            // 4. Calculator State and Event Listeners
            const cUsers = document.getElementById('c-users');
            const cLeads = document.getElementById('c-leads');
            const cStorage = document.getElementById('c-storage');
            const cPlatforms = document.getElementById('c-platforms');
            const billingToggle = document.getElementById('billing-toggle');
            const btnMonthly = document.getElementById('btn-monthly');
            const btnAnnual = document.getElementById('btn-annual');

            let isAnnual = false;

            if (billingToggle) {
                billingToggle.addEventListener('change', () => {
                    isAnnual = billingToggle.checked;
                    if (btnMonthly && btnAnnual) {
                        if (isAnnual) {
                            btnAnnual.classList.add('active');
                            btnMonthly.classList.remove('active');
                        } else {
                            btnMonthly.classList.add('active');
                            btnAnnual.classList.remove('active');
                        }
                    }
                    renderPricing();
                });
            }

            if (btnMonthly) {
                btnMonthly.addEventListener('click', () => {
                    if (billingToggle) {
                        billingToggle.checked = false;
                        isAnnual = false;
                        btnMonthly.classList.add('active');
                        btnAnnual.classList.remove('active');
                        renderPricing();
                    }
                });
            }

            if (btnAnnual) {
                btnAnnual.addEventListener('click', () => {
                    if (billingToggle) {
                        billingToggle.checked = true;
                        isAnnual = true;
                        btnAnnual.classList.add('active');
                        btnMonthly.classList.remove('active');
                        renderPricing();
                    }
                });
            }

            function renderPricing() {
                if (!isSupported) {
                    // Update Unsupported Summary with user's selected capacity (WITHOUT NUMERIC PRICES)
                    const uIdx = parseInt(cUsers?.value || '1', 10);
                    const lIdx = parseInt(cLeads?.value || '1', 10);
                    const sIdx = parseInt(cStorage?.value || '1', 10);
                    const pIdx = parseInt(cPlatforms?.value || '1', 10);

                    const userLabels = ['1 User', '5 Users', '10 Users', '25 Users', '50 Users', '100 Users'];
                    const leadLabels = ['2,000 Leads', '10,000 Leads', '25,000 Leads', '50,000 Leads', '100,000 Leads', '250,000 Leads', '500,000 Leads'];
                    const storageLabels = ['5 GB', '20 GB', '50 GB', '100 GB', '250 GB', '500 GB'];
                    const platformLabels = ['Manual / CSV', '1 Platform', '3 Platforms', '5 Platforms', '10 Platforms'];

                    const uText = userLabels[uIdx] || '5 Users';
                    const lText = leadLabels[lIdx] || '10,000 Leads';
                    const sText = storageLabels[sIdx] || '20 GB';
                    const pText = platformLabels[pIdx] || '1 Platform';

                    if (document.getElementById('c-users-label')) document.getElementById('c-users-label').textContent = uText;
                    if (document.getElementById('c-leads-label')) document.getElementById('c-leads-label').textContent = lText;
                    if (document.getElementById('c-storage-label')) document.getElementById('c-storage-label').textContent = sText;
                    if (document.getElementById('c-platforms-label')) document.getElementById('c-platforms-label').textContent = pText;

                    if (document.getElementById('c-unsupp-users')) document.getElementById('c-unsupp-users').textContent = uText;
                    if (document.getElementById('c-unsupp-leads')) document.getElementById('c-unsupp-leads').textContent = lText;
                    if (document.getElementById('c-unsupp-storage')) document.getElementById('c-unsupp-storage').textContent = sText;
                    if (document.getElementById('c-unsupp-platforms')) document.getElementById('c-unsupp-platforms').textContent = pText;

                    const heroPlan = document.getElementById('hero-currency-name');
                    if (heroPlan) heroPlan.textContent = 'Regional Enterprise Deployment';
                    return;
                }

                // Supported 15 Countries Calculation
                const c = COUNTRY_DATA[currentCountry] || COUNTRY_DATA['IN'];
                const sym = c.symbol;
                const loc = c.locale;

                const uIdx = parseInt(cUsers?.value || '1', 10);
                const lIdx = parseInt(cLeads?.value || '1', 10);
                const sIdx = parseInt(cStorage?.value || '1', 10);
                const pIdx = parseInt(cPlatforms?.value || '1', 10);

                const uTier = c.users[uIdx] || c.users[1];
                const lTier = c.leads[lIdx] || c.leads[1];
                const sTier = c.storage[sIdx] || c.storage[1];
                const pTier = c.platforms[pIdx] || c.platforms[1];

                // Labels
                if (document.getElementById('c-users-label')) document.getElementById('c-users-label').textContent = uTier.label;
                if (document.getElementById('c-leads-label')) document.getElementById('c-leads-label').textContent = lTier.label;
                if (document.getElementById('c-storage-label')) document.getElementById('c-storage-label').textContent = sTier.label;
                if (document.getElementById('c-platforms-label')) document.getElementById('c-platforms-label').textContent = pTier.label;

                // Base + Highest selected tiers inside each capacity module (Section 1 & 4 of PDF)
                const baseCost = c.base;
                const userCost = uTier.extra;
                const leadCost = lTier.extra;
                const storageCost = sTier.extra;
                const platformCost = pTier.extra;

                const monthlySubtotal = baseCost + userCost + leadCost + storageCost + platformCost;
                
                // 10% discount on committed annual billing
                const finalMonthlyRate = isAnnual ? Math.round(monthlySubtotal * 0.90) : monthlySubtotal;

                // Update calculator breakdown
                if (document.getElementById('c-base-cost')) document.getElementById('c-base-cost').textContent = sym + baseCost.toLocaleString(loc);
                if (document.getElementById('c-users-count')) document.getElementById('c-users-count').textContent = uTier.label;
                if (document.getElementById('c-users-cost')) document.getElementById('c-users-cost').textContent = (userCost > 0 ? '+' : '') + sym + userCost.toLocaleString(loc);
                if (document.getElementById('c-leads-count')) document.getElementById('c-leads-count').textContent = lTier.label;
                if (document.getElementById('c-leads-cost')) document.getElementById('c-leads-cost').textContent = (leadCost > 0 ? '+' : '') + sym + leadCost.toLocaleString(loc);
                if (document.getElementById('c-storage-count')) document.getElementById('c-storage-count').textContent = sTier.label;
                if (document.getElementById('c-storage-cost')) document.getElementById('c-storage-cost').textContent = (storageCost > 0 ? '+' : '') + sym + storageCost.toLocaleString(loc);
                if (document.getElementById('c-platforms-count')) document.getElementById('c-platforms-count').textContent = pTier.label;
                if (document.getElementById('c-platforms-cost')) document.getElementById('c-platforms-cost').textContent = (platformCost > 0 ? '+' : '') + sym + platformCost.toLocaleString(loc);

                if (document.getElementById('c-total-label')) {
                    document.getElementById('c-total-label').textContent = isAnnual ? 'Total (Annual / mo equivalent)' : 'Total (Monthly)';
                }
                if (document.getElementById('c-total-cost')) {
                    document.getElementById('c-total-cost').textContent = sym + finalMonthlyRate.toLocaleString(loc);
                }
                if (document.getElementById('calc-billing-note')) {
                    document.getElementById('calc-billing-note').textContent = isAnnual 
                        ? `Billed annually (${sym}${Math.round(finalMonthlyRate * 12).toLocaleString(loc)}/year) with 10% discount in ${c.currency}.`
                        : `Billed monthly in ${c.currency}. No lock-in, change or cancel anytime.`;
                }

                // Update Cards and Mockup
                if (document.getElementById('card-free-price')) document.getElementById('card-free-price').textContent = sym + '0';
                if (document.getElementById('card-base-price')) document.getElementById('card-base-price').innerHTML = `${sym}${baseCost.toLocaleString(loc)} <span>/ month</span>`;
                
                if (document.getElementById('hero-currency-name')) {
                    document.getElementById('hero-currency-name').textContent = `Region: ${c.name} (${c.currency} ${sym.trim()})`;
                }
                if (document.getElementById('hero-total-price')) {
                    document.getElementById('hero-total-price').textContent = sym + finalMonthlyRate.toLocaleString(loc);
                }
                if (document.getElementById('hero-users-val')) document.getElementById('hero-users-val').textContent = uTier.label;
                if (document.getElementById('hero-leads-val')) document.getElementById('hero-leads-val').textContent = lTier.label;
                if (document.getElementById('hero-storage-val')) document.getElementById('hero-storage-val').textContent = sTier.label;
            }

            [cUsers, cLeads, cStorage, cPlatforms].forEach(input => {
                if (input) input.addEventListener('input', renderPricing);
            });

            // Synchronize hero sliders with main calculator
            const hUsers = document.getElementById('hero-users-input');
            const hLeads = document.getElementById('hero-leads-input');
            const hStorage = document.getElementById('hero-storage-input');

            if (hUsers && cUsers) {
                hUsers.addEventListener('input', () => { cUsers.value = hUsers.value; renderPricing(); });
                cUsers.addEventListener('input', () => { hUsers.value = cUsers.value; });
            }
            if (hLeads && cLeads) {
                hLeads.addEventListener('input', () => { cLeads.value = hLeads.value; renderPricing(); });
                cLeads.addEventListener('input', () => { hLeads.value = cLeads.value; });
            }
            if (hStorage && cStorage) {
                hStorage.addEventListener('input', () => { cStorage.value = hStorage.value; renderPricing(); });
                cStorage.addEventListener('input', () => { hStorage.value = cStorage.value; });
            }

            renderPricing();
        });
    </script>
</body>
</html>
