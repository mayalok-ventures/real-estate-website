---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

const seoTitle = "Real Estate Sales Pipeline & Deal Tracking Software | Sahyak CRM";
const seoDesc = "Visual real estate sales pipeline for Indian property brokers and developers. Track site visits, token advances, builder agreements, and broker commissions.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Solutions", url: "/features/" },
  { name: "Sales Pipeline", url: "/solutions/real-estate-sales-pipeline/" }
];

const faqItems = [
  {
    question: "How does a real estate sales pipeline differ from generic CRM pipelines?",
    answer: "Generic CRMs (like basic Zoho or HubSpot tiers) use generic B2B SaaS stages such as 'Qualified' and 'Proposal'. Sahyak's pipeline is customized for Indian real estate realities: Site Visit Scheduled, Site Visit Completed, KYC & Negotiation, Token / Booking Advance, Agreement for Sale, and Registration / Home Loan Disbursement."
  },
  {
    question: "Can I manage multiple property projects with separate pipelines?",
    answer: "Yes. In Sahyak, brokers and developers can switch instantly between pipelines for different projects, developers, or commercial versus residential sales desks. Each pipeline tracks deal stage velocities independently."
  },
  {
    question: "How does Sahyak notify managers when deals go cold?",
    answer: "Sahyak includes automated stale-deal triggers. If a prospective buyer in the 'Site Visit Completed' stage has had no logged call, message, or follow-up task for 72 hours, the card flags yellow, sending an alert to the sales manager to reassign or intervene."
  },
  {
    question: "Does the pipeline calculate broker commissions and developer revenue?",
    answer: "Yes. Every deal card tracks expected agreement value and agreed commission percentage (e.g., 2% channel partner brokerage or in-house incentive). Total pipeline values update dynamically across each stage column."
  },
  {
    question: "Is deal tracking included in the Free Starter plan?",
    answer: "Yes. The Free Starter tier gives you full access to the visual Kanban sales pipeline for up to 20 active leads and 3 active properties at ₹0 without requiring a credit card."
  }
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sahyak Real Estate Sales Pipeline Software",
  "operatingSystem": "Web, Android, iOS",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "499",
    "priceCurrency": "INR"
  },
  "description": seoDesc
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<Layout
  title={seoTitle}
  description={seoDesc}
  canonicalUrl="https://sahyak.com/solutions/real-estate-sales-pipeline/"
  breadcrumbs={breadcrumbs}
  schema={[softwareSchema, faqSchema]}
  activeNav="solutions"
>
  <!-- Hero Section -->
  <section class="relative bg-darkGreen text-white py-20 px-6 md:px-12 lg:px-20 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-brandGreen border border-white/10 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-brandGreen"></span>
          Deal Velocity & Pipeline Control
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif leading-tight">
          Real Estate Sales Pipeline That <span class="text-brandGreen italic">Turns Inquiries Into Bookings.</span>
        </h1>
        <p class="text-gray-300 text-lg max-w-xl leading-relaxed">
          From first contact to token advance, agreement registration, and broker payout. Get full visibility over every deal in your property sales funnel with automated follow-up cadences and stale deal alerts.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a href="https://crm.sahyak.com" class="btn btn-primary px-8 py-3.5 text-base">
            Start Free (20 Leads Included) <span>&rarr;</span>
          </a>
          <a href="/compare/real-estate-crm-vs-excel/" class="btn btn-outline px-8 py-3.5 text-base">
            CRM vs Excel Comparison <span>&rarr;</span>
          </a>
        </div>
        <p class="text-xs text-gray-400">
          Mobile-first drag-and-drop &bull; Stale deal warnings &bull; Free Starter tier available
        </p>
      </div>

      <!-- Pipeline Hero Visual -->
      <div class="relative flex justify-center">
        <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-white/5 p-2 backdrop-blur-sm max-w-lg w-full">
          <img
            src="/images/features/7.webp"
            alt="Sahyak CRM Visual Real Estate Sales Pipeline and Deal Velocity Dashboard"
            width="1402"
            height="1122"
            class="w-full h-auto rounded-2xl object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="p-4 bg-white/5 border-t border-white/10 flex items-center justify-between text-xs text-gray-300">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Live Pipeline Deal Velocity
            </span>
            <span class="text-brandGreen font-medium">Stage-by-Stage Forecaster</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Estate Specific Pipeline Stages Section -->
  <section class="py-20 px-6 md:px-12 lg:px-20 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-serif text-darkGreen mb-4">
          Engineered for the Indian Real Estate Buying Journey
        </h2>
        <p class="text-gray-600 text-lg">
          Property transactions take weeks, involve massive financial commitments, and require multiple stakeholders. Sahyak organizes the chaos into 6 distinct milestones.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Stage 1 -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-full flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-sm mb-4">
              1
            </div>
            <h3 class="text-lg font-bold text-darkGreen mb-2">Inquiry & Budget Qualification</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Verify buyer budget (e.g. 1 Cr vs 3 Cr), preferred bedroom configuration, loan eligibility, and purchase timeline within 5 minutes of inquiry ingestion.
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-brandGreen">Stage Velocity: 24h Target</span>
        </div>

        <!-- Stage 2 -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-full flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-sm mb-4">
              2
            </div>
            <h3 class="text-lg font-bold text-darkGreen mb-2">Site Visit Scheduling & Attendance</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Send WhatsApp location pins, schedule sales gallery visits, and log real-time GPS check-ins when the client arrives on site.
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-brandGreen">Stage Velocity: 3-5 Days</span>
        </div>

        <!-- Stage 3 -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-full flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-sm mb-4">
              3
            </div>
            <h3 class="text-lg font-bold text-darkGreen mb-2">Inventory Locking & Negotiation</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Place units on temporary hold in the inventory grid while pricing terms, floor-rise charges, and payment schemes are negotiated.
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-brandGreen">Stage Velocity: 48h Hold Max</span>
        </div>

        <!-- Stage 4 -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-full flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-sm mb-4">
              4
            </div>
            <h3 class="text-lg font-bold text-darkGreen mb-2">Token Advance & Application Form</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Record token cheque or NEFT details, attach Aadhaar/PAN KYC documents, and lock the inventory unit permanently to prevent double-booking.
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-brandGreen">Stage Velocity: Instant Lock</span>
        </div>

        <!-- Stage 5 -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-full flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-sm mb-4">
              5
            </div>
            <h3 class="text-lg font-bold text-darkGreen mb-2">Builder Agreement & Bank Sanction</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Track bank loan approval progress, draft review dates, and stamp duty collection before registration with sub-registrar offices.
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-brandGreen">Stage Velocity: 14-21 Days</span>
        </div>

        <!-- Stage 6 -->
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm h-full flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-sm mb-4">
              6
            </div>
            <h3 class="text-lg font-bold text-darkGreen mb-2">Disbursement & Brokerage Payout</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Track loan disbursement tranche receipts and calculate channel partner commission payout schedules with full audit logs.
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-brandGreen">Stage Velocity: Milestone Release</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution Contrast -->
  <section class="py-20 px-6 md:px-12 lg:px-20 bg-white">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800 uppercase tracking-wider">
          The Hidden Profit Killer
        </span>
        <h2 class="text-3xl md:text-4xl font-serif text-darkGreen mt-4 mb-6">
          "I Thought The Buyer Was Still Interested..."
        </h2>
        <p class="text-gray-600 text-base leading-relaxed">
          In real estate sales, consistent post-visit engagement is critical. When agents manage multiple property inquiries simultaneously, manual tracking often leads to unrecorded conversations and delayed next steps.
        </p>
        <p class="text-gray-600 text-base leading-relaxed">
          Sahyak addresses this with automated <strong>stale deal triggers</strong>. If an opportunity remains in any pipeline stage without logged activity beyond a set interval, both the assigned executive and team lead receive follow-up reminders.
        </p>
        <div class="p-4 bg-cream rounded-2xl border border-gray-200">
          <p class="text-xs font-bold text-darkGreen uppercase mb-1">Pipeline Discipline</p>
          <p class="text-sm text-gray-700">Prompt post-visit communication ensures buyers receive requested floor plans, pricing sheets, and payment schedules while project interest is high.</p>
        </div>
      </div>

      <div class="lg:col-span-6 flex flex-col sm:flex-row gap-6 items-center">
        <!-- Mobile Pipeline Screen -->
        <div class="w-full sm:w-1/2 flex justify-center">
          <div class="relative rounded-3xl overflow-hidden border border-gray-200 shadow-xl bg-darkGreen p-2 w-full max-w-[240px]">
            <img
              src="/images/homepage/1.webp"
              alt="Sahyak CRM Mobile Real Estate Deal Pipeline"
              width="799"
              height="1422"
              class="w-full h-auto rounded-2xl object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Capability Cards -->
        <div class="w-full sm:w-1/2 space-y-3">
          <div class="p-4 rounded-2xl bg-cream border border-gray-200">
            <h3 class="font-bold text-darkGreen text-xs mb-1 flex items-center gap-1.5">
              <span class="text-brandGreen font-bold">&check;</span> Mobile Drag-and-Drop
            </h3>
            <p class="text-[11px] text-gray-600 leading-relaxed">
              Agents advance deal stages right from the car or project site.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-cream border border-gray-200">
            <h3 class="font-bold text-darkGreen text-xs mb-1 flex items-center gap-1.5">
              <span class="text-brandGreen font-bold">&check;</span> Commission Forecasting
            </h3>
            <p class="text-[11px] text-gray-600 leading-relaxed">
              Live probability-weighted cash flow forecasts by expected closing date.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-cream border border-gray-200">
            <h3 class="font-bold text-darkGreen text-xs mb-1 flex items-center gap-1.5">
              <span class="text-brandGreen font-bold">&check;</span> Multi-Project Switching
            </h3>
            <p class="text-[11px] text-gray-600 leading-relaxed">
              Isolate residential towers and commercial sales desks without data mixing.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Connected Workflows Grid -->
  <section class="py-16 px-6 md:px-12 lg:px-20 bg-darkGreen text-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-serif">Seamlessly Connected to Your Sales Stack</h2>
        <p class="text-gray-300 text-sm mt-2">The sales pipeline is tightly integrated with every core Sahyak workflow.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/solutions/site-visit-management/" class="p-6 bg-white/5 rounded-2xl border border-white/10 hover:border-brandGreen transition-all group h-full flex flex-col justify-between">
          <div>
            <p class="text-brandGreen text-sm font-semibold mb-2">Site Visit Tracking &rarr;</p>
            <h3 class="text-lg font-bold mb-2 group-hover:text-brandGreen">Schedule & Verify Visits</h3>
            <p class="text-xs text-gray-400">Automated WhatsApp location pins and GPS check-in logging for field reps.</p>
          </div>
          <span class="text-xs text-gray-400 mt-4 group-hover:text-brandGreen font-medium">Explore workflow &rarr;</span>
        </a>
        <a href="/solutions/property-inventory-management/" class="p-6 bg-white/5 rounded-2xl border border-white/10 hover:border-brandGreen transition-all group h-full flex flex-col justify-between">
          <div>
            <p class="text-brandGreen text-sm font-semibold mb-2">Inventory Management &rarr;</p>
            <h3 class="text-lg font-bold mb-2 group-hover:text-brandGreen">Real-Time Unit Locking</h3>
            <p class="text-xs text-gray-400">Link deal cards directly to specific floor units to eliminate double-booking disputes.</p>
          </div>
          <span class="text-xs text-gray-400 mt-4 group-hover:text-brandGreen font-medium">Explore workflow &rarr;</span>
        </a>
        <a href="/tools/real-estate-crm-roi-calculator/" class="p-6 bg-white/5 rounded-2xl border border-white/10 hover:border-brandGreen transition-all group h-full flex flex-col justify-between">
          <div>
            <p class="text-brandGreen text-sm font-semibold mb-2">ROI Calculator &rarr;</p>
            <h3 class="text-lg font-bold mb-2 group-hover:text-brandGreen">Calculate Commission Gains</h3>
            <p class="text-xs text-gray-400">Simulate how increasing deal stage velocity impacts your monthly earnings.</p>
          </div>
          <span class="text-xs text-gray-400 mt-4 group-hover:text-brandGreen font-medium">Explore calculator &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 px-6 md:px-12 lg:px-20 bg-cream">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-serif text-darkGreen mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-gray-600">
          Everything you need to know about managing property pipelines in Sahyak CRM.
        </p>
      </div>

      <div class="space-y-4">
        {faqItems.map((faq) => (
          <div class="bg-white rounded-2xl p-6 border border-gray-200">
            <h3 class="text-lg font-bold text-darkGreen mb-2">{faq.question}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 px-6 md:px-12 lg:px-20 bg-brandGreen text-darkGreen text-center">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-3xl md:text-5xl font-serif font-bold">
        Take Control of Your Real Estate Sales Pipeline
      </h2>
      <p class="text-darkGreen/80 text-lg max-w-2xl mx-auto">
        Set up your property pipeline in under 5 minutes. Free Starter includes 20 leads, 1 user seat, 10 WhatsApp actions, and 3 active properties at ₹0.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href="https://crm.sahyak.com" class="btn bg-darkGreen text-white hover:bg-darkGreen/90 px-8 py-4 text-base font-semibold">
          Start Pipeline Free <span>&rarr;</span>
        </a>
        <a href="/pricing/" class="btn bg-white/40 text-darkGreen hover:bg-white/60 px-8 py-4 text-base font-semibold">
          Compare Paid Plans <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
