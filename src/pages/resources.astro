                </p>
                <a href="#guides" class="inline-flex bg-brand-green text-brand-dark px-8 py-4 rounded-full font-semibold hover:bg-white transition-all duration-300 items-center gap-2">
                    Explore video tutorials <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <!-- Right Video Player Mockup -->
            <div class="relative reveal">
                <!-- Main Video Player -->
                <div class="relative rounded-2xl overflow-hidden shadow-2xl group cursor-pointer">
                    <img src="/images/resources/3.png" alt="Video Tutorial Thumbnail for Sahyak CRM Setup and Walkthrough" class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700" width="800" height="400" loading="lazy" decoding="async">
