                <div class="relative z-10 bg-brand-dark text-white rounded-3xl p-6 shadow-2xl border border-gray-800 w-72 mx-auto animate-float">
                    <div class="flex justify-between items-center mb-6">
                        <span class="font-bold text-sm">Sahyak</span>
                        <svg class="w-5 h-5 text-gray-400 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Set up your workspace</h3>
                    <div class="w-full bg-gray-700 h-2 rounded-full mb-4">
                        <div class="bg-brand-green h-2 rounded-full w-2/5"></div>
                    </div>
                    <p class="text-xs text-gray-400 mb-6">2 of 5 completed</p>
                    
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <svg class="w-4 h-4 text-brand-green inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span class="text-sm">Create organization</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <svg class="w-4 h-4 text-brand-green inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span class="text-sm">Add team members</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <svg class="w-3 h-3 text-gray-500 inline-block" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/></svg>
                            <span class="text-sm text-gray-400">Import or add leads</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <svg class="w-3 h-3 text-gray-500 inline-block" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/></svg>
                            <span class="text-sm text-gray-400">Connect WhatsApp</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
