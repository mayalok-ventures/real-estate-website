    <!-- SECTION 3: VIDEO TUTORIALS -->
    <section id="tutorials" class="bg-brand-dark py-24 px-6 lg:px-20">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
            <!-- Left Content -->
            <div class="space-y-6 reveal">
                <div class="inline-flex items-center space-x-2 text-xs font-bold tracking-wider text-brand-green">
                    <span class="w-2 h-2 rounded-full bg-brand-green"></span>
                    <span>VIDEO TUTORIALS</span>
                </div>
                <h2 class="font-serif text-4xl lg:text-5xl font-bold leading-tight">
                    Watch. Learn.<br><span class="text-brand-green italic">Do it yourself.</span>
                </h2>
                <p class="text-gray-400 text-lg max-w-md">
                    Short, practical video guides to help you use every feature of Sahyak CRM — from lead management to WhatsApp outreach.
                </p>
                <a href="#guides" class="btn btn-primary px-8 py-3.5 inline-flex items-center gap-2">
                    Explore video tutorials <span>&rarr;</span>
                </a>
            </div>

            <!-- Right Video Player Mockup -->
            <div class="relative reveal">
                <!-- Main Video Player -->
                <div class="relative rounded-2xl overflow-hidden shadow-2xl group cursor-pointer">
                    <img src="/images/resources/3.webp" alt="Video Tutorial Thumbnail for Sahyak CRM Setup and Walkthrough" class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700" width="1672" height="940" loading="lazy" decoding="async">
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
