                            <div class="w-10 h-10 rounded-lg bg-brand-green/20 flex items-center justify-center text-brand-green"><i class="fas fa-play text-xs"></i></div>
                            <span class="font-semibold text-sm">Add & Manage Leads</span>
                        </div>
                        <span class="text-xs text-gray-400">3:18</span>
                    </div>
                    <div class="flex items-center justify-between bg-white/5 border border-white/10 p-3 rounded-xl hover:bg-white/10 transition-colors cursor-pointer">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-brand-green/20 flex items-center justify-center text-brand-green"><i class="fas fa-play text-xs"></i></div>
                            <span class="font-semibold text-sm">WhatsApp Integration</span>
                        </div>
                        <span class="text-xs text-gray-400">4:26</span>
                    </div>
                    <div class="flex items-center justify-between bg-white/5 border border-white/10 p-3 rounded-xl hover:bg-white/10 transition-colors cursor-pointer">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-brand-green/20 flex items-center justify-center text-brand-green"><i class="fas fa-play text-xs"></i></div>
                            <span class="font-semibold text-sm">Schedule Follow-ups</span>
                        </div>
                        <span class="text-xs text-gray-400">3:52</span>
                    </div>
                </div>
            </div>
