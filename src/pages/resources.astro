        <div class="absolute inset-0 z-0 opacity-10">
            <img src="/images/resources/4.png" alt="Step-by-Step Practical Guides and Documentation for Real Estate Brokers" class="w-full h-full object-cover" width="1920" height="800" loading="lazy" decoding="async">
        </div>
        
        <div class="relative z-10 max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
            <!-- Left Content -->
            <div class="space-y-6 reveal">
                <div class="inline-flex items-center space-x-2 text-xs font-bold tracking-wider text-brand-greenDark">
                    <span class="w-2 h-2 rounded-full bg-brand-greenDark"></span>
                    <span>STEP-BY-STEP GUIDES</span>
                </div>
