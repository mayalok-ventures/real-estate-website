---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const seoTitle = "Real Estate CRM Resources, Guides & Playbooks | Sahyak";
const seoDesc = "Access practical real estate sales playbooks, WhatsApp templates, video walkthroughs, and buyer follow-up guides curated by top industry real estate experts.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sahyak.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Resources",
      "item": "https://sahyak.com/resources/"
    }
  ]
};

const resourcesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": seoTitle,
  "description": seoDesc,
  "url": "https://sahyak.com/resources/",
  "mainEntity": {
    "@type": "ItemList",
    "name": "Sahyak Real Estate Learning & Sales Enablement Hub",
    "itemListElement": [
      {
        "@type": "HowTo",
        "position": 1,
        "name": "Quick Start Onboarding & Team Setup",
        "description": "Get your real estate agency up and running in minutes with contact imports and WhatsApp configuration."
      },
      {
        "@type": "Article",
        "position": 2,
        "name": "Sahyak CRM Platform Walkthrough & Feature Masterclass",
        "description": "Illustrated guide and platform walkthrough covering lead management, automated site visit tracking, and sales analytics."
      },
      {
        "@type": "DigitalDocument",
        "position": 3,
        "name": "High-Converting Real Estate WhatsApp Script Templates",
        "description": "Downloadable verified message templates for instant buyer replies, site visit bookings, and follow-ups."
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href="https://sahyak.com/resources/" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sahyak.com/resources/" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDesc} />
    <meta property="og:image" content="https://sahyak.com/images/resources/1.png" />
    <meta property="og:site_name" content="Sahyak CRM" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://sahyak.com/resources/" />
    <meta property="twitter:title" content={seoTitle} />
    <meta property="twitter:description" content={seoDesc} />
    <meta property="twitter:image" content="https://sahyak.com/images/resources/1.png" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Mumbai" />
    <meta name="geo.position" content="19.0657;72.8682" />
    <meta name="ICBM" content="19.0657, 72.8682" />

    <!-- Static compiled Tailwind CSS -->
    <link rel="stylesheet" href="/css/tailwind.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
    
    <script type="application/ld+json" set:html={JSON.stringify(resourcesSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <style is:global>
        /* Custom Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        @keyframes float-delayed {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        .animate-float { animation: float 4s ease-in-out infinite; }
        .animate-float-delayed { animation: float-delayed 5s ease-in-out infinite; }
        
        /* Duotone Overlay */
        .duotone-overlay {
            background: linear-gradient(45deg, rgba(74, 222, 128, 0.35), rgba(10, 28, 22, 0.9));
            mix-blend-mode: multiply;
        }

        /* Scroll Reveal */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* Hide scrollbar for clean UI */
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-brand-dark text-white font-sans antialiased overflow-x-hidden">
    <!-- Global Navigation -->
    <Navbar active="resources" />

    <Breadcrumb items={[
        { name: 'Home', url: '/' },
        { name: 'Resources & Playbooks' }
    ]} />

    <main id="main-content">

    <!-- SECTION 1: HERO -->
    <section class="relative min-h-screen flex items-center pt-24 pb-12 px-6 lg:px-20 overflow-hidden">
        <!-- Background Image (Hero) -->
        <div class="absolute inset-0 z-0">
            <img src="/images/resources/1.webp" alt="Sahyak Real Estate CRM Knowledge Base and Training Center" class="w-full h-full object-cover opacity-40 grayscale mix-blend-luminosity" width="1672" height="941" fetchpriority="high" loading="eager" decoding="async">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/80 to-transparent"></div>
        </div>

        <div class="relative z-10 grid lg:grid-cols-2 gap-12 w-full max-w-7xl mx-auto">
            <!-- Left Text -->
            <div class="flex flex-col justify-center space-y-8 hero-reveal">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-brand-green flex items-center justify-center text-brand-dark font-bold">S</div>
                    <span class="text-xl font-bold tracking-wide">Sahyak</span>
                </div>
                
                <div class="inline-flex items-center space-x-2 bg-white/10 px-3 py-1 rounded-full text-xs font-semibold tracking-wider text-brand-green w-max">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
                    <span>RESOURCES</span>
                </div>

                <h1 class="font-serif text-5xl lg:text-7xl font-bold leading-tight">
                    Learn.<br>Use.<br><span class="text-brand-green italic">Get Results.</span>
                </h1>
                
                <p class="text-gray-400 text-lg max-w-md">
                    Step-by-step guides, video tutorials, help articles and practical resources to help your real estate team get the most out of Sahyak CRM.
                </p>

                <div class="flex flex-wrap gap-4">
                    <a href="#quick-start" class="btn btn-primary px-8 py-3.5 flex items-center gap-2">
                        Browse all resources <span>&rarr;</span>
                    </a>
                    <a href="#tutorials" class="btn btn-outline px-8 py-3.5">
                        Watch video guides
                    </a>
                </div>

                <div class="flex items-center gap-4 pt-4">
                    <div class="flex -space-x-2">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop" class="w-10 h-10 rounded-full border-2 border-brand-dark object-cover" alt="Real Estate Broker using Sahyak CRM" width="40" height="40" loading="lazy" decoding="async">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop" class="w-10 h-10 rounded-full border-2 border-brand-dark object-cover" alt="Property Consultant using Sahyak CRM" width="40" height="40" loading="lazy" decoding="async">
                        <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&h=100&fit=crop" class="w-10 h-10 rounded-full border-2 border-brand-dark object-cover" alt="Realtor Team Lead using Sahyak CRM" width="40" height="40" loading="lazy" decoding="async">
                    </div>
                    <span class="text-xs text-gray-400">Trusted by real estate teams worldwide</span>
                </div>
            </div>

            <!-- Right Visual (Floating Cards Overlap) -->
            <div class="relative hidden lg:flex items-center justify-center">
                <div class="absolute -top-10 right-0 text-brand-green font-handwriting text-2xl rotate-12">
                    EVERYTHING<br>YOU NEED<br>TO GET<br>STARTED
                    <span class="block text-xl mt-1">&darr;</span>
                </div>

                <!-- Floating Card 1 -->
                <div class="absolute top-10 left-10 w-64 bg-white/10 backdrop-blur-md border border-white/20 p-5 rounded-2xl animate-float shadow-2xl z-20">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-lg bg-brand-green/20 flex items-center justify-center text-brand-green"><svg class="w-4 h-4 inline-block" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                        <div>
                            <h4 class="font-bold text-sm">Getting Started</h4>
                            <p class="text-xs text-gray-400">5-minute guide</p>
                        </div>
                    </div>
                    <div class="w-full bg-white/10 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-brand-green h-full w-3/4"></div>
                    </div>
                </div>

                <!-- Floating Card 2 -->
                <div class="absolute bottom-10 right-10 w-64 bg-white/10 backdrop-blur-md border border-white/20 p-5 rounded-2xl animate-float-delayed shadow-2xl z-30">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-brand-green/20 flex items-center justify-center text-brand-green"><svg class="w-5 h-5 text-green-500 inline-block" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24z"/></svg></div>
                        <div>
                            <h4 class="font-bold text-sm">WhatsApp Templates</h4>
                            <p class="text-xs text-gray-400">12 ready templates</p>
                        </div>
                    </div>
                </div>

                <!-- Central Image/Graphic Placeholder -->
                <div class="w-80 h-96 rounded-2xl overflow-hidden border border-white/10 relative">
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover opacity-60" alt="Person working">
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION: FEATURED TOOLS & BUYER GUIDES -->
    <section class="bg-white py-16 px-6 lg:px-20 border-b border-gray-100">
        <div class="max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <div class="inline-flex items-center space-x-2 text-xs font-bold tracking-wider text-brand-greenDark mb-2">
                    <span class="w-2 h-2 rounded-full bg-brand-greenDark"></span>
                    <span>FREE TOOLS & BUYER GUIDES</span>
                </div>
                <h2 class="font-serif text-3xl lg:text-4xl font-bold text-darkGreen">
                    Calculators, Checklists & In-Depth Industry Research
                </h2>
                <p class="text-gray-600 text-sm mt-2">
                    Genuinely useful, free real estate sales tools engineered to improve speed-to-lead and pipeline velocity.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Tool 1: ROI Calculator -->
                <a href="/tools/real-estate-crm-roi-calculator/" class="p-6 rounded-2xl bg-cream border border-gray-200 hover:border-brandGreen transition-all group flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-base mb-4">
                            ₹
                        </div>
                        <h3 class="font-bold text-darkGreen text-base mb-1 group-hover:text-emerald-700">CRM ROI Calculator</h3>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Simulate your monthly leads, commission percentage, and conversion lift to see your net projected ROI.
                        </p>
                    </div>
                    <span class="text-xs font-bold text-brandGreen mt-4 flex items-center gap-1">Launch Calculator &rarr;</span>
                </a>

                <!-- Tool 2: Speed to Lead Calculator -->
                <a href="/tools/lead-response-time-calculator/" class="p-6 rounded-2xl bg-cream border border-gray-200 hover:border-brandGreen transition-all group flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-base mb-4">
                            ⚡
                        </div>
                        <h3 class="font-bold text-darkGreen text-base mb-1 group-hover:text-emerald-700">Lead Response Calculator</h3>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Benchmark your response latency against Harvard Business Review data and measure lost brokerage commissions.
                        </p>
                    </div>
                    <span class="text-xs font-bold text-brandGreen mt-4 flex items-center gap-1">Test Response Decay &rarr;</span>
                </a>

                <!-- Tool 3: Migration Checklist -->
                <a href="/tools/real-estate-crm-migration-checklist/" class="p-6 rounded-2xl bg-cream border border-gray-200 hover:border-brandGreen transition-all group flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-base mb-4">
                            📋
                        </div>
                        <h3 class="font-bold text-darkGreen text-base mb-1 group-hover:text-emerald-700">18-Step Migration Checklist</h3>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Interactive checklist for safely moving leads and property inventory from Excel or legacy CRM with zero data loss.
                        </p>
                    </div>
                    <span class="text-xs font-bold text-brandGreen mt-4 flex items-center gap-1">Open Checklist &rarr;</span>
                </a>

                <!-- Guide 1: Best CRM Guide -->
                <a href="/resources/best-real-estate-crm-india/" class="p-6 rounded-2xl bg-cream border border-gray-200 hover:border-brandGreen transition-all group flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-darkGreen text-brandGreen flex items-center justify-center font-bold text-base mb-4">
                            🏆
                        </div>
                        <h3 class="font-bold text-darkGreen text-base mb-1 group-hover:text-emerald-700">Best Real Estate CRM India</h3>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Objective comparison of Sell.Do, LeadSquared, TeleCRM, Leadrat, Zoho, and Sahyak with transparent pricing.
                        </p>
                    </div>
                    <span class="text-xs font-bold text-brandGreen mt-4 flex items-center gap-1">Read 2026 Guide &rarr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- SECTION 2: GET STARTED QUICKLY -->
    <section id="quick-start" class="bg-brand-light text-brand-dark py-24 px-6 lg:px-20">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
            <!-- Left Content -->
            <div class="space-y-6 reveal">
                <div class="inline-flex items-center space-x-2 text-xs font-bold tracking-wider text-brand-greenDark">
