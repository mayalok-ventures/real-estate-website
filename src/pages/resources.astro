    </section>

    <!-- SECTION 2: GET STARTED QUICKLY -->
    <section id="quick-start" class="bg-brand-light text-brand-dark py-24 px-6 lg:px-20">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
            <!-- Left Content -->
            <div class="space-y-6 reveal">
                <div class="inline-flex items-center space-x-2 text-xs font-bold tracking-wider text-brand-greenDark">
                    <span class="w-2 h-2 rounded-full bg-brand-greenDark"></span>
                    <span>GET STARTED QUICKLY</span>
                </div>
                <h2 class="text-4xl lg:text-5xl font-bold leading-tight">
                    Up and running in <span class="text-brand-greenDark">5 simple steps.</span>
                </h2>
                <p class="text-gray-600 text-lg max-w-md">
                    Follow this quick guide to set up your team, import leads and start managing your sales process immediately.
                </p>
                <div class="space-y-4 pt-4">
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-brand-greenDark text-white font-bold flex items-center justify-center text-sm">1</div>
                        <span class="font-semibold">Create your workspace</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-brand-greenDark text-white font-bold flex items-center justify-center text-sm">2</div>
                        <span class="font-semibold">Invite your team</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-gray-100 text-brand-dark font-bold flex items-center justify-center text-sm">3</div>
                        <span class="font-semibold text-gray-600">Add your leads</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-gray-100 text-brand-dark font-bold flex items-center justify-center text-sm">4</div>
                        <span class="font-semibold text-gray-600">Start follow-ups</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-gray-100 text-brand-dark font-bold flex items-center justify-center text-sm">5</div>
                        <span class="font-semibold text-gray-600">Close more deals</span>
                    </div>
                </div>
            </div>

            <!-- Right Phone Mockup -->
            <div class="hidden lg:block relative reveal">
                <img src="/images/resources/2.png" alt="Quick Start Onboarding and Setup in Sahyak Real Estate CRM" class="absolute inset-0 w-full h-full object-cover rounded-3xl opacity-20 grayscale" width="600" height="600" loading="lazy" decoding="async">
                <div class="relative z-10 bg-brand-dark text-white rounded-3xl p-6 shadow-2xl border border-gray-800 w-72 mx-auto animate-float">
                    <div class="flex justify-between items-center mb-6">
                        <span class="font-bold text-sm">Sahyak</span>
                        <i class="fas fa-user-circle text-gray-400"></i>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Set up your workspace</h3>
                    <div class="w-full bg-gray-700 h-2 rounded-full mb-4">
                        <div class="bg-brand-green h-2 rounded-full w-2/5"></div>
                    </div>
                    <p class="text-xs text-gray-400 mb-6">2 of 5 completed</p>
                    
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <i class="fas fa-check-circle text-brand-green"></i>
                            <span class="text-sm">Create organization</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <i class="fas fa-check-circle text-brand-green"></i>
                            <span class="text-sm">Add team members</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <i class="fas fa-circle text-gray-500"></i>
                            <span class="text-sm text-gray-400">Import or add leads</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
                            <i class="fas fa-circle text-gray-500"></i>
                            <span class="text-sm text-gray-400">Connect WhatsApp</span>
                        </div>
                        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-lg border border-white/10">
