                <div class="space-y-4 pt-4">
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-brand-greenDark text-white font-bold flex items-center justify-center text-sm">1</div>
                        <span class="font-semibold">Create your workspace</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-brand-greenDark text-white font-bold flex items-center justify-center text-sm">2</div>
                        <span class="font-semibold">Invite your team</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-gray-100 text-brand-dark font-bold flex items-center justify-center text-sm">3</div>
                        <span class="font-semibold text-gray-600">Add your leads</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-gray-100 text-brand-dark font-bold flex items-center justify-center text-sm">4</div>
                        <span class="font-semibold text-gray-600">Start follow-ups</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-8 h-8 rounded-full bg-gray-100 text-brand-dark font-bold flex items-center justify-center text-sm">5</div>
