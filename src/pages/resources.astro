                    </div>
                    <a href="/contact" class="text-sm font-semibold flex items-center gap-2 text-brand-dark">View guide <i class="fas fa-arrow-right"></i></a>
                </div>

                <!-- Card 3 -->
                <div class="absolute bottom-10 left-10 lg:left-32 w-64 bg-white p-6 rounded-2xl shadow-2xl animate-float z-10 border border-gray-100">
                    <div class="text-4xl font-bold text-brand-greenDark mb-4">03</div>
